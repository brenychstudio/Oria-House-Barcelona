---
import "../styles/global.css";

import { t, type Lang } from "../content/languages";
import { getSettings } from "../cms/sheets";
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  absoluteAssetUrl,
  absoluteUrl,
  getAlternatePath,
} from "../hotel/seo/siteSeo";
import HotelHeader from "../hotel/ui/HotelHeader.astro";
import HotelFooter from "../hotel/ui/HotelFooter.astro";
import HotelDock from "../hotel/ui/HotelDock.astro";
import HotelVisualStabilization from "../hotel/ui/HotelVisualStabilization.astro";
import HotelBookingPlanner from "../hotel/ui/HotelBookingPlanner.astro";

type Props = {
  lang: Lang;
  title: string;
  fullBleed?: boolean;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  canonicalPath?: string;
};

const {
  lang,
  title,
  description,
  ogImage,
  noindex,
  canonicalPath,
  fullBleed = false,
} = Astro.props as Props;

const mainClass = fullBleed
  ? "hc-page-shell hc-page-shell--full"
  : "hc-page-shell";

const s = await getSettings();

const currentPath = canonicalPath || Astro.url.pathname;
const canonicalUrl = absoluteUrl(currentPath);
const alternateEn = absoluteUrl(getAlternatePath(currentPath, "en"));
const alternateEs = absoluteUrl(getAlternatePath(currentPath, "es"));

const metaTitle = title.includes(SITE_NAME) ? title : `${title} - ${SITE_NAME}`;

const fallbackDesc = t(
  lang,
  String((s as any).meta_description_en || ""),
  String((s as any).meta_description_es || "")
).trim();

const metaDescription = String(
  description ||
    fallbackDesc ||
    "A quiet boutique hotel demo in Barcelona shaped by cinematic rooms, curated experiences, direct booking clarity and premium hospitality design."
).trim();

const fallbackOg = String((s as any).og_image || (s as any).hero_image || "").trim();
const metaOgImage = absoluteAssetUrl(String(ogImage || fallbackOg || DEFAULT_OG_IMAGE).trim());

const isNoindex =
  Boolean(noindex) || String((s as any).noindex || "").toUpperCase() === "TRUE";

const robotsContent = isNoindex ? "noindex,nofollow" : "index,follow";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>

    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robotsContent} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaOgImage} />

    <meta name="theme-color" content="#15120f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body>
    <div class="hc-atmosphere" aria-hidden="true"></div>

    <HotelHeader lang={lang} pathname={Astro.url.pathname} />
    <main class={mainClass} data-header-scene="site-light">
      <slot />
    </main>

    <HotelBookingPlanner lang={lang} />

    <HotelFooter lang={lang} />

    <HotelVisualStabilization />

    <HotelDock lang={lang} />
  </body>
</html>
