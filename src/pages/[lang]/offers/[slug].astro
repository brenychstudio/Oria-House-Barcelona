---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../../content/languages";
import { getOffers, getSettings } from "../../../cms/sheets";
import { pickLang, splitPipe } from "../../../cms/types";
import {
  HOTEL_DEMO_ASSETS,
  OFFER_COVER_BY_SLUG,
} from "../../../hotel/data/demoAssets";
import { getSeoCopy } from "../../../hotel/seo/siteSeo";
import CinematicInspectGallery from "../../../hotel/ui/CinematicInspectGallery.astro";

export async function getStaticPaths() {
  const offers = await getOffers();

  return LANGS.flatMap((lang) =>
    offers.map((offer) => ({
      params: {
        lang,
        slug: offer.slug,
      },
      props: {
        offer,
      },
    }))
  );
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const { offer } = Astro.props as any;
const s = await getSettings();

const hotelName = t(
  lang,
  String((s as any).hotel_name_en || "Hotel Core"),
  String((s as any).hotel_name_es || (s as any).hotel_name_en || "Hotel Core")
);

const bookingUrl = String((s as any).booking_url || "").trim();

const offerTitle = pickLang(lang, offer, "title");
const offerPeriod = pickLang(lang, offer, "period");
const offerIncluded = pickLang(lang, offer, "included");
const offerTerms = pickLang(lang, offer, "terms");

const offerCover = OFFER_COVER_BY_SLUG[offer.slug] ?? String((offer as any).cover_image || "").trim();

const splitList = (value: string) =>
  String(value || "")
    .split(/[,|\n]/)
    .map((item) => item.trim())
    .filter(Boolean);

const includedItems = Array.from(
  new Set([...splitPipe(offerIncluded), ...splitList(offerIncluded)].filter(Boolean))
).slice(0, 8);

const termsItems = Array.from(
  new Set([...splitPipe(offerTerms), ...splitList(offerTerms)].filter(Boolean))
).slice(0, 8);

const offerHighlights = splitPipe(pickLang(lang, offer, "highlights")).slice(0, 5);

const offerGalleryBySlug: Record<string, string[]> = {
  "stay-3-pay-2": [
    HOTEL_DEMO_ASSETS.offerStay3Pay2,
    HOTEL_DEMO_ASSETS.galleryCourtyardArrival,
    HOTEL_DEMO_ASSETS.detailDeskMorning,
    HOTEL_DEMO_ASSETS.galleryDiningEvening,
  ],
  "romance-weekend": [
    HOTEL_DEMO_ASSETS.offerRomanceWeekend,
    HOTEL_DEMO_ASSETS.galleryDiningEvening,
    HOTEL_DEMO_ASSETS.detailLinenSleepingArea,
    HOTEL_DEMO_ASSETS.galleryCourtyardArrival,
  ],
  "culture-pass": [
    HOTEL_DEMO_ASSETS.offerCulturePass,
    HOTEL_DEMO_ASSETS.galleryArchitectureStaircase,
    HOTEL_DEMO_ASSETS.experienceGaudiMorning,
    HOTEL_DEMO_ASSETS.detailDeskMorning,
  ],
};

const galleryImages = Array.from(
  new Set(
    [
      offerCover,
      ...(offerGalleryBySlug[offer.slug] ?? []),
    ].filter(Boolean)
  )
);

const optionalOfferField = (key: string) =>
  t(
    lang,
    String((offer as any)?.[`${key}_en`] || ""),
    String((offer as any)?.[`${key}_es`] || "")
  ).trim();

const resolveOfferSales = () => {
  const slug = String((offer as any)?.slug || "").toLowerCase();

  const explicitMood = optionalOfferField("mood");
  const explicitBestFor = optionalOfferField("best_for");
  const explicitBookingLogic = optionalOfferField("booking_logic");
  const explicitWhy = optionalOfferField("why_choose");

  const profile = (() => {
    if (slug.includes("stay") || slug.includes("pay")) {
      return {
        mood: t(lang, "Longer weekend rhythm", "Ritmo de fin de semana largo"),
        bestFor: t(
          lang,
          "Guests who want one more quiet night in the city",
          "Huéspedes que quieren una noche tranquila más en la ciudad"
        ),
        bookingLogic: t(
          lang,
          "Extend the stay without making the trip feel heavier.",
          "Alargar la estancia sin que el viaje se sienta más pesado."
        ),
        whyChoose: t(
          lang,
          "Choose this offer when the best part of Barcelona is having enough time to slow down.",
          "Elija esta oferta cuando lo mejor de Barcelona es tener tiempo suficiente para bajar el ritmo."
        ),
      };
    }

    if (slug.includes("romance")) {
      return {
        mood: t(lang, "Private evening stay", "Estancia privada de noche"),
        bestFor: t(
          lang,
          "Couples, slower arrivals and quiet celebrations",
          "Parejas, llegadas pausadas y celebraciones tranquilas"
        ),
        bookingLogic: t(
          lang,
          "A softer package around arrival, breakfast and privacy.",
          "Un paquete más suave alrededor de llegada, desayuno y privacidad."
        ),
        whyChoose: t(
          lang,
          "Choose this offer when the room, table and timing should feel prepared before arrival.",
          "Elija esta oferta cuando la habitación, la mesa y el ritmo deben sentirse preparados antes de llegar."
        ),
      };
    }

    if (slug.includes("culture")) {
      return {
        mood: t(lang, "Curated city days", "Días urbanos curados"),
        bestFor: t(
          lang,
          "Guests who want culture without planning every step",
          "Huéspedes que quieren cultura sin planificar cada paso"
        ),
        bookingLogic: t(
          lang,
          "Pair the room with a quieter cultural route.",
          "Combinar la habitación con una ruta cultural más tranquila."
        ),
        whyChoose: t(
          lang,
          "Choose this offer when Barcelona should feel guided, close and less crowded.",
          "Elija esta oferta cuando Barcelona debe sentirse guiada, cercana y menos concurrida."
        ),
      };
    }

    return {
      mood: t(lang, "Direct booking value", "Valor de reserva directa"),
      bestFor: t(
        lang,
        "Guests who want clarity before booking",
        "Huéspedes que quieren claridad antes de reservar"
      ),
      bookingLogic: t(
        lang,
        "A package built around a specific reason to stay.",
        "Un paquete construido alrededor de una razón específica para alojarse."
      ),
      whyChoose: t(
        lang,
        "Choose this offer when the hotel should shape more of the stay before you arrive.",
        "Elija esta oferta cuando el hotel debe dar más forma a la estancia antes de su llegada."
      ),
    };
  })();

  return {
    mood: explicitMood || profile.mood,
    bestFor: explicitBestFor || profile.bestFor,
    bookingLogic: explicitBookingLogic || profile.bookingLogic,
    whyChoose: explicitWhy || profile.whyChoose,
  };
};

const sales = resolveOfferSales();

const pageTitle = `${hotelName} — ${offerTitle}`;
const seo = getSeoCopy("offerDetail", lang);
const offerMetaDescription =
  [offerPeriod, sales.bookingLogic].filter(Boolean).join(" ") || seo.description;

const backLabel = t(lang, "Back to offers", "Volver a ofertas");
const bookDirectLabel = t(lang, "Book direct", "Reservar directo");
const contactHotelLabel = t(lang, "Contact hotel", "Contactar hotel");
const openGalleryLabel = t(lang, "Inspect offer images", "Inspeccionar imágenes de oferta");

const offerEyebrow = t(lang, "Offer / Package theatre", "Oferta / Teatro de paquete");
const packageSummaryLabel = t(lang, "Package summary", "Resumen del paquete");
const moodLabel = t(lang, "Mood", "Atmósfera");
const bestForLabel = t(lang, "Best for", "Ideal para");
const bookingLogicLabel = t(lang, "Booking logic", "Lógica de reserva");
const whyChooseLabel = t(lang, "Why choose it", "Por qué elegirla");
const includedLabel = t(lang, "Included", "Incluido");
const termsLabel = t(lang, "Terms", "Condiciones");
const highlightsLabel = t(lang, "Package signals", "Señales del paquete");
const galleryLabel = t(lang, "Offer inspection", "Inspección de oferta");
const directLabel = t(lang, "Direct package request", "Solicitud directa de paquete");
const periodLabel = t(lang, "Period", "Periodo");

const resolveOfferInspectTitle = (src: string, index: number) => {
  if (index === 0) return offerTitle;

  const value = src.toLowerCase();

  if (value.includes("restaurant") || value.includes("dining")) {
    return t(lang, "Dining setting", "Escena de mesa");
  }

  if (value.includes("courtyard") || value.includes("pool")) {
    return t(lang, "Courtyard pause", "Pausa de patio");
  }

  if (value.includes("room") || value.includes("bed")) {
    return t(lang, "Room pairing", "Habitación asociada");
  }

  if (value.includes("terrace") || value.includes("sunset")) {
    return t(lang, "Stay extension", "Extensión de estancia");
  }

  if (value.includes("coffee") || value.includes("desk") || value.includes("breakfast")) {
    return t(lang, "Included detail", "Detalle incluido");
  }

  return t(lang, "Package preview", "Vista del paquete");
};

const resolveOfferInspectSection = (src: string, index: number) => {
  if (index === 0) return t(lang, "Offer", "Oferta");

  const value = src.toLowerCase();

  if (value.includes("restaurant") || value.includes("dining")) {
    return t(lang, "Dining", "Gastronomía");
  }

  if (value.includes("courtyard") || value.includes("pool")) {
    return t(lang, "Hotel space", "Espacio del hotel");
  }

  if (value.includes("room") || value.includes("bed")) {
    return t(lang, "Room", "Habitación");
  }

  if (value.includes("terrace") || value.includes("sunset")) {
    return t(lang, "Stay rhythm", "Ritmo de estancia");
  }

  return galleryLabel;
};

const resolveOfferInspectSignal = (src: string, index: number) => {
  if (index === 0) return offerPeriod || sales.bookingLogic;

  const value = src.toLowerCase();

  if (value.includes("restaurant") || value.includes("dining")) {
    return t(lang, "Table, timing and direct booking value.", "Mesa, momento y valor de reserva directa.");
  }

  if (value.includes("courtyard") || value.includes("pool")) {
    return t(lang, "Hotel atmosphere supporting the package.", "Atmósfera del hotel que acompaña el paquete.");
  }

  if (value.includes("room") || value.includes("bed")) {
    return t(lang, "Room context for the package rhythm.", "Contexto de habitación para el ritmo del paquete.");
  }

  if (value.includes("terrace") || value.includes("sunset")) {
    return t(lang, "Extra time, softer arrival and slower return.", "Más tiempo, llegada suave y regreso pausado.");
  }

  return t(lang, "Package, stay rhythm and direct booking detail.", "Paquete, ritmo de estancia y detalle de reserva directa.");
};

const offerInspectItems = galleryImages.map((src, index) => ({
  id: `${offer.slug}-${index + 1}`,
  title: resolveOfferInspectTitle(src, index),
  src,
  section: resolveOfferInspectSection(src, index),
  mood: sales.mood,
  signal: resolveOfferInspectSignal(src, index),
  alt: `${offerTitle} — ${index + 1}`,
}));

const offerGuideLabel = t(lang, "Package guide", "Guia del paquete");
const offerGuideTitle = t(
  lang,
  "See the value, timing and details before booking.",
  "Vea el valor, el momento y los detalles antes de reservar."
);
const offerGuideIntro = t(
  lang,
  "Compare the package reason, inclusions, conditions and atmosphere in one compact layer before opening the booking flow.",
  "Compare la razon del paquete, inclusiones, condiciones y atmosfera en una capa compacta antes de abrir la reserva."
);
const usefulDetailsLabel = t(lang, "Useful details", "Detalles utiles");
const directValueLabel = t(lang, "Direct value", "Valor directo");
const offerPhotoLabel = t(lang, "Package photos", "Fotos del paquete");
const galleryThumbnailsLabel = t(lang, "Choose package photo", "Elegir foto del paquete");
const previousImageLabel = t(lang, "Previous image", "Imagen anterior");
const nextImageLabel = t(lang, "Next image", "Siguiente imagen");
const offerGuideSignals = (offerHighlights.length ? offerHighlights : [
  sales.mood,
  sales.bestFor,
  sales.bookingLogic,
]).slice(0, 4);
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={offerMetaDescription}
  ogImage={offerCover}
  canonicalPath={`/${lang}/offers/${offer.slug}/`}
  fullBleed
>
  <section class="offer-detail-hero" data-dock-section>
    <img src={offerCover} alt="" class="offer-detail-hero__image" loading="eager" decoding="async" />
    <div class="offer-detail-hero__veil" aria-hidden="true"></div>

    <div class="offer-detail-hero__inner">
      <div class="offer-detail-hero__top">
        <a href={`/${lang}/offers/`}>← {backLabel}</a>
        <span>{offerEyebrow}</span>
      </div>

      <div class="offer-detail-hero__content">
        <div>
          <div class="offer-detail-kicker">{sales.mood}</div>
          <h1>{offerTitle}</h1>
          {offerPeriod ? <p>{offerPeriod}</p> : null}
        </div>

        <aside class="offer-detail-hero__panel">
          <div class="offer-detail-kicker">{packageSummaryLabel}</div>

          <h2>{sales.bookingLogic}</h2>
          <p>{sales.whyChoose}</p>

          <div class="offer-detail-hero__actions">
            {bookingUrl ? (
              <a href={bookingUrl} target="_blank" rel="noreferrer">
                {bookDirectLabel}
              </a>
            ) : null}

            <a href={`/${lang}/contact/`}>
              {contactHotelLabel}
            </a>
          </div>
        </aside>
      </div>

      <div class="offer-detail-hero__rail" aria-hidden="true">
        <span>{sales.bestFor}</span>
        {offerPeriod ? <span>{periodLabel}: {offerPeriod}</span> : null}
        {includedItems[0] ? <span>{includedLabel}: {includedItems[0]}</span> : null}
      </div>
    </div>
  </section>

  <section class="offer-guide" id="offer-guide" data-offer-gallery data-dock-section>
    <div class="offer-guide__copy">
      <div>
        <div class="offer-detail-kicker">{offerGuideLabel}</div>
        <h2>{offerGuideTitle}</h2>
        <p>{offerGuideIntro}</p>
      </div>

      <div class="offer-guide__facts" aria-label={usefulDetailsLabel}>
        <article>
          <span>{periodLabel}</span>
          <strong>{offerPeriod || t(lang, "By selected dates", "Segun fechas seleccionadas")}</strong>
        </article>
        <article>
          <span>{bestForLabel}</span>
          <strong>{sales.bestFor}</strong>
        </article>
        <article>
          <span>{moodLabel}</span>
          <strong>{sales.mood}</strong>
        </article>
        <article>
          <span>{directValueLabel}</span>
          <strong>{sales.bookingLogic}</strong>
        </article>
      </div>

      <div class="offer-guide__details">
        <div>
          <div class="offer-detail-kicker">{includedLabel}</div>
          {includedItems.length ? (
            <div class="offer-guide__chips">
              {includedItems.slice(0, 6).map((item) => (
                <span>{item}</span>
              ))}
            </div>
          ) : (
            <p>{t(lang, "The hotel confirms inclusions for your dates.", "El hotel confirma las inclusiones para sus fechas.")}</p>
          )}
        </div>

        <div>
          <div class="offer-detail-kicker">{termsLabel}</div>
          {termsItems.length ? (
            <div class="offer-guide__chips offer-guide__chips--quiet">
              {termsItems.slice(0, 4).map((item) => (
                <span>{item}</span>
              ))}
            </div>
          ) : (
            <p>{t(lang, "Terms are confirmed during direct booking.", "Las condiciones se confirman durante la reserva directa.")}</p>
          )}
        </div>
      </div>

      <div class="offer-guide__signals" aria-label={highlightsLabel}>
        {offerGuideSignals.map((item, index) => (
          <span>{String(index + 1).padStart(2, "0")} / {item}</span>
        ))}
      </div>

    </div>

    {offerInspectItems.length ? (
      <div class="offer-guide__gallery" aria-label={openGalleryLabel}>
        <div class="offer-detail-kicker">{offerPhotoLabel}</div>
        <div class="offer-guide__media">
          {offerInspectItems.map((item, index) => (
            <figure
              class:list={["offer-guide__slide", index === 0 && "is-active"]}
              data-offer-slide
              data-title={item.title}
            >
              <img src={item.src} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              <figcaption>
                <span>{String(index + 1).padStart(2, "0")} / {item.section}</span>
                <strong>{item.title}</strong>
                <p>{item.signal}</p>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="offer-guide__gallery-bar">
          <div>
            <span data-offer-count>01 / {String(offerInspectItems.length).padStart(2, "0")}</span>
            <strong data-offer-title>{offerInspectItems[0]?.title}</strong>
          </div>

          <div class="offer-guide__controls">
            <button type="button" data-offer-prev aria-label={previousImageLabel}>←</button>
            <button type="button" data-offer-next aria-label={nextImageLabel}>→</button>
          </div>
        </div>

        <div class="offer-guide__thumbs" aria-label={galleryThumbnailsLabel}>
          {offerInspectItems.map((item, index) => (
            <button
              type="button"
              class:list={["offer-guide__thumb", index === 0 && "is-active"]}
              data-offer-thumb
              aria-label={`${item.title} ${String(index + 1).padStart(2, "0")}`}
            >
              <img src={item.src} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
    ) : null}
  </section>

  <section class="offer-decision" data-dock-section>
    <div class="offer-decision__intro">
      <div>
        <div class="offer-detail-kicker">{t(lang, "Decision layer", "Capa de decisión")}</div>
        <h2>
          {t(
            lang,
            "Choose this package by intention, rhythm and timing.",
            "Elija este paquete por intención, ritmo y momento."
          )}
        </h2>
      </div>

      <p>
        {t(
          lang,
          "This offer is framed as a stay scenario: a reason to arrive, stay longer, move slower or let the hotel prepare more of the experience before you arrive.",
          "Esta oferta se presenta como un escenario de estancia: una razón para llegar, quedarse más tiempo, moverse más despacio o dejar que el hotel prepare más de la experiencia antes de llegar."
        )}
      </p>
    </div>

    <div class="offer-decision__grid">
      <article class="offer-decision__card offer-decision__card--dark">
        <span>{moodLabel}</span>
        <h3>{sales.mood}</h3>
        <p>{sales.bestFor}</p>
      </article>

      <article class="offer-decision__card">
        <span>{bookingLogicLabel}</span>
        <h3>{t(lang, "A package with a reason.", "Un paquete con una razón.")}</h3>
        <p>{sales.bookingLogic}</p>
      </article>

      <article class="offer-decision__card">
        <span>{whyChooseLabel}</span>
        <h3>{t(lang, "Direct value, not discount noise.", "Valor directo, no ruido de descuento.")}</h3>
        <p>{sales.whyChoose}</p>
      </article>
    </div>
  </section>

  <section class="offer-package-band" data-dock-section>
    <div class="offer-package-band__block">
      <div class="offer-detail-kicker">{includedLabel}</div>

      {includedItems.length ? (
        <div class="offer-package-band__chips">
          {includedItems.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      ) : (
        <p>{t(lang, "Package inclusions are available on request.", "Las inclusiones del paquete están disponibles bajo petición.")}</p>
      )}
    </div>

    <div class="offer-package-band__block">
      <div class="offer-detail-kicker">{termsLabel}</div>

      {termsItems.length ? (
        <div class="offer-package-band__terms">
          {termsItems.map((item, index) => (
            <span>{String(index + 1).padStart(2, "0")} / {item}</span>
          ))}
        </div>
      ) : (
        <p>{t(lang, "Terms are confirmed during booking.", "Las condiciones se confirman durante la reserva.")}</p>
      )}
    </div>
  </section>

  {offerHighlights.length ? (
    <section class="offer-signals" data-dock-section>
      <div>
        <div class="offer-detail-kicker">{highlightsLabel}</div>
        <h2>
          {t(
            lang,
            "What this package changes in the stay.",
            "Lo que este paquete cambia en la estancia."
          )}
        </h2>
      </div>

      <div class="offer-signals__list">
        {offerHighlights.map((item, index) => (
          <article>
            <small>{String(index + 1).padStart(2, "0")}</small>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>
  ) : null}

  {offerInspectItems.length ? (
    <section class="offer-inspection" data-dock-section>
      <div class="offer-inspection__intro">
        <div>
          <div class="offer-detail-kicker">{galleryLabel}</div>
          <h2>
            {t(
              lang,
              "Inspect the visual rhythm of the package.",
              "Inspeccione el ritmo visual del paquete."
            )}
          </h2>
        </div>

        <p>
          {t(
            lang,
            "Open the offer images as an inspect layer instead of a standard lightbox.",
            "Abra las imágenes de la oferta como una capa de inspección, no como un lightbox estándar."
          )}
        </p>
      </div>

      <CinematicInspectGallery
        id={`offer-${offer.slug}`}
        items={offerInspectItems}
        ariaLabel={openGalleryLabel}
        returnLabel={t(lang, "Return", "Volver")}
        previousLabel={t(lang, "Previous image", "Imagen anterior")}
        nextLabel={t(lang, "Next image", "Siguiente imagen")}
      />
    </section>
  ) : null}

  <section class="offer-direct" data-dock-section>
    <div>
      <div class="offer-detail-kicker">{directLabel}</div>
      <h2>
        {t(
          lang,
          "Ask the hotel to prepare this offer for your dates.",
          "Pida al hotel que prepare esta oferta para sus fechas."
        )}
      </h2>
    </div>

    <div>
      <p>
        {t(
          lang,
          "Package value depends on timing, room choice and availability. Contact the hotel if you want the offer prepared around your exact stay rhythm.",
          "El valor del paquete depende del momento, la habitación y la disponibilidad. Contacte con el hotel si quiere que la oferta se prepare alrededor de su ritmo exacto de estancia."
        )}
      </p>

      <div class="offer-direct__actions">
        {bookingUrl ? (
          <a href={bookingUrl} target="_blank" rel="noreferrer">{bookDirectLabel}</a>
        ) : null}
        <a href={`/${lang}/contact/`}>{contactHotelLabel}</a>
      </div>
    </div>
  </section>

  <style>
    .offer-detail-hero {
      position: relative;
      min-height: 100svh;
      margin-top: -5.2rem;
      overflow: hidden;
      background: #15120f;
      color: #fffaf2;
    }

    .offer-detail-hero__image {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      filter: brightness(1.08) contrast(1.05) saturate(1.02);
      transform: scale(1.015);
    }

    .offer-detail-hero__veil {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 72% 20%, rgba(255, 238, 208, 0.2), transparent 34rem),
        linear-gradient(90deg, rgba(5, 5, 4, 0.64), rgba(5, 5, 4, 0.14) 48%, rgba(5, 5, 4, 0.58)),
        linear-gradient(180deg, rgba(5, 5, 4, 0.14), rgba(5, 5, 4, 0.1) 42%, rgba(5, 5, 4, 0.78));
    }

    .offer-detail-hero__inner {
      position: relative;
      z-index: 2;
      display: flex;
      min-height: 100svh;
      width: min(100% - clamp(1.25rem, 4.6vw, 5.2rem), 1680px);
      margin-inline: auto;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(7.8rem, 13vh, 10.5rem) 0 clamp(1.4rem, 4vh, 2.8rem);
    }

    .offer-detail-hero__top,
    .offer-detail-hero__rail {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }

    .offer-detail-hero__top a,
