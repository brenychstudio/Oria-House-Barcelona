  <script>
    (() => {
      document.querySelectorAll("[data-offer-gallery]").forEach((root) => {
        const slides = Array.from(root.querySelectorAll("[data-offer-slide]"));
        const thumbs = Array.from(root.querySelectorAll("[data-offer-thumb]"));
        const prev = root.querySelector("[data-offer-prev]");
        const next = root.querySelector("[data-offer-next]");
        const count = root.querySelector("[data-offer-count]");
        const title = root.querySelector("[data-offer-title]");

        if (!slides.length) return;

        let active = 0;
        const total = String(slides.length).padStart(2, "0");

        const setActive = (index: number) => {
          active = (index + slides.length) % slides.length;

          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle("is-active", slideIndex === active);
          });

          thumbs.forEach((thumb, thumbIndex) => {
            thumb.classList.toggle("is-active", thumbIndex === active);
            thumb.setAttribute("aria-current", thumbIndex === active ? "true" : "false");
          });

          if (count) count.textContent = `${String(active + 1).padStart(2, "0")} / ${total}`;
          if (title) title.textContent = slides[active]?.getAttribute("data-title") || "";
        };

        prev?.addEventListener("click", () => setActive(active - 1));
        next?.addEventListener("click", () => setActive(active + 1));
        thumbs.forEach((thumb, index) => {
          thumb.addEventListener("click", () => setActive(index));
        });

        setActive(0);
      });
    })();
  </script>
