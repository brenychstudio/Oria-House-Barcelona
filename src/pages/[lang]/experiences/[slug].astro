---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../../content/languages";
import { getExperiences, getSettings } from "../../../cms/sheets";
import { pickLang, splitPipe } from "../../../cms/types";
import {
  EXPERIENCE_COVER_BY_SLUG,
  HOTEL_DEMO_ASSETS,
} from "../../../hotel/data/demoAssets";
import { getSeoCopy } from "../../../hotel/seo/siteSeo";
import CinematicInspectGallery from "../../../hotel/ui/CinematicInspectGallery.astro";

export async function getStaticPaths() {
  const experiences = await getExperiences();

  return LANGS.flatMap((lang) =>
    experiences.map((experience) => ({
      params: {
        lang,
        slug: experience.slug,
      },
      props: {
        experience,
      },
    }))
  );
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const { experience } = Astro.props as any;
const s = await getSettings();

const hotelName = t(
  lang,
  String((s as any).hotel_name_en || "Hotel Core"),
  String((s as any).hotel_name_es || (s as any).hotel_name_en || "Hotel Core")
);

const bookingUrl = String((s as any).booking_url || "").trim();

const experienceTitle = pickLang(lang, experience, "title");
const experienceDescription = pickLang(lang, experience, "description");

const experienceCategory = t(
  lang,
  String((experience as any).category_en || (experience as any).category || ""),
  String((experience as any).category_es || (experience as any).category || "")
).trim() || t(lang, "Hotel moment", "Momento del hotel");

const experienceCover =
  EXPERIENCE_COVER_BY_SLUG[experience.slug] ??
  (String((experience as any).cover_image || "").trim() ||
    HOTEL_DEMO_ASSETS.galleryCourtyardArrival);

const splitList = (value: string) =>
  String(value || "")
    .split(/[,|\n]/)
    .map((item) => item.trim())
    .filter(Boolean);

const experienceHighlights = splitPipe(pickLang(lang, experience, "highlights")).slice(0, 5);

const experienceGalleryBySlug: Record<string, string[]> = {
  "rooftop-sunset": [
    HOTEL_DEMO_ASSETS.experienceRooftopSunset,
    HOTEL_DEMO_ASSETS.galleryCourtyardArrival,
    HOTEL_DEMO_ASSETS.galleryPoolReflection,
  ],
  "spa-ritual": [
    HOTEL_DEMO_ASSETS.experienceSpaRitual,
    HOTEL_DEMO_ASSETS.detailBathroom,
    HOTEL_DEMO_ASSETS.detailWindowLight,
  ],
  "signature-breakfast": [
    HOTEL_DEMO_ASSETS.experienceSignatureBreakfast,
    HOTEL_DEMO_ASSETS.galleryDiningEvening,
    HOTEL_DEMO_ASSETS.detailDeskMorning,
  ],
  "wine-pairing": [
    HOTEL_DEMO_ASSETS.galleryDiningEvening,
    HOTEL_DEMO_ASSETS.experienceSignatureBreakfast,
    HOTEL_DEMO_ASSETS.galleryCourtyardArrival,
  ],
  "design-book-shelf": [
    HOTEL_DEMO_ASSETS.detailDeskMorning,
    HOTEL_DEMO_ASSETS.detailWindowLight,
    HOTEL_DEMO_ASSETS.galleryArchitectureStaircase,
  ],
  "gaudi-morning": [
    HOTEL_DEMO_ASSETS.experienceGaudiMorning,
    HOTEL_DEMO_ASSETS.galleryArchitectureStaircase,
    HOTEL_DEMO_ASSETS.detailDeskMorning,
  ],
  "private-photo-walk": [
    HOTEL_DEMO_ASSETS.experiencePrivatePhotoWalk,
    HOTEL_DEMO_ASSETS.galleryArchitectureStaircase,
    HOTEL_DEMO_ASSETS.galleryCourtyardArrival,
  ],
  "beach-day-kit": [
    HOTEL_DEMO_ASSETS.experienceBeachDayKit,
    HOTEL_DEMO_ASSETS.detailLinenSleepingArea,
    HOTEL_DEMO_ASSETS.detailDeskMorning,
  ],
  "beachday-kit": [
    HOTEL_DEMO_ASSETS.experienceBeachDayKit,
    HOTEL_DEMO_ASSETS.detailLinenSleepingArea,
    HOTEL_DEMO_ASSETS.detailDeskMorning,
  ],
};

const galleryImages = Array.from(
  new Set(
    [
      experienceCover,
      ...(experienceGalleryBySlug[experience.slug] ?? []),
    ].filter(Boolean)
  )
);

const optionalExperienceField = (key: string) =>
  t(
    lang,
    String((experience as any)?.[`${key}_en`] || ""),
    String((experience as any)?.[`${key}_es`] || "")
  ).trim();

const resolveExperienceSales = () => {
  const slug = String((experience as any)?.slug || "").toLowerCase();
  const category = String((experience as any)?.category || "").toLowerCase();

  const explicitMood = optionalExperienceField("mood");
  const explicitBestFor = optionalExperienceField("best_for");
  const explicitTiming = optionalExperienceField("timing");
  const explicitWhy = optionalExperienceField("why_choose");
  const explicitWhatToExpect = optionalExperienceField("what_to_expect");

  const profile = (() => {
    if (slug.includes("rooftop") || category.includes("event")) {
      return {
        mood: t(lang, "Golden-hour city pause", "Pausa urbana de hora dorada"),
        bestFor: t(
          lang,
          "Guests who want the city without rushing into it",
          "Huéspedes que quieren la ciudad sin prisa"
        ),
        timing: t(lang, "Late afternoon / sunset", "Tarde / atardecer"),
        whyChoose: t(
          lang,
          "Choose this moment when the stay needs a private transition between city energy and hotel calm.",
          "Elija este momento cuando la estancia necesite una transición privada entre la energía de la ciudad y la calma del hotel."
        ),
        whatToExpect: t(
          lang,
          "A slower terrace hour, soft light, a small table and the sense of Barcelona held at a distance.",
          "Una hora de terraza pausada, luz suave, una mesa pequeña y la sensación de Barcelona a distancia."
        ),
      };
    }

    if (slug.includes("spa") || category.includes("spa")) {
      return {
        mood: t(lang, "Recovery calm", "Calma de recuperación"),
        bestFor: t(
          lang,
          "Slow mornings, reset days and quieter arrivals",
          "Mañanas lentas, días de pausa y llegadas tranquilas"
        ),
        timing: t(lang, "Morning or early evening", "Mañana o primera noche"),
        whyChoose: t(
          lang,
          "Choose this ritual when the hotel should feel like a pause before the next city route.",
          "Elija este ritual cuando el hotel deba sentirse como una pausa antes de la siguiente ruta urbana."
        ),
        whatToExpect: t(
          lang,
          "A quiet wellness rhythm: towels, water, soft materials and a less hurried transition through the day.",
          "Un ritmo wellness tranquilo: toallas, agua, materiales suaves y una transición menos apresurada por el día."
        ),
      };
    }

    if (slug.includes("breakfast") || category.includes("dining")) {
      return {
        mood: t(lang, "Slow morning table", "Mesa de mañana pausada"),
        bestFor: t(
          lang,
          "Guests who want the day to start inside the hotel",
          "Huéspedes que quieren empezar el día dentro del hotel"
        ),
        timing: t(lang, "Morning", "Mañana"),
        whyChoose: t(
          lang,
          "Choose this experience when breakfast becomes part of the stay, not just a service.",
          "Elija esta experiencia cuando el desayuno se convierte en parte de la estancia, no solo en un servicio."
        ),
        whatToExpect: t(
          lang,
          "A prepared morning table, local ingredients and a calm first hour before the city gets louder.",
          "Una mesa de mañana preparada, ingredientes locales y una primera hora tranquila antes de que la ciudad despierte."
        ),
      };
    }

    if (slug.includes("wine") || category.includes("dining")) {
      return {
        mood: t(lang, "Evening tasting", "Cata de noche"),
        bestFor: t(
          lang,
          "Small evenings, local partners and slower conversations",
          "Noches pequeñas, colaboradores locales y conversaciones pausadas"
        ),
        timing: t(lang, "Evening", "Noche"),
        whyChoose: t(
          lang,
          "Choose this moment when the stay should end with a quiet table rather than a crowded plan.",
          "Elija este momento cuando la estancia debe terminar con una mesa tranquila y no con un plan lleno de ruido."
        ),
        whatToExpect: t(
          lang,
          "A small tasting rhythm: wine, table light, local pairing and a calmer close to the day.",
          "Un pequeño ritmo de cata: vino, luz de mesa, maridaje local y un cierre más tranquilo del día."
        ),
      };
    }

    if (slug.includes("gaudi") || category.includes("tour")) {
      return {
        mood: t(lang, "Early city route", "Ruta temprana por la ciudad"),
        bestFor: t(
          lang,
          "Guests who want culture before the crowds",
          "Huéspedes que buscan cultura antes de las multitudes"
        ),
        timing: t(lang, "Early morning", "Primera hora de la mañana"),
        whyChoose: t(
          lang,
          "Choose this route when Barcelona should feel curated, quiet and close to the hotel.",
          "Elija esta ruta cuando Barcelona debe sentirse curada, tranquila y cercana al hotel."
        ),
        whatToExpect: t(
          lang,
          "A compact cultural route designed around softer hours, quieter streets and a clear return to the hotel.",
          "Una ruta cultural compacta diseñada alrededor de horas suaves, calles más tranquilas y un regreso claro al hotel."
        ),
      };
    }

    if (slug.includes("beach") || category.includes("culture")) {
      return {
        mood: t(lang, "Sea-air reset", "Pausa de aire marino"),
        bestFor: t(
          lang,
          "Light travel days and softer Barcelona plans",
          "Días ligeros y planes más suaves en Barcelona"
        ),
        timing: t(lang, "Late morning / afternoon", "Media mañana / tarde"),
        whyChoose: t(
          lang,
          "Choose this experience when the stay needs a simple open-air escape.",
          "Elija esta experiencia cuando la estancia necesita una escapada sencilla al aire libre."
        ),
        whatToExpect: t(
          lang,
          "A simple coastal pause: air, light, towel, coffee and a slower return to the hotel.",
          "Una pausa costera simple: aire, luz, toalla, café y un regreso más pausado al hotel."
        ),
      };
    }

    return {
      mood: t(lang, "Curated hotel moment", "Momento curado del hotel"),
      bestFor: t(
        lang,
        "Guests who want the stay to extend beyond the room",
        "Huéspedes que quieren que la estancia vaya más allá de la habitación"
      ),
      timing: t(lang, "By request", "Bajo petición"),
      whyChoose: t(
        lang,
        "Choose this experience when the hotel should shape more of the day around your rhythm.",
        "Elija esta experiencia cuando el hotel debe dar más forma al día según su ritmo."
      ),
      whatToExpect: t(
        lang,
        "A curated stay moment prepared around timing, atmosphere and direct hotel guidance.",
        "Un momento curado de estancia preparado alrededor del tiempo, la atmósfera y la guía directa del hotel."
      ),
    };
  })();

  return {
    mood: explicitMood || profile.mood,
    bestFor: explicitBestFor || profile.bestFor,
    timing: explicitTiming || profile.timing,
    whyChoose: explicitWhy || profile.whyChoose,
    whatToExpect: explicitWhatToExpect || profile.whatToExpect,
  };
};

const sales = resolveExperienceSales();

const pageTitle = `${hotelName} — ${experienceTitle}`;
const seo = getSeoCopy("experienceDetail", lang);
const experienceMetaDescription =
  experienceDescription || sales.whatToExpect || seo.description;

const backLabel = t(lang, "Back to experiences", "Volver a experiencias");
const bookDirectLabel = t(lang, "Book direct", "Reservar directo");
const contactHotelLabel = t(lang, "Contact hotel", "Contactar hotel");
const openGalleryLabel = t(lang, "Inspect experience images", "Inspeccionar imágenes de experiencia");

const experienceEyebrow = t(lang, "Experience / Stay sequence", "Experiencia / Secuencia de estancia");
const sequenceLabel = t(lang, "Experience sequence", "Secuencia de experiencia");
const moodLabel = t(lang, "Mood", "Atmósfera");
const bestForLabel = t(lang, "Best for", "Ideal para");
const timingLabel = t(lang, "Best moment", "Mejor momento");
const whyChooseLabel = t(lang, "Why choose it", "Por qué elegirla");
const expectLabel = t(lang, "What to expect", "Qué esperar");
const categoryLabel = t(lang, "Experience type", "Tipo de experiencia");
const highlightsLabel = t(lang, "Experience signals", "Señales de experiencia");
const galleryLabel = t(lang, "Experience inspection", "Inspección de experiencia");
const directLabel = t(lang, "Plan the experience", "Planificar la experiencia");

const sequenceItems = [
  {
    index: "01",
    label: moodLabel,
    title: sales.mood,
    text: sales.bestFor,
    dark: true,
  },
  {
    index: "02",
    label: timingLabel,
    title: sales.timing,
    text: sales.whyChoose,
    dark: false,
  },
  {
    index: "03",
    label: expectLabel,
    title: t(lang, "A moment with a rhythm.", "Un momento con ritmo."),
    text: sales.whatToExpect,
    dark: false,
  },
];

const resolveExperienceInspectTitle = (src: string, index: number) => {
  if (index === 0) return experienceTitle;

  const value = src.toLowerCase();
  const slug = String((experience as any)?.slug || "").toLowerCase();

  if (value.includes("restaurant") || value.includes("dining") || slug.includes("breakfast") || slug.includes("wine")) {
    return t(lang, "Table moment", "Momento de mesa");
  }

  if (value.includes("spa") || value.includes("bath") || value.includes("towel")) {
    return t(lang, "Wellness detail", "Detalle wellness");
  }

  if (value.includes("terrace") || value.includes("rooftop") || value.includes("sunset")) {
    return t(lang, "Terrace hour", "Hora de terraza");
  }

  if (value.includes("street") || value.includes("gaudi") || value.includes("city")) {
    return t(lang, "City route", "Ruta urbana");
  }

  if (value.includes("beach") || value.includes("sea")) {
    return t(lang, "Sea-air pause", "Pausa de aire marino");
  }

  if (value.includes("courtyard") || value.includes("pool")) {
    return t(lang, "Hotel return", "Regreso al hotel");
  }

  return t(lang, "Experience detail", "Detalle de experiencia");
};

const resolveExperienceInspectSection = (src: string, index: number) => {
  if (index === 0) return t(lang, "Experience", "Experiencia");

  const value = src.toLowerCase();

  if (value.includes("restaurant") || value.includes("dining")) {
    return t(lang, "Dining", "Gastronomía");
  }

  if (value.includes("spa") || value.includes("bath") || value.includes("towel")) {
    return t(lang, "Wellness", "Wellness");
  }

  if (value.includes("terrace") || value.includes("rooftop") || value.includes("sunset")) {
    return t(lang, "Terrace", "Terraza");
  }

  if (value.includes("street") || value.includes("gaudi") || value.includes("city")) {
    return t(lang, "City", "Ciudad");
  }

  if (value.includes("beach") || value.includes("sea")) {
    return t(lang, "Sea", "Mar");
  }

  return galleryLabel;
};

const resolveExperienceInspectSignal = (src: string, index: number) => {
  if (index === 0) return experienceDescription || sales.whatToExpect;

  const value = src.toLowerCase();

  if (value.includes("restaurant") || value.includes("dining")) {
    return t(lang, "Table, light and slower conversation.", "Mesa, luz y conversación más pausada.");
  }

  if (value.includes("spa") || value.includes("bath") || value.includes("towel")) {
    return t(lang, "Recovery rhythm, water and soft material detail.", "Ritmo de recuperación, agua y detalle material suave.");
  }

  if (value.includes("terrace") || value.includes("rooftop") || value.includes("sunset")) {
    return t(lang, "Golden-hour pause between city and hotel calm.", "Pausa de hora dorada entre la ciudad y la calma del hotel.");
  }

  if (value.includes("street") || value.includes("gaudi") || value.includes("city")) {
    return t(lang, "A curated route through softer city hours.", "Una ruta curada por horas más suaves de la ciudad.");
  }

  if (value.includes("beach") || value.includes("sea")) {
    return t(lang, "Open air, sea light and a simpler return.", "Aire abierto, luz marina y un regreso más simple.");
  }

  return t(lang, "Atmosphere, timing and stay rhythm.", "Atmósfera, momento y ritmo de estancia.");
};

const experienceInspectItems = galleryImages.map((src, index) => ({
  id: `${experience.slug}-${index + 1}`,
  title: resolveExperienceInspectTitle(src, index),
  src,
  section: resolveExperienceInspectSection(src, index),
  mood: sales.mood,
  signal: resolveExperienceInspectSignal(src, index),
  alt: `${experienceTitle} — ${index + 1}`,
}));

const experienceGuideLabel = t(lang, "Experience guide", "Guia de experiencia");
const experienceGuideTitle = t(
  lang,
  "Plan the moment without losing the stay rhythm.",
  "Planifique el momento sin perder el ritmo de la estancia."
);
const experienceGuideIntro = t(
  lang,
  "Check timing, mood, type and the visual sequence in one compact layer before asking the hotel to shape it.",
  "Revise el momento, ambiente, tipo y secuencia visual en una capa compacta antes de pedir al hotel que lo prepare."
);
const usefulDetailsLabel = t(lang, "Useful details", "Detalles utiles");
const experiencePhotoLabel = t(lang, "Experience photos", "Fotos de experiencia");
const galleryThumbnailsLabel = t(lang, "Choose experience photo", "Elegir foto de experiencia");
const previousImageLabel = t(lang, "Previous image", "Imagen anterior");
const nextImageLabel = t(lang, "Next image", "Siguiente imagen");
const experienceGuideSignals = (experienceHighlights.length ? experienceHighlights : [
  sales.mood,
  sales.timing,
  sales.bestFor,
]).slice(0, 4);
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={experienceMetaDescription}
  ogImage={experienceCover}
  canonicalPath={`/${lang}/experiences/${experience.slug}/`}
  fullBleed
>
  <section class="experience-detail-hero" data-dock-section>
    <img src={experienceCover} alt="" class="experience-detail-hero__image" loading="eager" decoding="async" />
    <div class="experience-detail-hero__veil" aria-hidden="true"></div>

    <div class="experience-detail-hero__inner">
      <div class="experience-detail-hero__top">
        <a href={`/${lang}/experiences/`}>← {backLabel}</a>
        <span>{experienceEyebrow}</span>
      </div>

      <div class="experience-detail-hero__content">
        <div>
          <div class="experience-detail-kicker">{sales.mood}</div>
          <h1>{experienceTitle}</h1>
          <p>{experienceDescription}</p>
        </div>

        <aside class="experience-detail-hero__panel">
          <div class="experience-detail-kicker">{sequenceLabel}</div>

          <h2>{sales.timing}</h2>
          <p>{sales.whyChoose}</p>

          <div class="experience-detail-hero__actions">
            {bookingUrl ? (
              <a href={bookingUrl} target="_blank" rel="noreferrer">
                {bookDirectLabel}
              </a>
            ) : null}

            <a href={`/${lang}/contact/`}>
              {contactHotelLabel}
            </a>
          </div>
        </aside>
      </div>

      <div class="experience-detail-hero__rail" aria-hidden="true">
        <span>{sales.bestFor}</span>
        <span>{timingLabel}: {sales.timing}</span>
        <span>{categoryLabel}: {experienceCategory}</span>
      </div>
    </div>
  </section>

  <section class="experience-guide" id="experience-guide" data-experience-gallery data-dock-section>
    <div class="experience-guide__copy">
      <div>
        <div class="experience-detail-kicker">{experienceGuideLabel}</div>
        <h2>{experienceGuideTitle}</h2>
        <p>{experienceGuideIntro}</p>
      </div>

      <div class="experience-guide__facts" aria-label={usefulDetailsLabel}>
        <article>
          <span>{timingLabel}</span>
          <strong>{sales.timing}</strong>
        </article>
        <article>
          <span>{categoryLabel}</span>
          <strong>{experienceCategory}</strong>
        </article>
        <article>
          <span>{moodLabel}</span>
          <strong>{sales.mood}</strong>
        </article>
        <article>
          <span>{bestForLabel}</span>
          <strong>{sales.bestFor}</strong>
        </article>
      </div>

      <div class="experience-guide__details">
        <div>
          <div class="experience-detail-kicker">{expectLabel}</div>
          <p>{sales.whatToExpect}</p>
        </div>

        <div>
          <div class="experience-detail-kicker">{whyChooseLabel}</div>
          <p>{sales.whyChoose}</p>
        </div>
      </div>

      <div class="experience-guide__signals" aria-label={highlightsLabel}>
        {experienceGuideSignals.map((item, index) => (
          <span>{String(index + 1).padStart(2, "0")} / {item}</span>
        ))}
      </div>

    </div>

    {experienceInspectItems.length ? (
      <div class="experience-guide__gallery" aria-label={openGalleryLabel}>
        <div class="experience-detail-kicker">{experiencePhotoLabel}</div>
        <div class="experience-guide__media">
          {experienceInspectItems.map((item, index) => (
            <figure
              class:list={["experience-guide__slide", index === 0 && "is-active"]}
              data-experience-slide
              data-title={item.title}
            >
              <img src={item.src} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              <figcaption>
                <span>{String(index + 1).padStart(2, "0")} / {item.section}</span>
                <strong>{item.title}</strong>
                <p>{item.signal}</p>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="experience-guide__gallery-bar">
          <div>
            <span data-experience-count>01 / {String(experienceInspectItems.length).padStart(2, "0")}</span>
            <strong data-experience-title>{experienceInspectItems[0]?.title}</strong>
          </div>

          <div class="experience-guide__controls">
            <button type="button" data-experience-prev aria-label={previousImageLabel}>←</button>
            <button type="button" data-experience-next aria-label={nextImageLabel}>→</button>
          </div>
        </div>

        <div class="experience-guide__thumbs" aria-label={galleryThumbnailsLabel}>
          {experienceInspectItems.map((item, index) => (
            <button
              type="button"
              class:list={["experience-guide__thumb", index === 0 && "is-active"]}
              data-experience-thumb
              aria-label={`${item.title} ${String(index + 1).padStart(2, "0")}`}
            >
              <img src={item.src} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
    ) : null}
  </section>

  <section class="experience-sequence" data-dock-section>
    <div class="experience-sequence__intro">
      <div>
        <div class="experience-detail-kicker">{t(lang, "Decision layer", "Capa de decisión")}</div>
        <h2>
          {t(
            lang,
            "Choose this moment by rhythm, timing and return.",
            "Elija este momento por ritmo, tiempo y regreso."
          )}
        </h2>
      </div>

      <p>
        {t(
          lang,
          "This experience is framed as part of the stay sequence: a way to move from room to city, from city to table, or from noise back into hotel calm.",
          "Esta experiencia se presenta como parte de la secuencia de estancia: una forma de pasar de la habitación a la ciudad, de la ciudad a la mesa, o del ruido de vuelta a la calma del hotel."
        )}
      </p>
    </div>

    <div class="experience-sequence__grid">
      {sequenceItems.map((item) => (
        <article class:list={["experience-sequence__card", item.dark && "experience-sequence__card--dark"]}>
          <small>{item.index}</small>
          <span>{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="experience-planning" data-dock-section>
    <div class="experience-planning__block">
      <div class="experience-detail-kicker">{categoryLabel}</div>
      <h2>{experienceCategory}</h2>
      <p>{sales.whatToExpect}</p>
    </div>

    <div class="experience-planning__block">
      <div class="experience-detail-kicker">{highlightsLabel}</div>

      {experienceHighlights.length ? (
        <div class="experience-planning__signals">
          {experienceHighlights.map((item, index) => (
            <span>{String(index + 1).padStart(2, "0")} / {item}</span>
          ))}
        </div>
      ) : (
        <div class="experience-planning__signals">
          <span>01 / {sales.mood}</span>
          <span>02 / {sales.timing}</span>
          <span>03 / {sales.bestFor}</span>
        </div>
      )}
    </div>
  </section>

  {experienceInspectItems.length ? (
    <section class="experience-inspection" data-dock-section>
      <div class="experience-inspection__intro">
