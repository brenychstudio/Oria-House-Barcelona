      gap: 0.45rem;
    }

    .experience-card__meta span {
      border: 1px solid rgba(21, 18, 15, 0.1);
      background: rgba(255, 255, 255, 0.34);
      padding: 0.55rem 0.65rem;
      line-height: 1.28;
      text-transform: none;
      letter-spacing: 0;
      color: rgba(21, 18, 15, 0.62);
    }

    .experience-card__signal {
      border-top: 1px solid rgba(21, 18, 15, 0.1);
      padding-top: 0.85rem;
    }

    .experience-card__signal strong {
      display: block;
      margin-top: 0.55rem;
      color: rgba(21, 18, 15, 0.76);
      font-size: 0.96rem;
      line-height: 1.4;
      font-weight: 400;
    }

    .experience-card__actions {
      align-self: end;
      justify-self: start;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .experience-card__open,
    .experience-card__book {
      display: inline-flex;
      min-height: 2.45rem;
      align-items: center;
      justify-content: center;
