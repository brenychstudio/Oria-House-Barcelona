      padding-inline: 0.95rem;
      font-size: 0.84rem;
      text-decoration: none;
    }

    .experience-card__open {
      background: #15120f;
      color: #fffaf2;
    }

    .experience-card__book {
      border: 1px solid rgba(21, 18, 15, 0.16);
      background: rgba(255, 250, 242, 0.42);
      color: #15120f;
    }

    .experiences-field,
    .experiences-archive,
    .experiences-direct,
    .experiences-empty {
      width: min(100% - clamp(1.25rem, 4.6vw, 5.2rem), 1480px);
      margin-inline: auto;
      margin-top: clamp(6rem, 11vw, 10rem);
    }

    .experiences-kicker {
      color: rgba(21, 18, 15, 0.42);
    }

    .experiences-field__intro {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.52fr);
      gap: clamp(2rem, 7vw, 7rem);
      align-items: end;
    }

    .experiences-field__intro h2,
    .experiences-archive__intro h2,
    .experiences-direct h2,
    .experiences-empty h1 {
      margin-top: 1.1rem;
      max-width: 11ch;
      font-size: 7rem;
      line-height: 0.88;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .experiences-field__intro p,
    .experiences-archive__intro p,
    .experiences-direct p,
    .experiences-empty p {
      max-width: 34rem;
      font-size: 1rem;
      line-height: 1.82;
      color: rgba(21, 18, 15, 0.64);
    }

    .experiences-theatre {
      margin-top: clamp(2.4rem, 5vw, 4.8rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.42fr);
      gap: clamp(1.2rem, 4vw, 4rem);
      align-items: stretch;
    }

    .experiences-theatre__visual {
      position: relative;
      min-height: clamp(38rem, 58vw, 56rem);
      overflow: hidden;
      background: #15120f;
      color: #fffaf2;
      outline: none;
      box-shadow: 0 42px 130px rgba(21, 18, 15, 0.14);
    }

    .experiences-theatre__visual img {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      filter: brightness(1.08) contrast(1.05) saturate(1.03);
      transform: scale(1.015);
    }

    .experiences-field.is-switching .experiences-theatre__visual img {
      animation: experiencesImageIn 780ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .experiences-field.is-switching[data-direction="-1"] .experiences-theatre__visual img {
      animation-name: experiencesImageInReverse;
    }

    .experiences-theatre__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(0, 0, 0, 0.08), transparent 46%, rgba(0, 0, 0, 0.22)),
        linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.2) 48%, rgba(0, 0, 0, 0.78));
    }

    .experiences-theatre__sweep {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      background: linear-gradient(
        105deg,
        transparent 0%,
        rgba(255, 250, 242, 0.18) 42%,
        transparent 58%
      );
      transform: translateX(-120%);
    }

    .experiences-field.is-switching .experiences-theatre__sweep {
      animation: experiencesSweep 780ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .experiences-theatre__readout {
      position: absolute;
      left: clamp(1.2rem, 3vw, 2.4rem);
      right: clamp(1.2rem, 3vw, 2.4rem);
      bottom: clamp(1.2rem, 3vw, 2.4rem);
      border-top: 1px solid rgba(255, 250, 242, 0.24);
      padding-top: 1rem;
      z-index: 2;
    }

    .experiences-theatre__readout span,
    .experiences-theatre__readout small {
      display: block;
      font-size: 0.64rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 250, 242, 0.48);
    }

    .experiences-theatre__readout small {
      margin-top: 1rem;
    }

    .experiences-theatre__readout strong {
      margin-top: 0.8rem;
      display: block;
      max-width: 10ch;
      font-size: 5.8rem;
      line-height: 0.88;
      letter-spacing: 0;
      font-weight: 400;
      text-shadow: 0 18px 80px rgba(0, 0, 0, 0.34);
    }

    .experiences-theatre__readout p {
      margin-top: 1rem;
      max-width: 34rem;
      color: rgba(255, 250, 242, 0.72);
    }

    .experiences-theatre__nav {
