    }

    .experiences-theatre__panel h3 {
      margin-top: 1.1rem;
      max-width: 9ch;
      font-size: 4.6rem;
      line-height: 0.9;
      letter-spacing: 0;
      font-weight: 400;
    }

    .experiences-theatre__panel p {
      margin-top: 1.1rem;
      max-width: 30rem;
      font-size: 0.96rem;
      line-height: 1.76;
      color: rgba(21, 18, 15, 0.64);
    }

    .experiences-theatre__decision {
      margin-top: 2rem;
      display: grid;
      gap: 0.65rem;
    }

    .experiences-theatre__decision div {
      display: grid;
      grid-template-columns: minmax(7rem, 0.35fr) minmax(0, 1fr);
      gap: 1rem;
      border-top: 1px solid rgba(21, 18, 15, 0.1);
      padding-top: 0.72rem;
    }

    .experiences-theatre__decision dt {
      font-size: 0.58rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.42);
    }

    .experiences-theatre__decision dd {
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.55;
      color: rgba(21, 18, 15, 0.68);
    }

    .experiences-theatre__bottom {
      align-self: end;
      border-top: 1px solid rgba(21, 18, 15, 0.12);
      padding-top: 1.2rem;
    }

    .experiences-theatre__category {
      border: 1px solid rgba(21, 18, 15, 0.1);
      background: rgba(255, 250, 242, 0.42);
      padding: 1rem;
    }

    .experiences-theatre__category span {
      display: block;
      font-size: 0.58rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.42);
    }

    .experiences-theatre__category strong {
      margin-top: 0.6rem;
      display: block;
      font-size: 1.25rem;
      font-weight: 400;
    }

    .experiences-theatre__actions a:first-child {
      background: #15120f;
      color: #fffaf2;
    }

    .experiences-theatre__actions a:last-child {
      border-color: rgba(21, 18, 15, 0.16);
      color: #15120f;
      background: rgba(255, 250, 242, 0.42);
    }

    .experiences-rail {
      margin-top: 1rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 0.65rem;
    }

    .experiences-rail__item {
      border: 1px solid rgba(21, 18, 15, 0.1);
      background: rgba(255, 250, 242, 0.38);
      padding: 1rem;
      text-align: left;
      cursor: pointer;
    }

    .experiences-rail__item span,
    .experiences-rail__item small {
      display: block;
      font-size: 0.58rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.42);
    }

    .experiences-rail__item em {
      margin-top: 0.7rem;
      display: block;
      font-style: normal;
      font-size: 0.58rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.48);
    }

    .experiences-rail__item strong {
      margin-top: 0.62rem;
      display: block;
      font-size: 1.4rem;
      font-weight: 400;
      letter-spacing: 0;
    }

    .experiences-rail__item small {
      margin-top: 0.8rem;
      text-transform: none;
    }

    .experiences-rail__item.is-active {
      background: #15120f;
      color: #fffaf2;
    }

    .experiences-rail__item.is-active span,
    .experiences-rail__item.is-active small,
    .experiences-rail__item.is-active em {
      color: rgba(255, 250, 242, 0.58);
    }

    .experiences-archive {
      display: grid;
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }

    .experiences-archive__list {
      display: grid;
      border-top: 1px solid rgba(21, 18, 15, 0.12);
    }

    .experiences-archive__row {
      display: grid;
      grid-template-columns: 4rem minmax(0, 1fr) minmax(14rem, 0.48fr) auto;
      gap: 1rem;
      align-items: center;
      border-bottom: 1px solid rgba(21, 18, 15, 0.12);
      padding: 1.2rem 0;
      color: #15120f;
      text-decoration: none;
    }

    .experiences-archive__index,
    .experiences-archive__meta,
    .experiences-archive__open {
      font-size: 0.72rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.44);
    }

    .experiences-archive__row h3 {
      font-size: 2.4rem;
      line-height: 1;
      letter-spacing: 0;
      font-weight: 400;
    }

    .experiences-archive__row p {
      margin-top: 0.5rem;
      color: rgba(21, 18, 15, 0.62);
    }

    .experiences-archive__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      justify-content: flex-end;
    }

    .experiences-archive__meta span:first-child {
      flex-basis: 100%;
      max-width: 20rem;
      text-align: right;
      text-transform: none;
      letter-spacing: 0;
      line-height: 1.35;
      color: rgba(21, 18, 15, 0.62);
    }

    .experiences-archive__open {
      text-align: right;
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }

    .experiences-direct {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.56fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: end;
      border-top: 1px solid rgba(21, 18, 15, 0.12);
      padding-top: clamp(2rem, 4vw, 3rem);
      padding-bottom: clamp(5rem, 8vw, 7rem);
    }

    .experiences-direct__actions a:first-child {
      background: #15120f;
      color: #fffaf2;
    }

    .experiences-direct__actions a:last-child {
      border-color: rgba(21, 18, 15, 0.16);
      color: #15120f;
      background: rgba(255, 250, 242, 0.42);
    }

    .experiences-empty {
      min-height: 80svh;
      display: grid;
      place-content: center;
    }

    @keyframes experiencesImageIn {
      from {
        opacity: 0.32;
        transform: translate3d(30px, 0, 0) scale(1.04);
        filter: blur(12px) brightness(1.06) contrast(1.04);
      }
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1.015);
        filter: blur(0) brightness(1.08) contrast(1.05) saturate(1.03);
      }
    }

    @keyframes experiencesImageInReverse {
      from {
        opacity: 0.32;
        transform: translate3d(-30px, 0, 0) scale(1.04);
        filter: blur(12px) brightness(1.06) contrast(1.04);
      }
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1.015);
        filter: blur(0) brightness(1.08) contrast(1.05) saturate(1.03);
      }
    }

    @keyframes experiencesSweep {
      0% {
        opacity: 0;
        transform: translateX(-120%);
      }
      34% {
        opacity: 0.5;
      }
      100% {
        opacity: 0;
        transform: translateX(120%);
      }
    }

    @media (max-width: 1180px) {
      .experiences-hero h1 {
        font-size: 6.6rem;
      }

      .experiences-field__intro h2,
      .experiences-archive__intro h2,
      .experiences-direct h2,
      .experiences-empty h1 {
        font-size: 5.8rem;
      }

      .experiences-theatre__readout strong {
        font-size: 4.8rem;
      }

      .experiences-theatre__panel h3 {
        font-size: 3.8rem;
      }
    }

    @media (max-width: 980px) {
      .experiences-hero__content,
      .experiences-browser__head,
      .experiences-field__intro,
      .experiences-theatre,
      .experiences-archive,
      .experiences-direct {
        grid-template-columns: 1fr;
      }

      .experiences-hero__rail {
        display: grid;
      }

      .experiences-archive__row {
        grid-template-columns: 3rem minmax(0, 1fr);
      }

      .experiences-archive__meta,
      .experiences-archive__open {
        grid-column: 2;
        justify-content: flex-start;
        text-align: left;
      }

      .experiences-archive__meta span:first-child {
        text-align: left;
      }

      .experiences-theatre__decision div {
        grid-template-columns: 1fr;
        gap: 0.4rem;
      }

      .experiences-browser__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .experiences-hero__inner,
      .experiences-browser,
      .experiences-field,
      .experiences-archive,
      .experiences-direct,
      .experiences-empty {
        width: min(100% - 1rem, 1480px);
      }

      .experiences-hero h1,
      .experiences-field__intro h2,
      .experiences-archive__intro h2,
      .experiences-direct h2,
