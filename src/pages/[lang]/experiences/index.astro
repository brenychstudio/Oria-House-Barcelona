---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../../content/languages";
import { getExperiences, getSettings } from "../../../cms/sheets";
import { pickLang } from "../../../cms/types";
import { EXPERIENCE_COVER_BY_SLUG } from "../../../hotel/data/demoAssets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const s = await getSettings();

const experiences = await getExperiences();
const visibleExperiences = experiences.filter((experience) =>
  Boolean(EXPERIENCE_COVER_BY_SLUG[experience.slug] ?? (experience.cover_image ?? "").trim())
);

const siteName = t(lang, s.hotel_name_en, s.hotel_name_es);
const pageTitle = `${siteName} - ${t(lang, "Experiences", "Experiencias")}`;
const bookingUrl = String((s as any).booking_url || "").trim();

const optionalExperienceField = (experience: any, key: string) =>
  t(
    lang,
    String(experience?.[`${key}_en`] || ""),
    String(experience?.[`${key}_es`] || "")
  ).trim();

const resolveExperienceSales = (experience: any, index: number) => {
  const slug = String(experience?.slug || "").toLowerCase();
  const category = String(experience?.category || "").toLowerCase();

  const explicitMood = optionalExperienceField(experience, "mood");
  const explicitBestFor = optionalExperienceField(experience, "best_for");
  const explicitTiming = optionalExperienceField(experience, "timing");
  const explicitWhy = optionalExperienceField(experience, "why_choose");

  const profile = (() => {
    if (slug.includes("rooftop") || category.includes("event")) {
      return {
        mood: t(lang, "Golden-hour city pause", "Pausa urbana de hora dorada"),
        bestFor: t(lang, "Guests who want the city without rushing into it", "Huéspedes que quieren la ciudad sin prisa"),
        timing: t(lang, "Late afternoon / sunset", "Tarde / atardecer"),
        whyChoose: t(
          lang,
          "Choose this moment when the stay needs a private transition between city energy and hotel calm.",
          "Elija este momento cuando la estancia necesite una transición privada entre la energía de la ciudad y la calma del hotel."
        ),
      };
    }

    if (slug.includes("spa") || category.includes("spa")) {
      return {
        mood: t(lang, "Recovery calm", "Calma de recuperación"),
        bestFor: t(lang, "Slow mornings, reset days and quieter arrivals", "Mañanas lentas, días de pausa y llegadas tranquilas"),
        timing: t(lang, "Morning or early evening", "Mañana o primera noche"),
        whyChoose: t(
          lang,
          "Choose this ritual when the hotel should feel like a pause before the next city route.",
          "Elija este ritual cuando el hotel deba sentirse como una pausa antes de la siguiente ruta urbana."
        ),
      };
    }

    if (slug.includes("breakfast") || category.includes("breakfast")) {
      return {
        mood: t(lang, "Slow morning table", "Mesa de mañana pausada"),
        bestFor: t(lang, "Guests who want the day to start inside the hotel", "Huéspedes que quieren empezar el día dentro del hotel"),
        timing: t(lang, "Morning", "Mañana"),
        whyChoose: t(
          lang,
          "Choose this experience when breakfast becomes part of the stay, not just a service.",
          "Elija esta experiencia cuando el desayuno se convierte en parte de la estancia, no solo en un servicio."
        ),
      };
    }

    if (slug.includes("wine") || category.includes("dining")) {
      return {
        mood: t(lang, "Evening tasting", "Cata de noche"),
        bestFor: t(lang, "Small evenings, local partners and slower conversations", "Noches pequeñas, colaboradores locales y conversaciones pausadas"),
        timing: t(lang, "Evening", "Noche"),
        whyChoose: t(
          lang,
          "Choose this moment when the stay should end with a quiet table rather than a crowded plan.",
          "Elija este momento cuando la estancia debe terminar con una mesa tranquila y no con un plan lleno de ruido."
        ),
      };
    }

    if (slug.includes("gaudi") || category.includes("tour")) {
      return {
        mood: t(lang, "Early city route", "Ruta temprana por la ciudad"),
        bestFor: t(lang, "Guests who want culture before the crowds", "Huéspedes que buscan cultura antes de las multitudes"),
        timing: t(lang, "Early morning", "Primera hora de la mañana"),
        whyChoose: t(
          lang,
          "Choose this route when Barcelona should feel curated, quiet and close to the hotel.",
          "Elija esta ruta cuando Barcelona debe sentirse curada, tranquila y cercana al hotel."
        ),
      };
    }

    if (slug.includes("beach") || category.includes("culture")) {
      return {
        mood: t(lang, "Sea-air reset", "Pausa de aire marino"),
        bestFor: t(lang, "Light travel days and softer Barcelona plans", "Días ligeros y planes más suaves en Barcelona"),
        timing: t(lang, "Late morning / afternoon", "Media mañana / tarde"),
        whyChoose: t(
          lang,
          "Choose this experience when the stay needs a simple open-air escape.",
          "Elija esta experiencia cuando la estancia necesita una escapada sencilla al aire libre."
        ),
      };
    }

    return {
      mood: t(lang, "Curated hotel moment", "Momento curado del hotel"),
      bestFor: t(lang, "Guests who want the stay to extend beyond the room", "Huéspedes que quieren que la estancia vaya más allá de la habitación"),
      timing: t(lang, "By request", "Bajo petición"),
      whyChoose: t(
        lang,
        "Choose this experience when the hotel should shape more of the day around your rhythm.",
        "Elija esta experiencia cuando el hotel debe dar más forma al día según su ritmo."
      ),
    };
  })();

  return {
    mood: explicitMood || profile.mood,
    bestFor: explicitBestFor || profile.bestFor,
    timing: explicitTiming || profile.timing,
    whyChoose: explicitWhy || profile.whyChoose,
  };
};

const experienceItems = visibleExperiences.map((experience, index) => {
  const title = pickLang(lang, experience, "title");
  const description = pickLang(lang, experience, "description");

  const category = t(
    lang,
    String((experience as any).category_en || (experience as any).category || ""),
    String((experience as any).category_es || (experience as any).category || "")
  ).trim();

  const sales = resolveExperienceSales(experience, index);

  return {
    id: (experience as any).id || experience.slug || `experience-${index + 1}`,
    slug: experience.slug,
    href: `/${lang}/experiences/${experience.slug}/`,
    title,
    description,
    category: category || t(lang, "Hotel moment", "Momento del hotel"),
    image: EXPERIENCE_COVER_BY_SLUG[experience.slug] ?? experience.cover_image,
    index,
    mood: sales.mood,
    bestFor: sales.bestFor,
    timing: sales.timing,
    whyChoose: sales.whyChoose,
  };
});

const firstExperience = experienceItems[0];

const heroExperience =
  experienceItems.find((experience) =>
    ["rooftop", "wine", "spa", "breakfast"].some((key) =>
      String(experience.slug || "").includes(key)
    )
  ) ?? firstExperience;

const heroEyebrow = t(lang, "Experiences / Stay rituals", "Experiencias / Rituales de estancia");
const heroTitle = t(
  lang,
  "Rituals, views and local moments beyond the room.",
  "Rituales, vistas y momentos locales más allá de la habitación."
);
const heroText = t(
  lang,
  "Move through terraces, tables, recovery rituals and early city routes as part of one slower Barcelona stay.",
  "Recorra terrazas, mesas, rituales de calma y rutas tempranas por la ciudad como parte de una estancia más pausada en Barcelona."
);

const fieldEyebrow = t(lang, "Experience field", "Campo de experiencias");
const fieldTitle = t(
  lang,
  "Choose the moment by rhythm, not by category.",
  "Elija el momento por ritmo, no por categoría."
);
const fieldText = t(
  lang,
  "Each experience is framed as a state of the stay: morning, recovery, city route, table, sunset and return.",
  "Cada experiencia se presenta como un estado de la estancia: mañana, recuperación, ruta urbana, mesa, atardecer y regreso."
);

const activeLabel = t(lang, "Active experience", "Experiencia activa");
const openExperienceLabel = t(lang, "Open experience", "Abrir experiencia");
const bookDirectLabel = t(lang, "Book direct", "Reservar directo");
const contactHotelLabel = t(lang, "Contact hotel", "Contactar hotel");
const previousExperienceLabel = t(lang, "Previous experience", "Experiencia anterior");
const nextExperienceLabel = t(lang, "Next experience", "Siguiente experiencia");

const moodLabel = t(lang, "Mood", "Atmósfera");
const bestForLabel = t(lang, "Best for", "Ideal para");
const timingLabel = t(lang, "Best moment", "Mejor momento");
const whyChooseLabel = t(lang, "Why choose it", "Por qué elegirla");

const archiveLabel = t(lang, "Experience archive", "Archivo de experiencias");
const archiveTitle = t(
  lang,
  "All moments, kept in sequence.",
  "Todos los momentos, mantenidos en secuencia."
);
const archiveText = t(
  lang,
  "Use the visual field to feel the rhythm, then use the archive to compare every experience directly.",
  "Use el campo visual para sentir el ritmo y el archivo para comparar cada experiencia directamente."
);

const emptyTitle = t(lang, "Experiences are being prepared.", "Las experiencias se están preparando.");
const emptyText = t(
  lang,
  "Published experiences with cover images will appear here.",
  "Las experiencias publicadas con imagen aparecerán aquí."
);

const browseLabel = t(lang, "Experience browser", "Explorador de experiencias");
const browseTitle = t(
  lang,
  "Find the right moment by time, mood and energy.",
  "Encuentre el momento adecuado por hora, ambiente y energia."
);
const browseText = t(
  lang,
  "A compact planner for rituals, tables, routes and quiet returns, built for scanning instead of theatrical browsing.",
  "Un planificador compacto para rituales, mesas, rutas y regresos tranquilos, pensado para escanear sin teatro visual grande."
);
const experiencesAvailableLabel = t(lang, "Experiences available", "Experiencias disponibles");
const experienceMomentLabel = t(lang, "Stay moment", "Momento de estancia");
---

<BaseLayout lang={lang} title={pageTitle} fullBleed>
  {firstExperience ? (
    <>
      <section class="experiences-hero" data-dock-section>
        <img
          src={heroExperience?.image ?? firstExperience.image}
          alt=""
          class="experiences-hero__image"
          loading="eager"
          decoding="async"
        />

        <div class="experiences-hero__veil" aria-hidden="true"></div>

        <div class="experiences-hero__inner">
          <div class="experiences-hero__top">
            <span>{heroEyebrow}</span>
            <span>{t(lang, "Opening moment", "Momento inicial")} / {heroExperience?.title ?? firstExperience.title}</span>
          </div>

          <div class="experiences-hero__content">
            <h1>{heroTitle}</h1>

            <aside>
              <p>{heroText}</p>

              <div class="experiences-hero__actions">
                <a href="#experiences-browser">
                  {t(lang, "Explore experiences", "Explorar experiencias")}
                </a>

                {bookingUrl ? (
                  <a href={bookingUrl} target="_blank" rel="noreferrer">
                    {bookDirectLabel}
                  </a>
                ) : null}
              </div>
            </aside>
          </div>

          <div class="experiences-hero__rail" aria-hidden="true">
            {experienceItems.slice(0, 4).map((experience, index) => (
              <span>{String(index + 1).padStart(2, "0")} / {experience.title}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="experiences-browser" class="experiences-browser" data-dock-section>
        <div class="experiences-browser__head">
          <div>
            <div class="experiences-kicker">{browseLabel}</div>
            <h2>{browseTitle}</h2>
            <p>{browseText}</p>
          </div>

          <aside class="experiences-browser__summary">
            <span>{experiencesAvailableLabel}</span>
            <strong>{experienceItems.length}</strong>
            <p>{fieldText}</p>
          </aside>
        </div>

        <div class="experiences-browser__grid">
          {experienceItems.map((experience, index) => (
            <article class="experience-card">
              <a href={experience.href} class="experience-card__media" aria-label={`${openExperienceLabel}: ${experience.title}`}>
                <img src={experience.image} alt="" loading={index < 4 ? "eager" : "lazy"} decoding="async" />
                <span>{String(index + 1).padStart(2, "0")}</span>
              </a>

              <div class="experience-card__body">
                <div>
                  <div class="experience-card__eyebrow">{experience.category}</div>
                  <h3>
                    <a href={experience.href}>{experience.title}</a>
                  </h3>
                  <p>{experience.description || experience.whyChoose}</p>
                </div>

                <div class="experience-card__meta">
                  <span>{timingLabel}: {experience.timing}</span>
                  <span>{experience.mood}</span>
                </div>

                <div class="experience-card__signal">
                  <span>{experienceMomentLabel}</span>
                  <strong>{experience.bestFor}</strong>
                </div>

                <div class="experience-card__actions">
                  <a class="experience-card__open" href={experience.href}>{openExperienceLabel}</a>
                  {bookingUrl ? (
                    <a
                      class="experience-card__book"
                      href={bookingUrl}
                      target="_blank"
                      rel="noreferrer"
                      data-booking-trigger="true"
                      data-booking-context="experience"
                      data-booking-slug={experience.slug}
                      data-booking-title={experience.title}
                    >
                      {bookDirectLabel}
                    </a>
                  ) : null}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="experience-field" class="experiences-field" data-experience-index-field data-dock-section>
        <div class="experiences-field__intro">
          <div>
            <div class="experiences-kicker">{fieldEyebrow}</div>
            <h2>{fieldTitle}</h2>
          </div>

          <p>{fieldText}</p>
        </div>

        <div class="experiences-theatre">
          <div
            class="experiences-theatre__visual"
            data-experience-stage
            tabindex="0"
            role="group"
            aria-label={fieldTitle}
          >
            <img
              data-experience-active-image
              src={firstExperience.image}
              alt=""
              loading="eager"
              decoding="async"
            />

            <div class="experiences-theatre__shade" aria-hidden="true"></div>
            <div class="experiences-theatre__sweep" aria-hidden="true"></div>

            <div class="experiences-theatre__readout">
              <span data-experience-active-count>
                01 / {String(experienceItems.length).padStart(2, "0")}
              </span>
              <small data-experience-active-category>{firstExperience.category}</small>
              <strong data-experience-active-title>{firstExperience.title}</strong>
              <p data-experience-active-description>{firstExperience.description}</p>
            </div>

            <div class="experiences-theatre__nav">
              <button type="button" data-experience-prev aria-label={previousExperienceLabel}>←</button>
              <button type="button" data-experience-next aria-label={nextExperienceLabel}>→</button>
            </div>
          </div>

          <aside class="experiences-theatre__panel">
            <div>
              <div class="experiences-kicker">{activeLabel}</div>

              <h3 data-experience-panel-title>{firstExperience.title}</h3>
              <p data-experience-panel-description>{firstExperience.description}</p>

              <dl class="experiences-theatre__decision">
                <div>
                  <dt>{moodLabel}</dt>
                  <dd data-experience-mood>{firstExperience.mood}</dd>
                </div>

                <div>
                  <dt>{bestForLabel}</dt>
                  <dd data-experience-best-for>{firstExperience.bestFor}</dd>
                </div>

                <div>
                  <dt>{timingLabel}</dt>
                  <dd data-experience-timing>{firstExperience.timing}</dd>
                </div>

                <div>
                  <dt>{whyChooseLabel}</dt>
                  <dd data-experience-why-choose>{firstExperience.whyChoose}</dd>
                </div>
              </dl>
            </div>

            <div class="experiences-theatre__bottom">
              <div class="experiences-theatre__category">
                <span>{t(lang, "Experience type", "Tipo de experiencia")}</span>
                <strong data-experience-category>{firstExperience.category}</strong>
              </div>

              <div class="experiences-theatre__actions">
                <a href={firstExperience.href} data-experience-open-link>{openExperienceLabel}</a>

                {bookingUrl ? (
                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noreferrer"
                    data-experience-booking-link
                    data-booking-trigger="true"
                    data-booking-context="experience"
                    data-booking-slug={firstExperience.slug}
                    data-booking-title={firstExperience.title}
                  >
                    {bookDirectLabel}
                  </a>
                ) : (
                  <a href={`/${lang}/contact/`}>{contactHotelLabel}</a>
                )}
              </div>
            </div>
          </aside>
        </div>

        <div class="experiences-rail" aria-label={t(lang, "Experience selector", "Selector de experiencias")}>
          {experienceItems.map((experience, index) => (
            <button
              type="button"
              data-experience-thumb={index}
              class:list={["experiences-rail__item", index === 0 && "is-active"]}
              aria-current={index === 0 ? "true" : undefined}
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              <em>{experience.mood}</em>
              <strong>{experience.title}</strong>
              <small>{experience.timing}</small>
            </button>
          ))}
        </div>
      </section>

      <section class="experiences-archive" data-dock-section>
        <div class="experiences-archive__intro">
          <div class="experiences-kicker">{archiveLabel}</div>
          <h2>{archiveTitle}</h2>
          <p>{archiveText}</p>
        </div>

        <div class="experiences-archive__list">
          {experienceItems.map((experience, index) => (
            <a href={experience.href} class="experiences-archive__row">
              <div class="experiences-archive__index">{String(index + 1).padStart(2, "0")}</div>

              <div>
                <h3>{experience.title}</h3>
                <p>{experience.description}</p>
              </div>

              <div class="experiences-archive__meta">
                <span>{experience.bestFor}</span>
                <span>{experience.timing}</span>
                <span>{experience.category}</span>
              </div>

              <div class="experiences-archive__open">{openExperienceLabel}</div>
            </a>
          ))}
        </div>
      </section>

      <section class="experiences-direct" data-dock-section>
        <div>
          <div class="experiences-kicker">{t(lang, "Direct planning", "Planificación directa")}</div>
          <h2>
            {t(
              lang,
              "Ask the hotel to shape the right moment around your stay.",
              "Pida al hotel que adapte el momento adecuado a su estancia."
            )}
          </h2>
        </div>

        <div>
          <p>
            {t(
              lang,
              "Experiences work best when they match your arrival time, room choice, city route and the kind of Barcelona day you want.",
              "Las experiencias funcionan mejor cuando encajan con su hora de llegada, habitación, ruta urbana y el tipo de día en Barcelona que desea."
            )}
          </p>

          <div class="experiences-direct__actions">
            {bookingUrl ? (
              <a href={bookingUrl} target="_blank" rel="noreferrer">{bookDirectLabel}</a>
            ) : null}
            <a href={`/${lang}/contact/`}>{contactHotelLabel}</a>
          </div>
        </div>
      </section>

      <script is:inline define:vars={{ experiencePayload: experienceItems }}>
        (() => {
          const root = document.querySelector("[data-experience-index-field]");
          if (!root || !Array.isArray(experiencePayload) || experiencePayload.length === 0) return;

          const stage = root.querySelector("[data-experience-stage]");
          const activeImage = root.querySelector("[data-experience-active-image]");
          const activeCount = root.querySelector("[data-experience-active-count]");
          const activeCategory = root.querySelector("[data-experience-active-category]");
          const activeTitle = root.querySelector("[data-experience-active-title]");
          const activeDescription = root.querySelector("[data-experience-active-description]");
          const panelTitle = root.querySelector("[data-experience-panel-title]");
          const panelDescription = root.querySelector("[data-experience-panel-description]");
          const experienceMood = root.querySelector("[data-experience-mood]");
          const experienceBestFor = root.querySelector("[data-experience-best-for]");
          const experienceTiming = root.querySelector("[data-experience-timing]");
          const experienceWhyChoose = root.querySelector("[data-experience-why-choose]");
          const experienceCategory = root.querySelector("[data-experience-category]");
          const openLink = root.querySelector("[data-experience-open-link]");
          const bookingLink = root.querySelector("[data-experience-booking-link]");
          const prevBtn = root.querySelector("[data-experience-prev]");
          const nextBtn = root.querySelector("[data-experience-next]");
          const thumbs = Array.from(root.querySelectorAll("[data-experience-thumb]"));

          let activeIndex = 0;
          let switchTimer = 0;
          let wheelCooldown = 0;

          const pad = (n) => String(n).padStart(2, "0");
          const normalize = (index) => ((index % experiencePayload.length) + experiencePayload.length) % experiencePayload.length;

          const render = (nextIndex, direction = 1) => {
            activeIndex = normalize(nextIndex);
            const experience = experiencePayload[activeIndex];

            root.dataset.direction = direction >= 0 ? "1" : "-1";

            if (activeImage) {
              activeImage.src = experience.image;
              activeImage.alt = experience.title || "";
            }

            if (activeCount) activeCount.textContent = `${pad(activeIndex + 1)} / ${pad(experiencePayload.length)}`;
            if (activeCategory) activeCategory.textContent = experience.category || "";
            if (activeTitle) activeTitle.textContent = experience.title || "";
            if (activeDescription) activeDescription.textContent = experience.description || "";
            if (panelTitle) panelTitle.textContent = experience.title || "";
            if (panelDescription) panelDescription.textContent = experience.description || "";
            if (experienceMood) experienceMood.textContent = experience.mood || "—";
            if (experienceBestFor) experienceBestFor.textContent = experience.bestFor || "—";
            if (experienceTiming) experienceTiming.textContent = experience.timing || "—";
            if (experienceWhyChoose) experienceWhyChoose.textContent = experience.whyChoose || "—";
            if (experienceCategory) experienceCategory.textContent = experience.category || "—";
            if (openLink) openLink.setAttribute("href", experience.href);

            if (bookingLink) {
              bookingLink.setAttribute("data-booking-context", "experience");
              bookingLink.setAttribute("data-booking-slug", experience.slug || "");
              bookingLink.setAttribute("data-booking-title", experience.title || "");
            }

            thumbs.forEach((button, index) => {
              const active = index === activeIndex;
              button.classList.toggle("is-active", active);
              if (active) button.setAttribute("aria-current", "true");
              else button.removeAttribute("aria-current");
            });

            root.classList.remove("is-switching");
            window.clearTimeout(switchTimer);
            void root.offsetWidth;
            root.classList.add("is-switching");
            switchTimer = window.setTimeout(() => root.classList.remove("is-switching"), 780);
          };

          thumbs.forEach((button) => {
            button.addEventListener("click", () => {
              const index = Number(button.getAttribute("data-experience-thumb"));
              if (Number.isFinite(index)) render(index, index > activeIndex ? 1 : -1);
            });
          });

          if (prevBtn) prevBtn.addEventListener("click", () => render(activeIndex - 1, -1));
          if (nextBtn) nextBtn.addEventListener("click", () => render(activeIndex + 1, 1));

          if (stage) {
            stage.addEventListener("keydown", (event) => {
              if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
                event.preventDefault();
                render(activeIndex - 1, -1);
              }

              if (event.key === "ArrowRight" || event.key === "ArrowDown") {
                event.preventDefault();
                render(activeIndex + 1, 1);
              }

              if (event.key === "Enter" && openLink instanceof HTMLAnchorElement) {
                event.preventDefault();
                openLink.click();
              }
            });

            stage.addEventListener(
              "wheel",
              (event) => {
                if (window.matchMedia("(max-width: 760px)").matches) return;
                if (Math.abs(event.deltaY) < 16) return;

                event.preventDefault();

                const now = window.performance.now();
                if (now - wheelCooldown < 720) return;
                wheelCooldown = now;

                const direction = event.deltaY > 0 ? 1 : -1;
                render(activeIndex + direction, direction);
              },
              { passive: false }
            );
          }

          render(0, 1);
        })();
      </script>
    </>
  ) : (
    <section class="experiences-empty">
      <div class="experiences-kicker">{t(lang, "Experiences", "Experiencias")}</div>
      <h1>{emptyTitle}</h1>
      <p>{emptyText}</p>
    </section>
  )}

  <style>
    .experiences-hero {
      position: relative;
      min-height: 100svh;
      margin-top: -5.2rem;
      overflow: hidden;
      background: #15120f;
      color: #fffaf2;
    }

    .experiences-hero__image {
      position: absolute;
      inset: 0;
      height: 100%;
