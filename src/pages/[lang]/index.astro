      font-size: 2.6rem;
      line-height: 0.92;
      letter-spacing: 0;
    }

    .hotel-stay-object-field__panel > div > p {
      margin-top: 1.2rem;
      max-width: 28rem;
      font-size: 0.96rem;
      line-height: 1.76;
      color: rgba(21, 18, 15, 0.64);
    }

    .hotel-stay-object-field__active {
      align-self: end;
      border-top: 1px solid rgba(21, 18, 15, 0.12);
      padding-top: 1.2rem;
    }

    .hotel-stay-object-field__count,
    .hotel-stay-object-field__label {
      font-size: 0.62rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.42);
    }

    .hotel-stay-object-field__label {
      margin-top: 1.4rem;
    }

    .hotel-stay-object-field__active h4 {
