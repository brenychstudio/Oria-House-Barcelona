        let bestIndex = 0;
        let bestDistance = Infinity;

        sections.forEach((section, index) => {
          const rect = section.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const distance = Math.abs(center - focusY);

          const isVisible =
            rect.bottom > window.innerHeight * 0.18 &&
            rect.top < window.innerHeight * 0.82;

          if (isVisible && distance < bestDistance) {
            bestDistance = distance;
            bestIndex = index;
          }
        });

        return bestIndex;
      };

      const contextForSection = (section) => {
        if (!section) return "section";
        if (section.id === "stay-field") return "stay";
        if (section.id === "home-gallery") return "gallery";
        if (section.id === "home-hero") return "hero";
        if (section.id === "home-closing") return "closing";
        return "section";
      };

      const applyDisabledStates = () => {
        const first = activeIndex <= 0;
        const last = activeIndex >= sections.length - 1;

        if (upBtn) upBtn.disabled = first;
        if (downBtn) downBtn.disabled = last;

        /*
          R1 rule:
          Left / right are page navigation.
          They stay enabled and wrap through site pages:
          Home -> Rooms -> Offers -> Experiences -> Gallery -> Location -> Contact.
        */
        if (leftBtn) leftBtn.disabled = false;
        if (rightBtn) rightBtn.disabled = false;
      };

      const updateDock = () => {
        activeIndex = getActiveIndex();

        const section = sections[activeIndex];
        const context = contextForSection(section);

        dock.setAttribute("data-context", context);

        applyDisabledStates();
      };

      const requestDockUpdate = () => {
        wakeDock();

        if (ticking) return;

        ticking = true;

        requestAnimationFrame(() => {
          ticking = false;
          updateDock();
        });
      };

      const scrollToSection = (index) => {
        const nextIndex = clamp(index, 0, sections.length - 1);
        const section = sections[nextIndex];

        if (!section) return;

        wakeDock();

        section.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      };

      if (upBtn) {
        upBtn.addEventListener("click", () => {
          updateDock();
          scrollToSection(activeIndex - 1);
        });
      }

      if (downBtn) {
        downBtn.addEventListener("click", () => {
          updateDock();
          scrollToSection(activeIndex + 1);
        });
      }

      if (leftBtn) {
        leftBtn.addEventListener("click", () => {
          wakeDock();
          goPage(-1);
        });
      }

      if (rightBtn) {
        rightBtn.addEventListener("click", () => {
          wakeDock();
          goPage(1);
        });
      }

      dock.addEventListener("pointerdown", wakeDock);
      dock.addEventListener("focusin", wakeDock);

      window.addEventListener("scroll", requestDockUpdate, { passive: true });
      window.addEventListener("resize", requestDockUpdate);

      updateDock();
      wakeDock();
    })();
  </script>
</BaseLayout>
