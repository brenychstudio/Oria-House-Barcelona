    /* Stage 2I - Stay Path Object Field Rebuild */

    .hotel-stay-object-field {
      --stay-pointer-x: 0px;
      --stay-pointer-y: 0px;
      --stay-field-presence: 0;

      margin-top: clamp(2.5rem, 6vw, 5rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.38fr);
      gap: clamp(1.2rem, 4vw, 4rem);
      align-items: stretch;
    }

    .hotel-stay-object-field__stage {
      position: relative;
      min-height: clamp(38rem, 58vw, 56rem);
      min-width: 0;
      outline: none;
      perspective: 1200px;
      isolation: isolate;
    }

    .hotel-stay-object {
      position: absolute;
      display: block;
      overflow: hidden;
      border: 1px solid rgba(21, 18, 15, 0.1);
      background: #15120f;
      color: #fffaf2;
      text-decoration: none;
      box-shadow: 0 34px 100px rgba(21, 18, 15, 0.1);
      transition:
        opacity 720ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 720ms cubic-bezier(0.16, 1, 0.3, 1),
        width 720ms cubic-bezier(0.16, 1, 0.3, 1),
        height 720ms cubic-bezier(0.16, 1, 0.3, 1),
        left 720ms cubic-bezier(0.16, 1, 0.3, 1),
        right 720ms cubic-bezier(0.16, 1, 0.3, 1),
        top 720ms cubic-bezier(0.16, 1, 0.3, 1),
        bottom 720ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 720ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hotel-stay-object img {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      filter: brightness(1.08) contrast(1.045) saturate(1.02);
      transform: scale(1.02);
      transition:
        transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hotel-stay-object__shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(115deg, rgba(255, 245, 220, 0.18), transparent 38%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.2) 48%, rgba(0, 0, 0, 0.78));
      pointer-events: none;
    }

    .hotel-stay-object__readout {
      position: absolute;
      left: clamp(1rem, 2.5vw, 2rem);
      right: clamp(1rem, 2.5vw, 2rem);
      bottom: clamp(1rem, 2.5vw, 2rem);
      z-index: 2;
      border-top: 1px solid rgba(255, 250, 242, 0.24);
      padding-top: 1rem;
    }

    .hotel-stay-object__readout small,
    .hotel-stay-object__readout span {
      display: block;
      font-size: 0.62rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 250, 242, 0.48);
    }

    .hotel-stay-object__readout span {
      margin-top: 1.2rem;
    }

    .hotel-stay-object__readout strong {
      margin-top: 0.72rem;
      display: block;
      max-width: 10ch;
      font-size: 2.8rem;
      line-height: 0.9;
      letter-spacing: 0;
      font-weight: 400;
      text-shadow: 0 18px 80px rgba(0, 0, 0, 0.34);
    }

    .hotel-stay-object.is-active {
      left: 0;
      top: 5%;
      z-index: 4;
      width: 72%;
      height: 72%;
      opacity: 1;
      transform:
        translate3d(var(--stay-pointer-x), var(--stay-pointer-y), 0)
        scale(calc(1 + (var(--stay-field-presence) * 0.012)));
      box-shadow: 0 42px 130px rgba(21, 18, 15, 0.16);
    }

    .hotel-stay-object.is-active:hover img {
      transform: scale(1.045);
      filter: brightness(1.13) contrast(1.055) saturate(1.04);
    }

    .hotel-stay-object.is-next {
      right: 0;
      top: 14%;
      z-index: 3;
      width: 42%;
      height: 48%;
      opacity: 0.86;
      transform:
        translate3d(
          calc(var(--stay-pointer-x) * -0.42),
          calc(var(--stay-pointer-y) * 0.42),
          0
        )
        scale(0.985);
    }

    .hotel-stay-object.is-prev {
      left: 12%;
      bottom: 2%;
      z-index: 2;
      width: 50%;
      height: 36%;
      opacity: 0.68;
      transform:
        translate3d(
          calc(var(--stay-pointer-x) * 0.32),
          calc(var(--stay-pointer-y) * -0.28),
          0
        )
        scale(0.96);
    }

    .hotel-stay-object.is-quiet {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.92);
    }

    .hotel-stay-object.is-next .hotel-stay-object__readout strong,
    .hotel-stay-object.is-prev .hotel-stay-object__readout strong {
      font-size: 2rem;
    }

    .hotel-stay-object-field__panel {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: clamp(1.4rem, 4vw, 3rem);
      border-top: 1px solid rgba(21, 18, 15, 0.14);
      padding-top: 1rem;
