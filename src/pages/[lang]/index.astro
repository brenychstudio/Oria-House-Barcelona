    /* Stage 2D - Living Stay Paths Scroll Flow Lite */

    .hotel-living-path {
      --path-media-x: 0px;
      --path-media-y: 0px;
      --path-media-scale: 1.02;
      --path-media-rotate: 0deg;
      --path-copy-y: 0px;
      --path-shadow-y: 22px;
      --path-shadow-blur: 64px;
      --path-shadow-alpha: 0.08;
      --path-focus: 0;

      box-shadow: 0 var(--path-shadow-y) var(--path-shadow-blur)
        rgba(21, 18, 15, var(--path-shadow-alpha));
    }

    .hotel-living-path__media {
      inset: -2.5%;
      transform:
        translate3d(var(--path-media-x), var(--path-media-y), 0)
        rotate(var(--path-media-rotate))
        scale(var(--path-media-scale));
      transform-origin: center;
      will-change: transform;
    }

    .hotel-living-path__media img {
      transform: scale(1.02);
      transform-origin: center;
    }

    .hotel-living-path__copy {
      transform: translate3d(0, var(--path-copy-y), 0);
      will-change: transform;
    }

    .hotel-living-path::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: calc(0.16 + (var(--path-focus) * 0.22));
      background:
        linear-gradient(115deg, rgba(255, 245, 220, 0.14), transparent 42%),
        linear-gradient(180deg, transparent 38%, rgba(0, 0, 0, 0.18));
      transition: opacity 320ms ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .hotel-living-path,
      .hotel-living-path__media,
      .hotel-living-path__copy,
      .hotel-living-path__media img {
        transform: none !important;
        box-shadow: 0 22px 64px rgba(21, 18, 15, 0.08);
      }
    }

