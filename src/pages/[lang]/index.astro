---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getExperiences, getOffers, getReviews, getRooms, getSettings } from "../../cms/sheets";
import { pickLang } from "../../cms/types";
import {
  EXPERIENCE_COVER_BY_SLUG,
  GALLERY_ARCHIVE_IMAGES,
  HOTEL_DEMO_ASSETS,
  OFFER_COVER_BY_SLUG,
  ROOM_COVER_BY_SLUG,
} from "../../hotel/data/demoAssets";
import { getSeoCopy } from "../../hotel/seo/siteSeo";
import CinematicGalleryPreview from "../../hotel/ui/CinematicGalleryPreview.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;
const seo = getSeoCopy("home", lang);

const s = await getSettings();

const rooms = (await getRooms()).filter((room) =>
  Boolean(ROOM_COVER_BY_SLUG[room.slug] ?? (room.cover_image ?? "").trim())
);
const offers = (await getOffers()).filter((offer) =>
  Boolean(OFFER_COVER_BY_SLUG[offer.slug] ?? (offer.cover_image ?? "").trim())
);
const experiences = (await getExperiences()).filter((experience) =>
  Boolean(EXPERIENCE_COVER_BY_SLUG[experience.slug] ?? (experience.cover_image ?? "").trim())
);
const reviews = (await getReviews()).slice(0, 2);

const siteName = t(lang, s.hotel_name_en, s.hotel_name_es);
const title = `${siteName} - ${t(
  lang,
  "Boutique hotel in Barcelona",
  "Hotel boutique en Barcelona"
)}`;

const compact = (value: unknown) => String(value ?? "").trim();

const bookingUrl = compact((s as any).booking_url);

const heroFrame = HOTEL_DEMO_ASSETS.homeHero;

const featuredRoom = rooms[0];
const secondaryRoom = rooms[1];
const featuredOffer = offers[0];
const featuredExperience = experiences[0];
const secondaryExperience = experiences[1];

const heroEyebrow = t(lang, "Barcelona / Boutique stay", "Barcelona / Estancia boutique");
const heroTitleLineA = t(lang, "Stay inside", "Entre en");
const heroTitleLineB = t(
  lang,
  "Barcelona's quieter rhythm.",
  "el ritmo más tranquilo de Barcelona."
);
const heroTitle = `${heroTitleLineA} ${heroTitleLineB}`;

const heroText = t(
  lang,
  "Wake into soft rooms, quiet materials, terrace hours and a direct path to the stay before the city gets loud.",
  "Despiértese entre habitaciones suaves, materiales tranquilos, horas de terraza y una ruta directa hacia la estancia antes de que la ciudad despierte."
);

const heroMicroNote = t(
  lang,
  "A calm Barcelona base",
  "Una base tranquila en Barcelona"
);

const heroSceneA = t(lang, "Morning light", "Luz de mañana");
const heroSceneB = t(lang, "Private return", "Regreso privado");

const heroScrollCue = t(lang, "Scroll to enter", "Scroll para entrar");

const bookLabel = t(lang, "Book direct", "Reservar directo");
const exploreLabel = t(lang, "Explore the stay", "Explorar la estancia");
const roomsLabel = t(lang, "Rooms", "Habitaciones");
const offersLabel = t(lang, "Offers", "Ofertas");
const experiencesLabel = t(lang, "Experiences", "Experiencias");
const galleryLabel = t(lang, "Gallery", "Galería");

const roomsHref = `/${lang}/rooms/`;
const offersHref = `/${lang}/offers/`;
const experiencesHref = `/${lang}/experiences/`;
const galleryHref = `/${lang}/gallery/`;
const contactHref = `/${lang}/contact/`;

/**
 * R2 rule:
 * For the Home prototype we use stable demo media fallbacks.
 * This protects Home from broken visual blocks while Sheets/assets are still settling.
 */
const roomPathImage =
  (featuredRoom ? ROOM_COVER_BY_SLUG[featuredRoom.slug] : "") ||
  compact(featuredRoom?.cover_image) ||
  HOTEL_DEMO_ASSETS.roomStudioCourtyard;
const offerPathImage =
  (featuredOffer ? OFFER_COVER_BY_SLUG[featuredOffer.slug] : "") ||
  compact(featuredOffer?.cover_image) ||
  HOTEL_DEMO_ASSETS.offerStay3Pay2;
const experiencePathImage =
  (featuredExperience ? EXPERIENCE_COVER_BY_SLUG[featuredExperience.slug] : "") ||
  compact(featuredExperience?.cover_image) ||
  HOTEL_DEMO_ASSETS.experienceRooftopSunset;

const archiveHero = GALLERY_ARCHIVE_IMAGES[0] ?? HOTEL_DEMO_ASSETS.galleryCourtyardArrival;

const homeArchiveItems = [
  {
    id: "courtyard-arrival",
    title: t(lang, "Courtyard arrival", "Llegada al patio"),
    section: t(lang, "Courtyard", "Patio"),
    mood: t(lang, "Quiet arrival", "Llegada tranquila"),
    signal: t(lang, "stone / water / olive light", "piedra / agua / luz de olivo"),
    src: GALLERY_ARCHIVE_IMAGES[0] ?? archiveHero,
    alt: t(lang, "Quiet hotel courtyard with pool and olive tree.", "Patio tranquilo del hotel con piscina y olivo."),
  },
  {
    id: "staircase-light",
    title: t(lang, "Staircase light", "Luz de escalera"),
    section: t(lang, "Architecture", "Arquitectura"),
    mood: t(lang, "Soft vertical movement", "Movimiento vertical suave"),
    signal: t(lang, "curve / plaster / silence", "curva / estuco / silencio"),
    src: GALLERY_ARCHIVE_IMAGES[1] ?? HOTEL_DEMO_ASSETS.galleryArchitectureStaircase,
    alt: t(lang, "Warm sculptural staircase in a boutique hotel.", "Escalera escultórica cálida en un hotel boutique."),
  },
  {
    id: "dining-evening",
    title: t(lang, "Dining evening", "Cena de noche"),
    section: t(lang, "Dining", "Gastronomía"),
    mood: t(lang, "Warm evening", "Noche cálida"),
    signal: t(lang, "table / glow / return", "mesa / brillo / regreso"),
    src: GALLERY_ARCHIVE_IMAGES[2] ?? HOTEL_DEMO_ASSETS.galleryDiningEvening,
    alt: t(lang, "Warm dining corner with table and soft light.", "Rincón de comedor cálido con mesa y luz suave."),
  },
  {
    id: "water-reflection",
    title: t(lang, "Water reflection", "Reflejo de agua"),
    section: t(lang, "Pool", "Piscina"),
    mood: t(lang, "Still afternoon", "Tarde quieta"),
    signal: t(lang, "reflection / shade / pause", "reflejo / sombra / pausa"),
    src: GALLERY_ARCHIVE_IMAGES[3] ?? HOTEL_DEMO_ASSETS.galleryPoolReflection,
    alt: t(lang, "Pool reflection and courtyard texture.", "Reflejo de piscina y textura del patio."),
  },
  {
    id: "room-calm",
    title: t(lang, "Room calm", "Calma de habitación"),
    section: t(lang, "Room", "Habitación"),
    mood: t(lang, "Morning room", "Habitación de mañana"),
    signal: t(lang, "linen / wood / soft light", "lino / madera / luz suave"),
    src: GALLERY_ARCHIVE_IMAGES[7] ?? roomPathImage,
    alt: t(lang, "Quiet room with bed, wood and soft morning light.", "Habitación tranquila con cama, madera y luz suave de mañana."),
  },
].filter((item) => Boolean(item.src));

const stayStatement = t(
  lang,
  "Not a hotel catalogue. A staged way to understand the stay before arrival.",
  "No es un catálogo de hotel. Es una forma escenificada de entender la estancia antes de llegar."
);

const stayText = t(
  lang,
  "Rooms, offers, experiences and location are treated as connected states of one stay: morning light, city routes, terrace hours and the private return.",
  "Habitaciones, ofertas, experiencias y ubicación se presentan como estados conectados de una misma estancia: luz de mañana, rutas urbanas, horas de terraza y regreso privado."
);

const roomTitle = featuredRoom ? pickLang(lang, featuredRoom, "name") : roomsLabel;
const roomText = featuredRoom
  ? pickLang(lang, featuredRoom, "short")
  : t(lang, "Quiet rooms shaped by light and material.", "Habitaciones tranquilas definidas por luz y material.");

const offerTitle = featuredOffer ? pickLang(lang, featuredOffer, "title") : offersLabel;
const offerText = featuredOffer
  ? pickLang(lang, featuredOffer, "period")
  : t(lang, "Seasonal packages for a slower stay.", "Paquetes de temporada para una estancia más pausada.");

const experienceTitle = featuredExperience ? pickLang(lang, featuredExperience, "title") : experiencesLabel;
const experienceText = featuredExperience
  ? pickLang(lang, featuredExperience, "description")
  : t(lang, "Rituals, views and local moments beyond the room.", "Rituales, vistas y momentos locales más allá de la habitación.");

type StayPath = {
  id: string;
  label: string;
  title: string;
  text: string;
  href: string;
  image: string;
};

const stayPaths: StayPath[] = [
  featuredRoom
    ? {
        id: "room",
        label: roomsLabel,
        title: roomTitle,
        text: roomText,
        href: `/${lang}/rooms/${featuredRoom.slug}/`,
        image: roomPathImage,
      }
    : null,
  featuredOffer
    ? {
        id: "offer",
        label: offersLabel,
        title: offerTitle,
        text: offerText,
        href: `/${lang}/offers/${featuredOffer.slug}/`,
        image: offerPathImage,
      }
    : null,
  featuredExperience
    ? {
        id: "experience",
        label: experiencesLabel,
        title: experienceTitle,
        text: experienceText,
        href: `/${lang}/experiences/${featuredExperience.slug}/`,
        image: experiencePathImage,
      }
    : null,
].filter((item): item is StayPath => Boolean(item && item.image));

const initialStayPath = stayPaths[0];
const stayPathCount = stayPaths.length;

const stayObjectEyebrow = t(
  lang,
  "Stay path selector",
  "Selector de estancia"
);

const stayObjectTitle = t(
  lang,
  "Choose the rhythm before choosing the room.",
  "Elija el ritmo antes de elegir la habitación."
);

const stayObjectText = t(
  lang,
  "Move between room, package and experience as connected states of the same stay.",
  "Muévase entre habitación, paquete y experiencia como estados conectados de la misma estancia."
);

const openStayPathLabel = t(lang, "Open path", "Abrir recorrido");
const previousStayLabel = t(lang, "Previous path", "Recorrido anterior");
const nextStayLabel = t(lang, "Next path", "Siguiente recorrido");

const dockAriaLabel = t(lang, "Home stay navigation", "Navegación de estancia");
const dockPrevSectionLabel = t(lang, "Previous section", "Sección anterior");
const dockNextSectionLabel = t(lang, "Next section", "Siguiente sección");
const dockPrevPageLabel = t(lang, "Previous page", "Página anterior");
const dockNextPageLabel = t(lang, "Next page", "Página siguiente");

const dockHeroTitle = t(lang, "Arrival", "Llegada");
const dockStayTitle = t(lang, "Stay paths", "Recorridos");
const dockGalleryTitle = t(lang, "Gallery field", "Campo galería");
const dockClosingTitle = t(lang, "Direct stay", "Estancia directa");

const dockSectionMode = t(lang, "Section", "Sección");
const dockStayMode = t(lang, "Stay selector", "Selector de estancia");
const dockGalleryMode = t(lang, "Gallery frames", "Frames de galería");

const archiveTitle = t(
  lang,
  "A visual field of rooms, rituals and quiet returns.",
  "Un campo visual de habitaciones, rituales y regresos tranquilos."
);

const archiveText = t(
  lang,
  "The gallery is treated as a cinematic memory of the hotel, not a static grid.",
  "La galería se trata como una memoria cinematográfica del hotel, no como una cuadrícula estática."
);

const closingEyebrow = t(lang, "Before arrival", "Antes de llegar");

const closingTitle = t(
  lang,
  "Let the hotel shape the stay before you arrive.",
  "Deje que el hotel dé forma a la estancia antes de llegar."
);

const closingText = t(
  lang,
  "Use direct booking for the clearest route, or contact the team for room advice, arrival details and a more personal Barcelona stay.",
  "Use la reserva directa para la ruta más clara, o contacte con el equipo para asesoramiento de habitación, detalles de llegada y una estancia más personal en Barcelona."
);

const closingImage = HOTEL_DEMO_ASSETS.galleryDiningEvening || archiveHero || heroFrame;

const guestSignalTitle = t(
  lang,
  "Quiet proof from slower stays.",
  "Prueba tranquila de estancias más pausadas."
);

const guestSignalText = t(
  lang,
  "Short notes are treated as atmosphere, not marketing noise.",
  "Las notas breves se tratan como atmósfera, no como ruido de marketing."
);
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={heroFrame}
  canonicalPath={`/${lang}/`}
  fullBleed
>
  <section
    id="home-hero"
    class="hotel-home-stage"
    aria-label={heroTitle}
    data-home-section
    data-header-scene="home-hero"
    data-dock-title={dockHeroTitle}
    data-dock-mode={dockSectionMode}
  >
    <img
      src={heroFrame}
      alt=""
      class="hotel-home-stage__image"
      loading="eager"
      decoding="async"
    />

    <div class="hotel-home-stage__veil"></div>
    <div class="hotel-home-stage__grain" aria-hidden="true"></div>

    <div class="hotel-home-stage__inner">
      <div class="hotel-home-stage__top hc-home-rise">
        <div class="hotel-home-kicker">{heroEyebrow}</div>

        <div class="hotel-home-presence" aria-hidden="true">
          <span>{heroSceneA}</span>
          <span>{heroSceneB}</span>
        </div>
      </div>

      <div class="hotel-home-stage__content">
        <div class="hotel-home-stage__copy hc-home-rise hc-home-rise--delay-1">
          <p class="hotel-home-small">
            {t(lang, "Oria House Barcelona", "Oria House Barcelona")}
          </p>

          <h1 class="hotel-home-display" aria-label={heroTitle}>
            <span>{heroTitleLineA}</span>
            <span>{heroTitleLineB}</span>
          </h1>
        </div>

        <aside class="hotel-home-stage__panel hc-home-rise hc-home-rise--delay-2">
          <div class="hotel-home-stage__panel-label">{heroMicroNote}</div>
          <p>{heroText}</p>

          <div class="mt-6 flex flex-wrap gap-3">
            {bookingUrl ? (
              <a
                href={bookingUrl}
                target="_blank"
                rel="noreferrer"
                class="hotel-home-button hotel-home-button--light"
              >
                {bookLabel}
              </a>
            ) : null}

            <a href="#stay-field" class="hotel-home-button hotel-home-button--ghost">
              {exploreLabel}
            </a>
          </div>
        </aside>
      </div>

      <a
        href="#stay-field"
        class="hotel-home-scroll-cue hc-home-rise hc-home-rise--delay-3"
        aria-label={heroScrollCue}
      >
        <span>{heroScrollCue}</span>
        <i aria-hidden="true"></i>
      </a>

      <div class="hotel-home-stage__bottom hc-home-rise hc-home-rise--delay-3">
        <a href={roomsHref} class="hotel-home-route">
          <span>{roomsLabel}</span>
          <span>{rooms.length}</span>
        </a>

        <a href={offersHref} class="hotel-home-route">
          <span>{offersLabel}</span>
          <span>{offers.length}</span>
        </a>

        <a href={experiencesHref} class="hotel-home-route">
          <span>{experiencesLabel}</span>
          <span>{experiences.length}</span>
        </a>
      </div>
    </div>
  </section>

  <section
    id="stay-field"
    class="hotel-living-section"
    data-living-stay-field
    data-home-section
    data-header-scene="home-stay"
    data-dock-title={dockStayTitle}
    data-dock-mode={dockStayMode}
  >
    <div class="hotel-section-label">
      {t(lang, "Living stay field", "Campo vivo de estancia")}
    </div>

    <div class="hotel-living-intro">
      <h2 class="hotel-living-intro__title" aria-label={stayStatement}>
        <span>{t(lang, "Not a hotel catalogue.", "No es un catálogo de hotel.")}</span>
        <span>{t(lang, "A staged way to understand the stay before arrival.", "Una forma escenificada de entender la estancia antes de llegar.")}</span>
      </h2>

      <div class="hotel-living-intro__side">
        <p>{stayText}</p>

        <div class="hotel-living-intro__signal" aria-hidden="true">
          <span>{roomsLabel}</span>
          <span>{offersLabel}</span>
          <span>{experiencesLabel}</span>
        </div>
      </div>
    </div>

    {initialStayPath ? (
      <div class="hotel-stay-object-field" data-stay-object-field>
        <div
          class="hotel-stay-object-field__stage"
          data-stay-object-stage
          tabindex="0"
          role="group"
          aria-label={stayObjectTitle}
        >
          {stayPaths.map((path, index) => (
            <a
              href={path.href}
              class:list={[
                "hotel-stay-object",
                `hotel-stay-object--${index + 1}`,
                index === 0 && "is-active",
                index === 1 && "is-next",
                index === 2 && "is-prev",
                index > 2 && "is-quiet",
              ]}
              data-stay-object
              data-stay-index={index}
              data-stay-label={path.label}
              data-stay-title={path.title}
              data-stay-text={path.text}
              data-stay-href={path.href}
            >
              <img src={path.image} alt="" loading="lazy" decoding="async" />

              <div class="hotel-stay-object__shade" aria-hidden="true"></div>

              <div class="hotel-stay-object__readout">
                <small>{String(index + 1).padStart(2, "0")}</small>
                <span>{path.label}</span>
                <strong>{path.title}</strong>
              </div>
            </a>
          ))}
        </div>

        <aside class="hotel-stay-object-field__panel">
          <div>
            <div class="hotel-section-label">{stayObjectEyebrow}</div>
            <h3>{stayObjectTitle}</h3>
            <p>{stayObjectText}</p>
          </div>

          <div class="hotel-stay-object-field__active">
            <div class="hotel-stay-object-field__count" data-stay-active-count>
              {`01 / ${String(stayPathCount).padStart(2, "0")}`}
            </div>

            <div class="hotel-stay-object-field__label" data-stay-active-label>
              {initialStayPath.label}
            </div>

            <h4 data-stay-active-title>{initialStayPath.title}</h4>
            <p data-stay-active-text>{initialStayPath.text}</p>

            <div class="hotel-stay-object-field__actions">
              <a href={initialStayPath.href} data-stay-active-link>
                {openStayPathLabel}
              </a>

              <div class="hotel-stay-object-field__nav">
                <button type="button" data-stay-prev aria-label={previousStayLabel}>←</button>
                <button type="button" data-stay-next aria-label={nextStayLabel}>→</button>
              </div>
            </div>
          </div>
        </aside>
      </div>
    ) : null}
  </section>

  <div
    id="home-gallery"
    data-home-section
    data-header-scene="home-gallery"
    data-dock-title={dockGalleryTitle}
    data-dock-mode={dockGalleryMode}
  >
    <CinematicGalleryPreview
      id={`home-gallery-preview-${lang}`}
      eyebrow={t(lang, "Cinematic memory", "Memoria cinematografica")}
      title={archiveTitle}
      intro={archiveText}
      href={galleryHref}
      hrefLabel={t(lang, "Open full gallery", "Abrir galeria completa")}
      secondaryHref={experiencesHref}
      secondaryLabel={t(lang, "View experiences", "Ver experiencias")}
      items={homeArchiveItems}
    />
  </div>

  <section
    id="home-closing"
    class="hotel-closing-section"
    data-home-section
    data-header-scene="home-closing"
    data-dock-title={dockClosingTitle}
    data-dock-mode={dockSectionMode}
  >
    <div class="hotel-closing__visual" aria-hidden="true">
      <img src={closingImage} alt="" loading="lazy" decoding="async" />
      <div class="hotel-closing__visual-readout">
        <span>{t(lang, "Final frame", "Frame final")}</span>
        <strong>{t(lang, "Direct stay", "Estancia directa")}</strong>
      </div>
    </div>

    <div class="hotel-closing__content">
      <div class="hotel-closing__main">
        <div class="hotel-section-label">{closingEyebrow}</div>

        <h2>{closingTitle}</h2>

        <p>{closingText}</p>

        <div class="hotel-closing__actions">
          {bookingUrl ? (
            <a
              href={bookingUrl}
              target="_blank"
              rel="noreferrer"
              class="hotel-home-button hotel-home-button--black"
            >
              {bookLabel}
            </a>
          ) : null}

          <a href={contactHref} class="hotel-home-button hotel-home-button--outline">
            {t(lang, "Contact hotel", "Contactar hotel")}
          </a>
        </div>
      </div>

      {reviews.length ? (
        <aside class="hotel-closing__notes">
          <div>
            <div class="hotel-section-label">
              {t(lang, "Guest signal", "Señal de huéspedes")}
            </div>

            <h3>{guestSignalTitle}</h3>
            <p>{guestSignalText}</p>
          </div>

          <div class="hotel-closing__note-list">
            {reviews.map((r, index) => (
              <article>
                <small>{String(index + 1).padStart(2, "0")}</small>
                <p>&ldquo;{pickLang(lang, r, "quote")}&rdquo;</p>
                <span>- {pickLang(lang, r, "author")}</span>
              </article>
            ))}
          </div>
        </aside>
      ) : null}
  </div>
</section>

<nav class="hotel-stay-dock hotel-stay-dock--compact" data-home-stay-dock aria-label={dockAriaLabel}>
  <button type="button" class="hotel-stay-dock__button" data-dock-left aria-label={dockPrevPageLabel}>
    ←
  </button>

  <button type="button" class="hotel-stay-dock__button" data-dock-up aria-label={dockPrevSectionLabel}>
    ↑
  </button>

  <button type="button" class="hotel-stay-dock__button" data-dock-down aria-label={dockNextSectionLabel}>
    ↓
  </button>

  <button type="button" class="hotel-stay-dock__button" data-dock-right aria-label={dockNextPageLabel}>
    →
  </button>
</nav>

  <style>
    .hotel-home-stage {
      position: relative;
      width: 100%;
      min-height: 100svh;
      margin-top: -5.2rem;
      overflow: hidden;
      background: #080705;
      color: #fffaf2;
    }

    .hotel-home-stage__image {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      object-position: center center;
      transform: scale(1.012);
      filter: saturate(1.01) contrast(1.05) brightness(1.1);
    }

    .hotel-home-stage__veil {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(5, 5, 4, 0.56), rgba(5, 5, 4, 0.1) 48%, rgba(5, 5, 4, 0.5)),
        linear-gradient(180deg, rgba(5, 5, 4, 0.16), rgba(5, 5, 4, 0.08) 42%, rgba(5, 5, 4, 0.72));
    }

    .hotel-home-stage__grain {
      position: absolute;
      inset: 0;
      opacity: 0.1;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.016) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: linear-gradient(to bottom, transparent, black 20%, black 88%, transparent);
    }

    .hotel-home-stage__inner {
      position: relative;
      z-index: 2;
      display: flex;
      min-height: 100svh;
      width: min(100% - clamp(1.25rem, 4vw, 4rem), 1680px);
      margin-inline: auto;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(7.8rem, 13vh, 10.5rem) 0 clamp(1.4rem, 4vh, 2.8rem);
    }

    .hotel-home-stage__top,
    .hotel-home-stage__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .hotel-home-kicker,
    .hotel-home-presence {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      max-width: min(100%, 36rem);
      border: 1px solid rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
      padding: 0.62rem 0.86rem;
      border-radius: 999px;
      backdrop-filter: blur(18px);
      font-size: 0.64rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.72);
      white-space: nowrap;
    }

    .hotel-home-presence span:not(:last-child)::after {
      content: "/";
      margin-left: 0.55rem;
      opacity: 0.35;
    }

    .hotel-home-stage__content {
      display: grid;
      grid-template-columns: minmax(0, 0.94fr) minmax(18rem, 28rem);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .hotel-home-stage__copy {
      min-width: 0;
    }

    .hotel-home-display {
      max-width: 12ch;
      font-size: 4rem;
      line-height: 0.9;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .hotel-home-display span {
      display: block;
    }

    .hotel-home-display span + span {
      text-indent: 1.4rem;
    }

    .hotel-home-small {
      margin-bottom: 1.2rem;
      max-width: 34rem;
      font-size: 0.72rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.54);
    }

    .hotel-home-stage__panel {
      max-width: 29rem;
      justify-self: end;
      border-top: 1px solid rgba(255, 255, 255, 0.24);
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      padding-block: 1.05rem 1.2rem;
    }

    .hotel-home-stage__panel-label {
      margin-bottom: 0.8rem;
      font-size: 0.62rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 250, 242, 0.44);
    }

    .hotel-home-stage__panel p {
      max-width: 27rem;
      font-size: 0.98rem;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.78);
    }

    .hotel-home-scroll-cue {
      align-self: center;
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      margin-bottom: clamp(1rem, 2vh, 1.6rem);
      color: rgba(255, 250, 242, 0.58);
      font-size: 0.62rem;
      letter-spacing: 0;
      text-transform: uppercase;
      text-decoration: none;
    }

    .hotel-home-scroll-cue i {
      display: block;
      width: 1px;
      height: 2.4rem;
      background: linear-gradient(
        180deg,
        rgba(255, 250, 242, 0.58),
        rgba(255, 250, 242, 0)
      );
    }

    .hotel-home-scroll-cue:hover {
      color: #fffaf2;
      transform: translateY(2px);
    }

    .hotel-home-stage__bottom {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hotel-home-route {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
      padding-top: 0.82rem;
      color: rgba(255, 255, 255, 0.68);
      font-size: 0.7rem;
      letter-spacing: 0;
      text-transform: uppercase;
      text-decoration: none;
    }

    .hotel-home-route:hover {
      color: #fff;
      transform: translateY(-2px);
    }

    .hotel-home-button {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding-inline: 1.1rem;
      font-size: 0.88rem;
      line-height: 1;
      text-decoration: none;
    }

    .hotel-home-button--light {
      background: #fffaf2;
      color: #15120f;
    }

    .hotel-home-button--ghost {
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fffaf2;
      background: rgba(255, 255, 255, 0.04);
    }

    .hotel-home-button--dark-ghost {
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fffaf2;
      background: rgba(255, 255, 255, 0.04);
    }

    .hotel-home-button--black {
      background: #15120f;
      color: #fffaf2;
    }

    .hotel-home-button--outline {
      border: 1px solid rgba(21, 18, 15, 0.18);
      color: #15120f;
      background: rgba(255, 255, 255, 0.22);
    }

    .hotel-living-section {
      width: min(100% - clamp(1.25rem, 4vw, 4rem), 1480px);
      margin-inline: auto;
      margin-top: clamp(5rem, 10vw, 9rem);
    }

    .hotel-section-label {
      font-size: 0.66rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.42);
    }

    .hotel-section-label--light {
      color: rgba(255, 250, 242, 0.42);
    }

    .hotel-living-intro {
      margin-top: 1.4rem;
      display: grid;
      gap: clamp(1.5rem, 5vw, 5rem);
      grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.58fr);
      align-items: end;
    }

    .hotel-living-intro h2,
    .hotel-archive-copy h2 {
      font-size: 3rem;
      line-height: 0.9;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .hotel-living-intro p,
    .hotel-archive-copy p {
      max-width: 36rem;
      font-size: 1rem;
      line-height: 1.82;
      color: rgba(21, 18, 15, 0.62);
    }

    .hotel-living-paths {
      margin-top: clamp(2.2rem, 5vw, 4.5rem);
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(0.9rem, 2vw, 1.4rem);
      align-items: start;
    }

    .hotel-living-path {
      position: relative;
      display: block;
      min-height: clamp(29rem, 42vw, 46rem);
      overflow: hidden;
      border: 1px solid rgba(21, 18, 15, 0.1);
      background: #15120f;
      color: #fffaf2;
      text-decoration: none;
      isolation: isolate;
    }

    .hotel-living-path--1 {
      grid-column: 1 / 8;
    }

    .hotel-living-path--2 {
      grid-column: 8 / 13;
      margin-top: clamp(4rem, 8vw, 8rem);
      min-height: clamp(26rem, 35vw, 38rem);
    }

    .hotel-living-path--3 {
      grid-column: 3 / 11;
      margin-top: clamp(0.5rem, 2vw, 2rem);
      min-height: clamp(28rem, 38vw, 42rem);
    }

    .hotel-living-path__media {
      position: absolute;
      inset: 0;
      min-height: 0;
      background: #15120f;
    }

    .hotel-living-path__media::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, transparent 30%, rgba(0, 0, 0, 0.12) 52%, rgba(0, 0, 0, 0.76)),
        linear-gradient(300deg, rgba(255, 240, 210, 0.16), transparent 38%);
      pointer-events: none;
    }

    .hotel-living-path__media img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      opacity: 0.94;
      filter: saturate(0.98) contrast(1.04) brightness(1.04);
      transition:
        transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hotel-living-path:hover .hotel-living-path__media img {
      transform: scale(1.035);
      filter: saturate(1.05) contrast(1.06) brightness(1.08);
    }

    .hotel-living-path__copy {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      display: block;
      padding: clamp(1.4rem, 4vw, 3rem);
      background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.72));
    }

    .hotel-living-path__copy span {
      font-size: 0.64rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 250, 242, 0.48);
    }

    .hotel-living-path__copy h3 {
      margin-top: 0.9rem;
      max-width: 12ch;
      font-size: 2.5rem;
      line-height: 0.94;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .hotel-living-path__copy p {
      margin-top: 1rem;
      max-width: 34rem;
      font-size: 0.95rem;
      line-height: 1.7;
      color: rgba(255, 250, 242, 0.68);
    }

    .hotel-archive-section {
      position: relative;
      width: 100%;
      margin-top: clamp(5rem, 10vw, 9rem);
      display: grid;
      min-height: 100svh;
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.28fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
      background: #15120f;
      color: #fffaf2;
      padding: clamp(5rem, 8vw, 8rem) max(1rem, calc((100vw - 1480px) / 2));
      overflow: hidden;
    }

    .hotel-archive-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(110deg, rgba(255, 255, 255, 0.08), transparent 42%),
        linear-gradient(290deg, rgba(226, 188, 136, 0.18), transparent 46%);
      pointer-events: none;
    }

    .hotel-archive-copy,
    .hotel-archive-frame {
      position: relative;
      z-index: 1;
    }

    .hotel-archive-copy p {
      color: rgba(255, 250, 242, 0.64);
    }

    .hotel-archive-frame {
      display: block;
      overflow: hidden;
      min-height: clamp(30rem, 54vw, 50rem);
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      text-decoration: none;
      color: #fffaf2;
      box-shadow: 0 36px 110px rgba(0, 0, 0, 0.28);
    }

    .hotel-archive-frame > img {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      opacity: 1;
      filter: brightness(1.1) contrast(1.05) saturate(1.04);
      transition:
        transform 1000ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 1000ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hotel-archive-frame:hover > img {
      transform: scale(1.035);
      filter: brightness(1.16) contrast(1.08) saturate(1.06);
    }

    .hotel-archive-frame::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(120deg, rgba(255, 245, 220, 0.12), transparent 38%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.2) 54%, rgba(0, 0, 0, 0.76));
      pointer-events: none;
    }

    .hotel-archive-frame__readout {
      position: absolute;
      left: clamp(1.1rem, 3vw, 2rem);
      right: clamp(1.1rem, 3vw, 2rem);
      bottom: clamp(1.1rem, 3vw, 2rem);
      z-index: 2;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.24);
      padding-top: 1rem;
    }

    .hotel-archive-frame__readout span {
      font-size: 0.66rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 250, 242, 0.5);
    }

    .hotel-archive-frame__readout strong {
      font-size: 3rem;
      line-height: 0.9;
      letter-spacing: 0;
      font-weight: 400;
    }

    .hotel-archive-filmstrip {
      position: absolute;
      z-index: 3;
      right: clamp(1rem, 2vw, 1.4rem);
      top: clamp(1rem, 2vw, 1.4rem);
      display: flex;
      gap: 0.55rem;
      padding: 0.55rem;
      background: rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(16px);
    }

    .hotel-archive-filmstrip span {
      display: block;
      height: 5rem;
      width: 6.8rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
    }

    .hotel-archive-filmstrip img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      filter: brightness(1.08) contrast(1.04);
    }

    /* Stage 2G - Home Closing / Notes / CTA Editorial Reframe */

    .hotel-closing-section {
      --closing-content-opacity: 0.86;
      --closing-content-y: 4vh;
      --closing-image-scale: 1.045;
      --closing-image-y: -2.5vh;
      --closing-shade-opacity: 0.18;
      --closing-shade-y: 0vh;
      --closing-visual-opacity: 0.94;
      --closing-visual-y: 4.5vh;
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      min-height: 100svh;
      overflow: hidden;
      background: #f6efe4;
      color: #15120f;
      isolation: isolate;
    }

    #home-gallery {
      position: relative;
      isolation: isolate;
    }

    .hotel-closing-section::before {
      content: "";
      position: absolute;
      inset: -8% 0 auto;
      z-index: 4;
      height: 24%;
      opacity: var(--closing-shade-opacity);
      transform: translate3d(0, var(--closing-shade-y), 0);
      background:
        radial-gradient(circle at 72% 12%, rgba(226, 188, 136, 0.18), transparent 34%),
        linear-gradient(180deg, #15120f 0%, rgba(21, 18, 15, 0.94) 42%, rgba(21, 18, 15, 0) 100%);
      clip-path: polygon(0 0, 100% 0, 100% 72%, 0 100%);
      pointer-events: none;
      will-change: opacity, transform;
    }

    .hotel-closing__visual {
      position: relative;
      z-index: 1;
      min-height: 100svh;
      overflow: hidden;
      background: #15120f;
      opacity: var(--closing-visual-opacity);
      transform: translate3d(0, var(--closing-visual-y), 0);
      will-change: transform, opacity;
    }

    .hotel-closing__visual img {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      filter: brightness(1.04) contrast(1.04) saturate(1.02);
      transform: translate3d(0, var(--closing-image-y), 0) scale(var(--closing-image-scale));
      will-change: transform;
    }

    .hotel-closing__visual::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(110deg, rgba(255, 236, 205, 0.16), transparent 38%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.7));
      pointer-events: none;
    }

    .hotel-closing__visual-readout {
      position: absolute;
      left: clamp(1.25rem, 3vw, 2.4rem);
      right: clamp(1.25rem, 3vw, 2.4rem);
      bottom: clamp(1.25rem, 3vw, 2.4rem);
      z-index: 2;
      border-top: 1px solid rgba(255, 250, 242, 0.24);
      padding-top: 1rem;
      color: #fffaf2;
    }

    .hotel-closing__visual-readout span {
      display: block;
      font-size: 0.64rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(255, 250, 242, 0.5);
    }

    .hotel-closing__visual-readout strong {
      margin-top: 0.75rem;
      display: block;
      max-width: 8ch;
      font-size: 3rem;
      line-height: 0.9;
      letter-spacing: 0;
      font-weight: 400;
    }

    .hotel-closing__content {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: 100svh;
      padding: clamp(5rem, 8vw, 8rem) max(1.25rem, calc((100vw - 1480px) / 2)) clamp(3rem, 6vw, 5rem) clamp(1.25rem, 5vw, 5rem);
      opacity: var(--closing-content-opacity, 1);
      transform: translate3d(0, var(--closing-content-y, 0vh), 0);
      will-change: transform, opacity;
    }

    .hotel-closing__main {
      display: flex;
      max-width: 54rem;
      flex-direction: column;
      justify-content: center;
    }

    .hotel-closing__main h2 {
      margin-top: 1.2rem;
      max-width: 9.8ch;
      font-size: 3.4rem;
      line-height: 0.9;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .hotel-closing__main p {
      margin-top: 1.5rem;
      max-width: 36rem;
      font-size: 1rem;
      line-height: 1.82;
      color: rgba(21, 18, 15, 0.64);
    }

    .hotel-closing__actions {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .hotel-closing__notes {
      display: grid;
      grid-template-columns: minmax(0, 0.52fr) minmax(0, 0.9fr);
      gap: clamp(1.2rem, 4vw, 4rem);
      align-items: start;
      border-top: 1px solid rgba(21, 18, 15, 0.12);
      padding-top: clamp(1.4rem, 3vw, 2.4rem);
    }

    .hotel-closing__notes h3 {
      margin-top: 0.9rem;
      max-width: 11ch;
      font-size: 2rem;
      line-height: 0.94;
      letter-spacing: 0;
    }

    .hotel-closing__notes > div > p {
      margin-top: 1rem;
      max-width: 22rem;
      font-size: 0.9rem;
      line-height: 1.7;
      color: rgba(21, 18, 15, 0.58);
    }

    .hotel-closing__note-list {
      display: grid;
      gap: 1rem;
    }

    .hotel-closing__note-list article {
      border-bottom: 1px solid rgba(21, 18, 15, 0.12);
      padding-bottom: 1rem;
    }

    .hotel-closing__note-list article:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .hotel-closing__note-list small {
      display: block;
      margin-bottom: 0.7rem;
      font-size: 0.64rem;
      letter-spacing: 0;
      color: rgba(21, 18, 15, 0.38);
    }

    .hotel-closing__note-list p {
      max-width: 38rem;
      font-size: 1.2rem;
      line-height: 1.22;
      letter-spacing: 0;
    }

    .hotel-closing__note-list span {
      margin-top: 0.7rem;
      display: block;
      font-size: 0.84rem;
      color: rgba(21, 18, 15, 0.5);
    }

    /* Stage 2F - Living Field Typography & Spacing Pass */

    .hotel-living-section {
      position: relative;
    }

    .hotel-living-section::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: -2.2rem;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(21, 18, 15, 0.18),
        rgba(21, 18, 15, 0.04),
        transparent
      );
      pointer-events: none;
    }

    .hotel-living-intro {
      grid-template-columns: minmax(0, 0.92fr) minmax(18rem, 0.52fr);
      gap: clamp(2rem, 7vw, 7rem);
      align-items: start;
    }

    .hotel-living-intro__title {
      max-width: 11.6ch;
      font-size: 3.4rem;
      line-height: 0.88;
      letter-spacing: 0;
    }

    .hotel-living-intro__title span {
      display: block;
    }

    .hotel-living-intro__title span + span {
      margin-top: 0.08em;
      text-indent: 1.4rem;
    }

    .hotel-living-intro__side {
      display: flex;
      min-height: 15rem;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: 0.35rem;
    }

    .hotel-living-intro__side p {
      max-width: 34rem;
    }

    .hotel-living-intro__signal {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .hotel-living-intro__signal span {
      border: 1px solid rgba(21, 18, 15, 0.12);
      background: rgba(255, 250, 242, 0.42);
      padding: 0.62rem 0.78rem;
      border-radius: 999px;
      font-size: 0.62rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.5);
    }

    .hotel-living-rail {
      margin-top: clamp(2.4rem, 5vw, 4.8rem);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(0.8rem, 2vw, 1.4rem);
      border-top: 1px solid rgba(21, 18, 15, 0.12);
      padding-top: 0.85rem;
    }

    .hotel-living-rail span {
      font-size: 0.62rem;
      letter-spacing: 0;
      text-transform: uppercase;
      color: rgba(21, 18, 15, 0.42);
    }

    .hotel-living-paths {
      margin-top: clamp(1.4rem, 3.5vw, 3rem);
      gap: clamp(1rem, 2.5vw, 1.8rem);
    }

    .hotel-living-path {
      border: 1px solid rgba(21, 18, 15, 0.08);
      background: #0f0d0b;
    }

    .hotel-living-path--1 {
      grid-column: 1 / 8;
      min-height: clamp(31rem, 44vw, 47rem);
    }

    .hotel-living-path--2 {
      grid-column: 8 / 13;
      margin-top: clamp(5rem, 9vw, 9rem);
      min-height: clamp(27rem, 36vw, 39rem);
    }

    .hotel-living-path--3 {
      grid-column: 2 / 12;
      margin-top: clamp(1rem, 3vw, 2.5rem);
      min-height: clamp(30rem, 39vw, 43rem);
    }

    .hotel-living-path__copy {
      padding: clamp(1.35rem, 3.2vw, 2.8rem);
    }

    .hotel-living-path__index {
      display: block;
      margin-bottom: clamp(1.3rem, 3vw, 2.4rem);
      font-size: 0.72rem;
      letter-spacing: 0;
      color: rgba(255, 250, 242, 0.38);
    }

    .hotel-living-path__copy span {
      font-size: 0.62rem;
      letter-spacing: 0;
    }

    .hotel-living-path__copy h3 {
      max-width: 10.5ch;
      font-size: 2.8rem;
      line-height: 0.9;
    }

    .hotel-living-path__copy p {
      max-width: 30rem;
      margin-top: 1.15rem;
    }

    .hotel-living-path--2 .hotel-living-path__copy h3 {
      max-width: 8ch;
    }

    .hotel-living-path--3 .hotel-living-path__copy {
      display: grid;
      grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.64fr);
      gap: clamp(1rem, 4vw, 4rem);
      align-items: end;
    }

    .hotel-living-path--3 .hotel-living-path__index,
    .hotel-living-path--3 .hotel-living-path__copy span {
      grid-column: 1;
    }

