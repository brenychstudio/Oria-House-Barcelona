      <script is:inline define:vars={{ roomPayload: roomItems }}>
        (() => {
          const root = document.querySelector("[data-room-index-field]");
          if (!root || !Array.isArray(roomPayload) || roomPayload.length === 0) return;

          const stage = root.querySelector("[data-room-stage]");
          const activeImage = root.querySelector("[data-room-active-image]");
          const activeCount = root.querySelector("[data-room-active-count]");
          const activeTitle = root.querySelector("[data-room-active-title]");
          const activeShort = root.querySelector("[data-room-active-short]");
          const panelTitle = root.querySelector("[data-room-panel-title]");
          const panelDescription = root.querySelector("[data-room-panel-description]");
          const roomPrice = root.querySelector("[data-room-price]");
          const roomGuests = root.querySelector("[data-room-guests]");
          const roomSize = root.querySelector("[data-room-size]");
          const roomBeds = root.querySelector("[data-room-beds]");
          const roomMood = root.querySelector("[data-room-mood]");
          const roomBestFor = root.querySelector("[data-room-best-for]");
          const roomViewSignal = root.querySelector("[data-room-view-signal]");
          const roomWhyChoose = root.querySelector("[data-room-why-choose]");
          const openLink = root.querySelector("[data-room-open-link]");
          const bookingLink = root.querySelector("[data-room-booking-link]");
          const prevBtn = root.querySelector("[data-room-prev]");
          const nextBtn = root.querySelector("[data-room-next]");
          const thumbs = Array.from(root.querySelectorAll("[data-room-thumb]"));

          let activeIndex = 0;
          let switchTimer = 0;

          const pad = (n) => String(n).padStart(2, "0");
          const normalize = (index) => ((index % roomPayload.length) + roomPayload.length) % roomPayload.length;

          const formatSize = (value) => {
            const clean = String(value || "").trim();
            if (!clean) return "—";
            return /[a-zA-Z]/.test(clean) ? clean : `${clean} m²`;
          };

          const render = (nextIndex) => {
            activeIndex = normalize(nextIndex);
            const room = roomPayload[activeIndex];

            if (activeImage) {
              activeImage.src = room.image;
              activeImage.alt = room.title || "";
            }

            if (activeCount) activeCount.textContent = `${pad(activeIndex + 1)} / ${pad(roomPayload.length)}`;
            if (activeTitle) activeTitle.textContent = room.title || "";
            if (activeShort) activeShort.textContent = room.short || "";
            if (panelTitle) panelTitle.textContent = room.title || "";
            if (panelDescription) panelDescription.textContent = room.description || room.short || "";
            if (roomPrice) roomPrice.textContent = room.price ? `€${room.price}` : "—";
            if (roomGuests) roomGuests.textContent = room.guests || "—";
            if (roomSize) roomSize.textContent = formatSize(room.size);
            if (roomBeds) roomBeds.textContent = room.beds || "—";
            if (roomMood) roomMood.textContent = room.mood || "—";
            if (roomBestFor) roomBestFor.textContent = room.bestFor || "—";
            if (roomViewSignal) roomViewSignal.textContent = room.viewSignal || "—";
            if (roomWhyChoose) roomWhyChoose.textContent = room.whyChoose || "—";
            if (openLink) openLink.setAttribute("href", room.href);

            if (bookingLink) {
              bookingLink.setAttribute("data-booking-context", "room");
              bookingLink.setAttribute("data-booking-slug", room.slug || "");
              bookingLink.setAttribute("data-booking-title", room.title || "");
            }

            thumbs.forEach((button, index) => {
              const active = index === activeIndex;
              button.classList.toggle("is-active", active);
              if (active) button.setAttribute("aria-current", "true");
              else button.removeAttribute("aria-current");
            });

            root.classList.remove("is-switching");
            window.clearTimeout(switchTimer);
            void root.offsetWidth;
            root.classList.add("is-switching");
            switchTimer = window.setTimeout(() => root.classList.remove("is-switching"), 760);
          };

          thumbs.forEach((button) => {
            button.addEventListener("click", () => {
              const index = Number(button.getAttribute("data-room-thumb"));
              if (Number.isFinite(index)) render(index);
            });
          });

          if (prevBtn) prevBtn.addEventListener("click", () => render(activeIndex - 1));
          if (nextBtn) nextBtn.addEventListener("click", () => render(activeIndex + 1));

          if (stage) {
            stage.addEventListener("keydown", (event) => {
              if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
                event.preventDefault();
                render(activeIndex - 1);
              }

              if (event.key === "ArrowRight" || event.key === "ArrowDown") {
                event.preventDefault();
                render(activeIndex + 1);
              }

              if (event.key === "Enter" && openLink instanceof HTMLAnchorElement) {
                event.preventDefault();
                openLink.click();
              }
            });
          }

          render(0);
        })();
      </script>

      <script is:inline define:vars={{ roomBrowserLabels: { resultsCopy, allResultsCopy } }}>
        (() => {
          const root = document.querySelector("[data-room-browser]");
          if (!root) return;

          const results = root.querySelector("[data-room-results]");
          const cards = Array.from(root.querySelectorAll("[data-room-card]"));
          const filters = Array.from(root.querySelectorAll("[data-room-filter]"));
          const sortSelect = root.querySelector("[data-room-sort]");
          const resetButton = root.querySelector("[data-room-reset]");
          const viewButtons = Array.from(root.querySelectorAll("[data-room-view]"));
          const countNode = root.querySelector("[data-room-result-count]");
          const copyNode = root.querySelector("[data-room-result-copy]");
          const emptyNode = root.querySelector("[data-room-empty]");

          if (!results || cards.length === 0) return;

          const getNumber = (card, key) => {
            const raw = String(card.dataset[key] || "").trim();
            if (!raw) return null;
            const value = Number(raw);
            return Number.isFinite(value) ? value : null;
          };

          const activeFilters = () =>
            filters.reduce((state, input) => {
              if (input.checked) state[input.getAttribute("data-room-filter")] = input.value;
              return state;
            }, {});

          const matchesFilter = (card, state) => {
            const guests = getNumber(card, "roomGuests");
            const price = getNumber(card, "roomPrice");
            const size = getNumber(card, "roomSize");

            if (state.guests && state.guests !== "all") {
              const minGuests = Number(state.guests);
              if (guests === null || guests < minGuests) return false;
            }

            if (state.price && state.price !== "all") {
              if (price === null) return false;
              if (state.price.endsWith("+")) {
                if (price <= Number(state.price.replace("+", ""))) return false;
              } else if (price > Number(state.price)) {
                return false;
              }
            }

            if (state.size && state.size !== "all") {
              const minSize = Number(state.size);
              if (size === null || size < minSize) return false;
            }

            return true;
          };

          const byNumber = (key, direction) => (a, b) => {
            const av = getNumber(a, key);
            const bv = getNumber(b, key);
            const empty = direction === "asc" ? Number.POSITIVE_INFINITY : Number.NEGATIVE_INFINITY;
            return ((av ?? empty) - (bv ?? empty)) * (direction === "asc" ? 1 : -1);
          };

          const byRecommended = (a, b) =>
            Number(a.dataset.roomIndex || 0) - Number(b.dataset.roomIndex || 0);

          const sortCards = (items) => {
            const mode = sortSelect?.value || "recommended";
            const sorted = [...items];

            if (mode === "price-asc") sorted.sort(byNumber("roomPrice", "asc"));
            else if (mode === "price-desc") sorted.sort(byNumber("roomPrice", "desc"));
            else if (mode === "size-desc") sorted.sort(byNumber("roomSize", "desc"));
            else if (mode === "guests-desc") sorted.sort(byNumber("roomGuests", "desc"));
            else sorted.sort(byRecommended);

            return sorted;
          };

          const updateResults = () => {
            const state = activeFilters();
            const visible = cards.filter((card) => matchesFilter(card, state));
            const ordered = sortCards(cards);

            ordered.forEach((card) => {
              card.hidden = !visible.includes(card);
              results.appendChild(card);
            });

            if (countNode) countNode.textContent = String(visible.length);
            if (copyNode) {
              copyNode.textContent =
                visible.length === cards.length
                  ? roomBrowserLabels.allResultsCopy
                  : `${visible.length} / ${cards.length} ${roomBrowserLabels.resultsCopy}`;
            }

            if (emptyNode) emptyNode.hidden = visible.length > 0;
          };

          const setView = (mode) => {
            root.classList.toggle("is-list-view", mode === "list");
            viewButtons.forEach((button) => {
              const active = button.getAttribute("data-room-view") === mode;
              button.setAttribute("aria-pressed", active ? "true" : "false");
              button.classList.toggle("is-active", active);
            });
          };

          filters.forEach((input) => input.addEventListener("change", updateResults));
          sortSelect?.addEventListener("change", updateResults);
          resetButton?.addEventListener("click", () => {
            filters.forEach((input) => {
              input.checked = input.value === "all";
            });
            if (sortSelect) sortSelect.value = "recommended";
            updateResults();
          });

          viewButtons.forEach((button) => {
            button.addEventListener("click", () => {
              setView(button.getAttribute("data-room-view") || "grid");
            });
          });

          updateResults();
          setView("grid");
        })();
      </script>
    </>
  ) : (
    <section class="rooms-empty">
      <div class="rooms-kicker">{pageTitle}</div>
      <h1>{emptyTitle}</h1>
      <p>{emptyText}</p>
    </section>
  )}

