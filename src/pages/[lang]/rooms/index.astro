---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../../content/languages";
import { getRooms, getSettings } from "../../../cms/sheets";
import { pickLang, splitPipe } from "../../../cms/types";
import { ROOM_COVER_BY_SLUG } from "../../../hotel/data/demoAssets";
import { getSeoCopy } from "../../../hotel/seo/siteSeo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;
const seo = getSeoCopy("rooms", lang);

const s = await getSettings();

const rooms = await getRooms();
const visibleRooms = rooms.filter((room) =>
  Boolean(ROOM_COVER_BY_SLUG[room.slug] ?? (room.cover_image ?? "").trim())
);

const bookingUrl = String((s as any).booking_url || "").trim();

const extractNumber = (value: unknown) => {
  const match = String(value ?? "").match(/\d+(?:[.,]\d+)?/);
  return match ? Number(match[0].replace(",", ".")) : null;
};

const optionalRoomField = (room: any, key: string) =>
  t(
    lang,
    String(room?.[`${key}_en`] || ""),
    String(room?.[`${key}_es`] || "")
  ).trim();

const resolveRoomSales = (room: any, index: number) => {
  const slug = String(room?.slug || "").toLowerCase();

  const explicitMood = optionalRoomField(room, "mood");
  const explicitBestFor = optionalRoomField(room, "best_for");
  const explicitView = optionalRoomField(room, "view_signal");
  const explicitWhy = optionalRoomField(room, "why_choose");

  const profile = (() => {
    if (slug.includes("terrace")) {
      return {
        mood: t(lang, "Terrace air", "Aire de terraza"),
        bestFor: t(lang, "Private outdoor mornings", "Mañanas privadas al aire libre"),
        viewSignal: t(lang, "Open air / sunset rhythm", "Aire abierto / ritmo de atardecer"),
        whyChoose: t(
          lang,
          "Choose this room if outside space matters as much as the bed.",
          "Elija esta habitación si el espacio exterior importa tanto como la cama."
        ),
      };
    }

    if (slug.includes("skyline")) {
      return {
        mood: t(lang, "City light", "Luz de ciudad"),
        bestFor: t(lang, "Guests who want a brighter urban view", "Huéspedes que buscan una vista urbana más luminosa"),
        viewSignal: t(lang, "Skyline / upper-floor light", "Skyline / luz de planta alta"),
        whyChoose: t(
          lang,
          "Choose this room for a more open sense of Barcelona from inside the stay.",
          "Elija esta habitación para sentir Barcelona de forma más abierta desde la estancia."
        ),
      };
    }

    if (slug.includes("balcony") || slug.includes("balc")) {
      return {
        mood: t(lang, "Balcony pause", "Pausa de balcón"),
        bestFor: t(lang, "Morning air and short private breaks", "Aire de mañana y pausas privadas"),
        viewSignal: t(lang, "Balcony / soft exterior moment", "Balcón / momento exterior suave"),
        whyChoose: t(
          lang,
          "Choose this room if you want a small outdoor gesture without moving into a suite.",
          "Elija esta habitación si quiere un pequeño gesto exterior sin pasar a una suite."
        ),
      };
    }

    if (slug.includes("junior") || slug.includes("suite")) {
      return {
        mood: t(lang, "Extended calm", "Calma ampliada"),
        bestFor: t(lang, "Longer stays and guests who need more space", "Estancias largas y huéspedes que necesitan más espacio"),
        viewSignal: t(lang, "Lounge / slower rhythm", "Lounge / ritmo más pausado"),
        whyChoose: t(
          lang,
          "Choose this room when the stay needs a little more room to unfold.",
          "Elija esta habitación cuando la estancia necesite un poco más de espacio para desplegarse."
        ),
      };
    }

    if (slug.includes("family")) {
      return {
        mood: t(lang, "Shared quiet", "Tranquilidad compartida"),
        bestFor: t(lang, "Families or two-zone stays", "Familias o estancias con dos zonas"),
        viewSignal: t(lang, "Flexible layout / practical comfort", "Distribución flexible / confort práctico"),
        whyChoose: t(
          lang,
          "Choose this room when comfort and practical layout are the priority.",
          "Elija esta habitación cuando la comodidad y la distribución práctica sean la prioridad."
        ),
      };
    }

    if (slug.includes("accessible")) {
      return {
        mood: t(lang, "Easy access", "Acceso fácil"),
        bestFor: t(lang, "Accessible comfort with quiet design", "Confort accesible con diseño tranquilo"),
        viewSignal: t(lang, "Barrier-free / calm layout", "Sin barreras / distribución serena"),
        whyChoose: t(
          lang,
          "Choose this room for a more accessible stay without losing the calm hotel atmosphere.",
          "Elija esta habitación para una estancia más accesible sin perder la atmósfera tranquila del hotel."
        ),
      };
    }

    if (slug.includes("courtyard")) {
      return {
        mood: t(lang, "Courtyard calm", "Calma de patio"),
        bestFor: t(lang, "Quiet mornings and softer light", "Mañanas tranquilas y luz más suave"),
        viewSignal: t(lang, "Inner courtyard / privacy", "Patio interior / privacidad"),
        whyChoose: t(
          lang,
          "Choose this room for the most silent and grounded version of the stay.",
          "Elija esta habitación para la versión más silenciosa y serena de la estancia."
        ),
      };
    }

    return {
      mood: t(lang, "Soft city stay", "Estancia urbana suave"),
      bestFor: t(lang, "Guests who want calm, clarity and direct booking", "Huéspedes que buscan calma, claridad y reserva directa"),
      viewSignal: t(lang, "Quiet room / balanced light", "Habitación tranquila / luz equilibrada"),
      whyChoose: t(
        lang,
        "Choose this room as a balanced base for a slower Barcelona stay.",
        "Elija esta habitación como base equilibrada para una estancia más pausada en Barcelona."
      ),
    };
  })();

  return {
    mood: explicitMood || profile.mood,
    bestFor: explicitBestFor || profile.bestFor,
    viewSignal: explicitView || profile.viewSignal,
    whyChoose: explicitWhy || profile.whyChoose,
  };
};

const roomItems = visibleRooms.map((room, index) => {
  const title = pickLang(lang, room, "name");
  const short = pickLang(lang, room, "short");
  const description = pickLang(lang, room, "description");
  const highlights = splitPipe(pickLang(lang, room, "highlights")).slice(0, 4);

  const price = String((room as any).price_from || "").trim();
  const guests = String((room as any).guests || "").trim();
  const size = String((room as any).size_m2 || (room as any).size_sqm || (room as any).size || "").trim();
  const beds = pickLang(lang, room, "beds");
  const sales = resolveRoomSales(room, index);
  const priceValue = extractNumber(price);
  const guestsValue = extractNumber(guests);
  const sizeValue = extractNumber(size);

  return {
    id: room.id || room.slug || `room-${index + 1}`,
    slug: room.slug,
    href: `/${lang}/rooms/${room.slug}/`,
    title,
    short,
    description,
    image: ROOM_COVER_BY_SLUG[room.slug] ?? room.cover_image,
    price,
    guests,
    size,
    priceValue,
    guestsValue,
    sizeValue,
    beds,
    highlights,
    index,
    mood: sales.mood,
    bestFor: sales.bestFor,
    viewSignal: sales.viewSignal,
    whyChoose: sales.whyChoose,
  };
});

const firstRoom = roomItems[0];

const heroRoom =
  roomItems.find((room) =>
    ["junior-suite", "deluxe-terrace", "studio-skyline", "suite-terrace"].some((key) =>
      String(room.slug || "").includes(key)
    )
  ) ?? roomItems[1] ?? firstRoom;

const pageTitle = t(lang, "Rooms", "Habitaciones");

const heroEyebrow = t(lang, "Rooms / Suites", "Habitaciones / Suites");
const heroTitle = t(
  lang,
  "Rooms shaped by light, privacy and quiet city rhythm.",
  "Habitaciones definidas por luz, privacidad y un ritmo urbano tranquilo."
);
const heroText = t(
  lang,
  "Move through the rooms as stay states: courtyard calm, skyline light, terrace air and quieter mornings before Barcelona gets loud.",
  "Recorra las habitaciones como estados de estancia: calma de patio, luz de ciudad, aire de terraza y mañanas más tranquilas antes de que Barcelona despierte."
);

const fieldEyebrow = t(lang, "Room field", "Campo de habitaciones");
const fieldTitle = t(
  lang,
  "Choose the room by atmosphere, not only by category.",
  "Elija la habitación por atmósfera, no solo por categoría."
);
const fieldText = t(
  lang,
  "Each room is treated as a stay object: light, size, view, materials and the kind of Barcelona day it supports.",
  "Cada habitación se trata como un objeto de estancia: luz, tamaño, vista, materiales y el tipo de día en Barcelona que acompaña."
);

const openRoomLabel = t(lang, "Open room", "Abrir habitación");
const bookDirectLabel = t(lang, "Book direct", "Reservar directo");
const contactHotelLabel = t(lang, "Contact hotel", "Contactar hotel");
const previousRoomLabel = t(lang, "Previous room", "Habitación anterior");
const nextRoomLabel = t(lang, "Next room", "Siguiente habitación");

const fromLabel = t(lang, "From", "Desde");
const guestsLabel = t(lang, "Guests", "Huéspedes");
const sizeLabel = t(lang, "Size", "Tamaño");
const bedsLabel = t(lang, "Beds", "Camas");
const moodLabel = t(lang, "Mood", "Atmósfera");
const bestForLabel = t(lang, "Best for", "Ideal para");
const viewSignalLabel = t(lang, "View / light", "Vista / luz");
const whyChooseLabel = t(lang, "Why choose it", "Por qué elegirla");
const compareLabel = t(lang, "Compare stays", "Comparar estancias");
const archiveLabel = t(lang, "Room archive", "Archivo de habitaciones");
const archiveTitle = t(
  lang,
  "All stays, kept readable.",
  "Todas las estancias, mantenidas legibles."
);
const archiveText = t(
  lang,
  "Use the visual room field to feel the atmosphere, then use this index for direct comparison.",
  "Use el campo visual para sentir la atmósfera y este índice para comparar directamente."
);

const emptyTitle = t(lang, "Rooms are being prepared.", "Las habitaciones se están preparando.");
const emptyText = t(
  lang,
  "Published rooms with cover images will appear here.",
  "Las habitaciones publicadas con imagen aparecerán aquí."
);

const browseLabel = t(lang, "Room browser", "Explorador de habitaciones");
const browseTitle = t(
  lang,
  "Compare rooms quickly, then open the one that fits.",
  "Compare habitaciones rapido y abra la que encaja."
);
const browseText = t(
  lang,
  "A compact room index for the practical decision: price, size, guests, light and the reason to choose each stay.",
  "Un indice compacto para decidir: precio, tamano, huespedes, luz y la razon para elegir cada estancia."
);
const roomsAvailableLabel = t(lang, "Rooms available", "Habitaciones disponibles");
const quickSignalsLabel = t(lang, "Quick signals", "Senales rapidas");
const filterRoomsLabel = t(lang, "Filter rooms", "Filtrar habitaciones");
const guestsFilterLabel = t(lang, "People", "Personas");
const priceFilterLabel = t(lang, "Price", "Precio");
const sizeFilterLabel = t(lang, "Size", "Tamano");
const sortLabel = t(lang, "Sort", "Ordenar");
const anyLabel = t(lang, "Any", "Cualquiera");
const resetFiltersLabel = t(lang, "Reset", "Reiniciar");
const viewModeLabel = t(lang, "View mode", "Modo de vista");
const gridViewLabel = t(lang, "Grid", "Grid");
const listViewLabel = t(lang, "List", "Lista");
const tileScanLabel = t(lang, "Tile scan", "Vista visual");
const lineScanLabel = t(lang, "Line scan", "Vista lista");
const recommendedLabel = t(lang, "Recommended", "Recomendado");
const priceLowLabel = t(lang, "Price low to high", "Precio menor a mayor");
const priceHighLabel = t(lang, "Price high to low", "Precio mayor a menor");
const sizeLargeLabel = t(lang, "Largest first", "Mas grandes primero");
const guestsHighLabel = t(lang, "Most people first", "Mas personas primero");
const noRoomsMatchTitle = t(lang, "No rooms match these filters.", "Ninguna habitacion coincide.");
const noRoomsMatchText = t(
  lang,
  "Reset the filters or widen one parameter to see more stays.",
  "Reinicie los filtros o amplie un parametro para ver mas estancias."
);
const resultsCopy = t(lang, "matching stays", "estancias coinciden");
const allResultsCopy = t(lang, "all stays shown", "todas visibles");
const priceUpToLabel = t(lang, "Up to", "Hasta");
const priceAboveLabel = t(lang, "Above", "Mas de");
const sizeAtLeastLabel = t(lang, "At least", "Minimo");
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={heroRoom?.image ?? firstRoom?.image}
  canonicalPath={`/${lang}/rooms/`}
  fullBleed
>
  {firstRoom ? (
    <>
      <section class="rooms-hero" data-dock-section>
        <img
          src={heroRoom?.image ?? firstRoom.image}
          alt=""
          class="rooms-hero__image"
          loading="eager"
          decoding="async"
        />
        <div class="rooms-hero__veil" aria-hidden="true"></div>

        <div class="rooms-hero__inner">
          <div class="rooms-hero__top">
            <span>{heroEyebrow}</span>
            <span>{t(lang, "Opening room", "Habitación inicial")} / {heroRoom?.title ?? firstRoom.title}</span>
          </div>

          <div class="rooms-hero__content">
            <h1>{heroTitle}</h1>

            <aside>
              <p>{heroText}</p>

              <div class="rooms-hero__actions">
                <a href="#rooms-browser">{t(lang, "Explore rooms", "Explorar habitaciones")}</a>
                {bookingUrl ? (
                  <a href={bookingUrl} target="_blank" rel="noreferrer">
                    {bookDirectLabel}
                  </a>
                ) : null}
              </div>
            </aside>
          </div>

          <div class="rooms-hero__rail" aria-hidden="true">
            {roomItems.slice(0, 4).map((room, index) => (
              <span>{String(index + 1).padStart(2, "0")} / {room.title}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="rooms-browser" class="rooms-browser" data-room-browser data-dock-section>
        <div class="rooms-browser__head">
          <div>
            <div class="rooms-kicker">{browseLabel}</div>
            <h2>{browseTitle}</h2>
            <p>{browseText}</p>
          </div>

          <aside class="rooms-browser__summary" aria-label={quickSignalsLabel}>
            <span>{roomsAvailableLabel}</span>
            <strong data-room-result-count>{roomItems.length}</strong>
            <p>
              <span data-room-result-copy>{fieldText}</span>
            </p>
          </aside>
        </div>

        <div class="rooms-browser__controls" aria-label={filterRoomsLabel}>
          <div class="rooms-filter-rail">
            <fieldset class="rooms-filter-group">
              <legend>{guestsFilterLabel}</legend>
              <label>
                <input type="radio" name="rooms-guests" value="all" data-room-filter="guests" checked />
                <span>{anyLabel}</span>
              </label>
              <label>
                <input type="radio" name="rooms-guests" value="2" data-room-filter="guests" />
                <span>2+</span>
              </label>
              <label>
                <input type="radio" name="rooms-guests" value="3" data-room-filter="guests" />
                <span>3+</span>
              </label>
              <label>
                <input type="radio" name="rooms-guests" value="4" data-room-filter="guests" />
                <span>4+</span>
              </label>
            </fieldset>

            <fieldset class="rooms-filter-group">
              <legend>{priceFilterLabel}</legend>
              <label>
                <input type="radio" name="rooms-price" value="all" data-room-filter="price" checked />
                <span>{anyLabel}</span>
              </label>
              <label>
                <input type="radio" name="rooms-price" value="200" data-room-filter="price" />
                <span>{priceUpToLabel} €200</span>
              </label>
              <label>
                <input type="radio" name="rooms-price" value="300" data-room-filter="price" />
                <span>{priceUpToLabel} €300</span>
              </label>
              <label>
                <input type="radio" name="rooms-price" value="401+" data-room-filter="price" />
                <span>€400+</span>
              </label>
            </fieldset>

            <fieldset class="rooms-filter-group">
              <legend>{sizeFilterLabel}</legend>
              <label>
                <input type="radio" name="rooms-size" value="all" data-room-filter="size" checked />
                <span>{anyLabel}</span>
              </label>
              <label>
                <input type="radio" name="rooms-size" value="24" data-room-filter="size" />
                <span>24 m²+</span>
              </label>
              <label>
                <input type="radio" name="rooms-size" value="32" data-room-filter="size" />
                <span>32 m²+</span>
              </label>
              <label>
                <input type="radio" name="rooms-size" value="40" data-room-filter="size" />
                <span>40 m²+</span>
              </label>
            </fieldset>

            <label class="rooms-filter-group rooms-browser__sort">
              <span>{sortLabel}</span>
              <select data-room-sort aria-label={sortLabel}>
                <option value="recommended">{recommendedLabel}</option>
                <option value="price-asc">{priceLowLabel}</option>
                <option value="price-desc">{priceHighLabel}</option>
                <option value="size-desc">{sizeLargeLabel}</option>
                <option value="guests-desc">{guestsHighLabel}</option>
              </select>
            </label>

            <div class="rooms-view-toggle" role="group" aria-label={viewModeLabel}>
              <button type="button" class="is-active" data-room-view="grid" aria-pressed="true">
                <span>{gridViewLabel}</span>
                <small>{tileScanLabel}</small>
              </button>
              <button type="button" data-room-view="list" aria-pressed="false">
                <span>{listViewLabel}</span>
                <small>{lineScanLabel}</small>
              </button>
            </div>

            <button type="button" class="rooms-browser__reset" data-room-reset>
              {resetFiltersLabel}
            </button>
          </div>
        </div>

        <div class="rooms-browser__grid" data-room-results>
          {roomItems.map((room, index) => (
            <article
              class="rooms-card"
              data-room-card
              data-room-index={index}
              data-room-price={room.priceValue ?? ""}
              data-room-guests={room.guestsValue ?? ""}
              data-room-size={room.sizeValue ?? ""}
            >
              <a href={room.href} class="rooms-card__media" aria-label={`${openRoomLabel}: ${room.title}`}>
                <img src={room.image} alt="" loading={index < 3 ? "eager" : "lazy"} decoding="async" />
                <span>{String(index + 1).padStart(2, "0")}</span>
              </a>

              <div class="rooms-card__body">
                <div class="rooms-card__intro">
                  <div class="rooms-card__eyebrow">{room.mood}</div>
                  <h3>
                    <a href={room.href}>{room.title}</a>
                  </h3>
                  <p>{room.short || room.bestFor}</p>
                </div>

                <div class="rooms-card__specs">
                  <span>
                    <small>{fromLabel}</small>
                    <strong>{room.price ? `€${room.price}` : "—"}</strong>
                  </span>
                  {room.guests ? (
                    <span>
                      <small>{guestsLabel}</small>
                      <strong>{room.guests}</strong>
                    </span>
                  ) : null}
                  {room.size ? (
                    <span>
                      <small>{sizeLabel}</small>
                      <strong>{room.size}{room.size.match(/[a-zA-Z]/) ? "" : " m²"}</strong>
                    </span>
                  ) : null}
                  {room.beds ? (
                    <span>
                      <small>{bedsLabel}</small>
                      <strong>{room.beds}</strong>
                    </span>
                  ) : null}
                </div>

                <div class="rooms-card__signals">
                  <span>
                    <small>{viewSignalLabel}</small>
                    <strong>{room.viewSignal}</strong>
                  </span>
                  <span>
                    <small>{bestForLabel}</small>
                    <strong>{room.bestFor}</strong>
                  </span>
                </div>

                <div class="rooms-card__actions">
                  <a class="rooms-card__open" href={room.href}>{openRoomLabel}</a>
                  {bookingUrl ? (
                    <a
                      class="rooms-card__book"
                      href={bookingUrl}
                      target="_blank"
                      rel="noreferrer"
                      data-booking-trigger="true"
                      data-booking-context="room"
                      data-booking-slug={room.slug}
                      data-booking-title={room.title}
                    >
                      {bookDirectLabel}
                    </a>
                  ) : null}
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="rooms-browser__empty" data-room-empty hidden>
          <strong>{noRoomsMatchTitle}</strong>
          <p>{noRoomsMatchText}</p>
        </div>
      </section>

      <section id="room-field" class="rooms-field" data-room-index-field data-dock-section>
        <div class="rooms-field__intro">
          <div>
            <div class="rooms-kicker">{fieldEyebrow}</div>
            <h2>{fieldTitle}</h2>
          </div>

          <p>{fieldText}</p>
        </div>

        <div class="rooms-explorer">
          <div class="rooms-explorer__visual" data-room-stage tabindex="0" role="group" aria-label={fieldTitle}>
            <img data-room-active-image src={firstRoom.image} alt="" loading="eager" decoding="async" />
            <div class="rooms-explorer__shade" aria-hidden="true"></div>

            <div class="rooms-explorer__readout">
              <span data-room-active-count>
                01 / {String(roomItems.length).padStart(2, "0")}
              </span>
              <strong data-room-active-title>{firstRoom.title}</strong>
              <p data-room-active-short>{firstRoom.short}</p>
            </div>

            <div class="rooms-explorer__nav">
              <button type="button" data-room-prev aria-label={previousRoomLabel}>←</button>
              <button type="button" data-room-next aria-label={nextRoomLabel}>→</button>
            </div>
          </div>

          <aside class="rooms-explorer__panel">
            <div>
              <div class="rooms-kicker">{t(lang, "Active room", "Habitación activa")}</div>

              <h3 data-room-panel-title>{firstRoom.title}</h3>
              <p data-room-panel-description>{firstRoom.description || firstRoom.short}</p>

              <dl class="rooms-explorer__decision">
                <div>
                  <dt>{moodLabel}</dt>
                  <dd data-room-mood>{firstRoom.mood}</dd>
                </div>

                <div>
                  <dt>{bestForLabel}</dt>
                  <dd data-room-best-for>{firstRoom.bestFor}</dd>
                </div>

                <div>
                  <dt>{viewSignalLabel}</dt>
                  <dd data-room-view-signal>{firstRoom.viewSignal}</dd>
                </div>

                <div>
                  <dt>{whyChooseLabel}</dt>
                  <dd data-room-why-choose>{firstRoom.whyChoose}</dd>
                </div>
              </dl>

              <div class="rooms-explorer__specs">
                <div>
                  <span>{fromLabel}</span>
                  <strong data-room-price>{firstRoom.price ? `€${firstRoom.price}` : "—"}</strong>
                </div>

                <div>
                  <span>{guestsLabel}</span>
                  <strong data-room-guests>{firstRoom.guests || "—"}</strong>
                </div>

                <div>
                  <span>{sizeLabel}</span>
                  <strong data-room-size>
                    {firstRoom.size ? `${firstRoom.size}${firstRoom.size.match(/[a-zA-Z]/) ? "" : " m²"}` : "—"}
                  </strong>
                </div>
              </div>
            </div>

            <div class="rooms-explorer__bottom">
              <div class="rooms-explorer__beds">
                <span>{bedsLabel}</span>
                <strong data-room-beds>{firstRoom.beds || "—"}</strong>
              </div>

              <div class="rooms-explorer__actions">
                <a href={firstRoom.href} data-room-open-link>{openRoomLabel}</a>

                {bookingUrl ? (
                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noreferrer"
                    data-room-booking-link
                    data-booking-trigger="true"
                    data-booking-context="room"
                    data-booking-slug={firstRoom.slug}
                    data-booking-title={firstRoom.title}
                  >
                    {bookDirectLabel}
                  </a>
                ) : (
                  <a href={`/${lang}/contact/`}>{contactHotelLabel}</a>
                )}
              </div>
            </div>
          </aside>
        </div>

        <div class="rooms-rail" aria-label={t(lang, "Room selector", "Selector de habitaciones")}>
          {roomItems.map((room, index) => (
            <button
              type="button"
              data-room-thumb={index}
