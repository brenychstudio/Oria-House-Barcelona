---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../../content/languages";
import { getRooms, getSettings } from "../../../cms/sheets";
import { pickLang, splitPipe } from "../../../cms/types";
import { ROOM_COVER_BY_SLUG, SHARED_ROOM_DETAIL_IMAGES } from "../../../hotel/data/demoAssets";
import { getSeoCopy } from "../../../hotel/seo/siteSeo";
import CinematicInspectGallery from "../../../hotel/ui/CinematicInspectGallery.astro";
import CinematicInspectView from "../../../hotel/ui/CinematicInspectView.astro";

export async function getStaticPaths() {
  const rooms = await getRooms();

  return LANGS.flatMap((lang) =>
    rooms.map((room) => ({
      params: {
        lang,
        slug: room.slug,
      },
      props: {
        room,
      },
    }))
  );
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const { room } = Astro.props as any;
const s = await getSettings();

const hotelName = t(
  lang,
  String((s as any).hotel_name_en || "Hotel Core"),
  String((s as any).hotel_name_es || (s as any).hotel_name_en || "Hotel Core")
);

const bookingUrl = String((s as any).booking_url || "").trim();

const roomTitle = pickLang(lang, room, "name");
const roomShort = pickLang(lang, room, "short");
const roomDescription = pickLang(lang, room, "description");

const roomCover = ROOM_COVER_BY_SLUG[room.slug] ?? String((room as any).cover_image || "").trim();

const roomPrice = String((room as any).price_from || "").trim();
const roomGuests = String((room as any).guests || "").trim();
const roomSize = String(
  (room as any).size_m2 ||
    (room as any).size_sqm ||
    (room as any).size ||
    ""
).trim();
const roomBeds = pickLang(lang, room, "beds");

const splitList = (value: string) =>
  String(value || "")
    .split(/[,|\n]/)
    .map((item) => item.trim())
    .filter(Boolean);

const roomAmenities = splitList(pickLang(lang, room, "amenities"));
const roomHighlights = splitPipe(pickLang(lang, room, "highlights")).slice(0, 5);

const galleryImages = Array.from(
  new Set(
    [
      roomCover,
      ...SHARED_ROOM_DETAIL_IMAGES,
    ].filter(Boolean)
  )
);

const optionalRoomField = (key: string) =>
  t(
    lang,
    String((room as any)?.[`${key}_en`] || ""),
    String((room as any)?.[`${key}_es`] || "")
  ).trim();

const resolveRoomSales = () => {
  const slug = String((room as any)?.slug || "").toLowerCase();

  const explicitMood = optionalRoomField("mood");
  const explicitBestFor = optionalRoomField("best_for");
  const explicitView = optionalRoomField("view_signal");
  const explicitWhy = optionalRoomField("why_choose");

  const profile = (() => {
    if (slug.includes("terrace")) {
      return {
        mood: t(lang, "Terrace air", "Aire de terraza"),
        bestFor: t(lang, "Private outdoor mornings", "Mañanas privadas al aire libre"),
        viewSignal: t(lang, "Open air / sunset rhythm", "Aire abierto / ritmo de atardecer"),
        whyChoose: t(
          lang,
          "Choose this room if outside space matters as much as the bed.",
          "Elija esta habitación si el espacio exterior importa tanto como la cama."
        ),
      };
    }

    if (slug.includes("skyline")) {
      return {
        mood: t(lang, "City light", "Luz de ciudad"),
        bestFor: t(lang, "Guests who want a brighter urban view", "Huéspedes que buscan una vista urbana más luminosa"),
        viewSignal: t(lang, "Skyline / upper-floor light", "Skyline / luz de planta alta"),
        whyChoose: t(
          lang,
          "Choose this room for a more open sense of Barcelona from inside the stay.",
          "Elija esta habitación para sentir Barcelona de forma más abierta desde la estancia."
        ),
      };
    }

    if (slug.includes("balcony")) {
      return {
        mood: t(lang, "Balcony pause", "Pausa de balcón"),
        bestFor: t(lang, "Morning air and short private breaks", "Aire de mañana y pausas privadas"),
        viewSignal: t(lang, "Balcony / soft exterior moment", "Balcón / momento exterior suave"),
        whyChoose: t(
          lang,
          "Choose this room if you want a small outdoor gesture without moving into a suite.",
          "Elija esta habitación si quiere un pequeño gesto exterior sin pasar a una suite."
        ),
      };
    }

    if (slug.includes("junior") || slug.includes("suite")) {
      return {
        mood: t(lang, "Extended calm", "Calma ampliada"),
        bestFor: t(lang, "Longer stays and guests who need more space", "Estancias largas y huéspedes que necesitan más espacio"),
        viewSignal: t(lang, "Lounge / slower rhythm", "Lounge / ritmo más pausado"),
        whyChoose: t(
          lang,
          "Choose this room when the stay needs a little more room to unfold.",
          "Elija esta habitación cuando la estancia necesita un poco más de espacio para desplegarse."
        ),
      };
    }

    if (slug.includes("family")) {
      return {
        mood: t(lang, "Shared quiet", "Tranquilidad compartida"),
        bestFor: t(lang, "Families or two-zone stays", "Familias o estancias con dos zonas"),
        viewSignal: t(lang, "Flexible layout / practical comfort", "Distribución flexible / confort práctico"),
        whyChoose: t(
          lang,
          "Choose this room when comfort and practical layout are the priority.",
          "Elija esta habitación cuando la comodidad y la distribución práctica sean la prioridad."
        ),
      };
    }

    if (slug.includes("accessible")) {
      return {
        mood: t(lang, "Easy access", "Acceso fácil"),
        bestFor: t(lang, "Accessible comfort with quiet design", "Confort accesible con diseño tranquilo"),
        viewSignal: t(lang, "Barrier-free / calm layout", "Sin barreras / distribución serena"),
        whyChoose: t(
          lang,
          "Choose this room for a more accessible stay without losing the calm hotel atmosphere.",
          "Elija esta habitación para una estancia más accesible sin perder la atmósfera tranquila del hotel."
        ),
      };
    }

    if (slug.includes("courtyard")) {
      return {
        mood: t(lang, "Courtyard calm", "Calma de patio"),
        bestFor: t(lang, "Quiet mornings and softer light", "Mañanas tranquilas y luz más suave"),
        viewSignal: t(lang, "Inner courtyard / privacy", "Patio interior / privacidad"),
        whyChoose: t(
          lang,
          "Choose this room for the most silent and grounded version of the stay.",
          "Elija esta habitación para la versión más silenciosa y serena de la estancia."
        ),
      };
    }

    return {
      mood: t(lang, "Soft city stay", "Estancia urbana suave"),
      bestFor: t(lang, "Guests who want calm, clarity and direct booking", "Huéspedes que buscan calma, claridad y reserva directa"),
      viewSignal: t(lang, "Quiet room / balanced light", "Habitación tranquila / luz equilibrada"),
      whyChoose: t(
        lang,
        "Choose this room as a balanced base for a slower Barcelona stay.",
        "Elija esta habitación como base equilibrada para una estancia más pausada en Barcelona."
      ),
    };
  })();

  return {
    mood: explicitMood || profile.mood,
    bestFor: explicitBestFor || profile.bestFor,
    viewSignal: explicitView || profile.viewSignal,
    whyChoose: explicitWhy || profile.whyChoose,
  };
};

const sales = resolveRoomSales();

const pageTitle = `${hotelName} — ${roomTitle}`;
const seo = getSeoCopy("roomDetail", lang);
const roomMetaDescription = roomShort || roomDescription || seo.description;

const backLabel = t(lang, "Back to rooms", "Volver a habitaciones");
const bookDirectLabel = t(lang, "Book direct", "Reservar directo");
const contactHotelLabel = t(lang, "Contact hotel", "Contactar hotel");
const openGalleryLabel = t(lang, "Inspect room images", "Inspeccionar imágenes de habitación");

const roomEyebrow = t(lang, "Room / Stay decision", "Habitación / Decisión de estancia");
const stayDetailsLabel = t(lang, "Stay details", "Detalles de estancia");
const fromLabel = t(lang, "From", "Desde");
const guestsLabel = t(lang, "Guests", "Huéspedes");
const sizeLabel = t(lang, "Size", "Tamaño");
const bedsLabel = t(lang, "Beds", "Camas");

const moodLabel = t(lang, "Mood", "Atmósfera");
const bestForLabel = t(lang, "Best for", "Ideal para");
const viewSignalLabel = t(lang, "View / light", "Vista / luz");
const whyChooseLabel = t(lang, "Why choose it", "Por qué elegirla");
const amenitiesLabel = t(lang, "Amenities", "Servicios");
const highlightsLabel = t(lang, "Stay signals", "Señales de estancia");
const galleryLabel = t(lang, "Room inspection", "Inspección de habitación");
const directLabel = t(lang, "Direct booking", "Reserva directa");
const roomGuideLabel = t(lang, "Room guide", "Guia de habitacion");
const usefulDetailsLabel = t(lang, "Useful details", "Detalles utiles");
const photoSwitcherLabel = t(lang, "Room photo switcher", "Selector de fotos de habitacion");
const previousImageLabel = t(lang, "Previous image", "Imagen anterior");
const nextImageLabel = t(lang, "Next image", "Imagen siguiente");
const openImageLabel = t(lang, "Show image", "Mostrar imagen");

const resolveRoomInspectTitle = (src: string, index: number) => {
  if (index === 0) return roomTitle;

  const value = src.toLowerCase();

  if (value.includes("bath") || value.includes("shower")) {
    return t(lang, "Bathroom detail", "Detalle de baño");
  }

  if (value.includes("desk") || value.includes("book") || value.includes("coffee")) {
    return t(lang, "Desk and morning detail", "Escritorio y detalle de mañana");
  }

  if (value.includes("curtain") || value.includes("window")) {
    return t(lang, "Window light", "Luz de ventana");
  }

  if (value.includes("linen") || value.includes("bed")) {
    return t(lang, "Linen and sleeping area", "Lino y zona de descanso");
  }

  if (value.includes("corridor")) {
    return t(lang, "Arrival corridor", "Pasillo de llegada");
  }

  if (value.includes("terrace") || value.includes("balcony")) {
    return t(lang, "Terrace light", "Luz de terraza");
  }

  return t(lang, "Material close-up", "Detalle de material");
};

const resolveRoomInspectSection = (src: string, index: number) => {
  if (index === 0) return t(lang, "Room", "Habitación");

  const value = src.toLowerCase();

  if (value.includes("bath") || value.includes("shower")) {
    return t(lang, "Bathroom", "Baño");
  }

  if (value.includes("desk") || value.includes("book") || value.includes("coffee")) {
    return t(lang, "Work / morning", "Trabajo / mañana");
  }

  if (value.includes("curtain") || value.includes("window")) {
    return t(lang, "Light", "Luz");
  }

  if (value.includes("corridor")) {
    return t(lang, "Arrival", "Llegada");
  }

  if (value.includes("terrace") || value.includes("balcony")) {
    return t(lang, "Outdoor", "Exterior");
  }

  return galleryLabel;
};

const resolveRoomInspectSignal = (src: string, index: number) => {
  if (index === 0) return roomShort || sales.whyChoose;

  const value = src.toLowerCase();

  if (value.includes("bath") || value.includes("shower")) {
    return t(lang, "Stone, water and quiet material finish.", "Piedra, agua y acabado material tranquilo.");
  }

  if (value.includes("desk") || value.includes("book") || value.includes("coffee")) {
    return t(lang, "Small morning surface for slower starts.", "Pequeña superficie de mañana para comienzos más pausados.");
  }

  if (value.includes("curtain") || value.includes("window")) {
    return t(lang, "Soft light, privacy and a slower room rhythm.", "Luz suave, privacidad y un ritmo de habitación más pausado.");
  }

  if (value.includes("linen") || value.includes("bed")) {
    return t(lang, "Linen, rest and a quieter return.", "Lino, descanso y un regreso más tranquilo.");
  }

  if (value.includes("corridor")) {
    return t(lang, "A calm arrival layer before entering the room.", "Una capa de llegada tranquila antes de entrar en la habitación.");
  }

  if (value.includes("terrace") || value.includes("balcony")) {
    return t(lang, "Open air, soft exterior light and private pause.", "Aire abierto, luz exterior suave y pausa privada.");
  }

  return t(lang, "Material, light and quiet room detail.", "Material, luz y detalle tranquilo de la habitación.");
};

const roomInspectItems = galleryImages.map((src, index) => ({
  id: `${room.slug}-${index + 1}`,
  title: resolveRoomInspectTitle(src, index),
  src,
  section: resolveRoomInspectSection(src, index),
  mood: sales.mood,
  signal: resolveRoomInspectSignal(src, index),
  alt: `${roomTitle} — ${index + 1}`,
}));

const formatSize = (value: string) => {
  if (!value) return "";
  return /[a-zA-Z]/.test(value) ? value : `${value} m²`;
};
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={roomMetaDescription}
  ogImage={roomCover}
  canonicalPath={`/${lang}/rooms/${room.slug}/`}
  fullBleed
>
  <section class="room-detail-hero" data-dock-section>
    <img src={roomCover} alt="" class="room-detail-hero__image" loading="eager" decoding="async" />
    <div class="room-detail-hero__veil" aria-hidden="true"></div>

    <div class="room-detail-hero__inner">
      <div class="room-detail-hero__top">
        <a href={`/${lang}/rooms/`}>← {backLabel}</a>
        <span>{roomEyebrow}</span>
      </div>

      <div class="room-detail-hero__content">
        <div>
          <div class="room-detail-kicker">{sales.mood}</div>
          <h1>{roomTitle}</h1>
          <p>{roomShort}</p>
        </div>

        <aside class="room-detail-hero__panel">
          <div class="room-detail-kicker">{stayDetailsLabel}</div>

          <div class="room-detail-hero__specs">
            {roomPrice ? (
              <div>
                <span>{fromLabel}</span>
                <strong>€{roomPrice}</strong>
              </div>
            ) : null}

            {roomGuests ? (
              <div>
                <span>{guestsLabel}</span>
                <strong>{roomGuests}</strong>
              </div>
            ) : null}

            {roomSize ? (
              <div>
                <span>{sizeLabel}</span>
                <strong>{formatSize(roomSize)}</strong>
              </div>
            ) : null}
          </div>

          <p>{sales.whyChoose}</p>

          <div class="room-detail-hero__actions">
            {bookingUrl ? (
              <a href={bookingUrl} target="_blank" rel="noreferrer">
                {bookDirectLabel}
              </a>
            ) : null}

            <a href={`/${lang}/contact/`}>
              {contactHotelLabel}
            </a>
          </div>
        </aside>
      </div>

      <div class="room-detail-hero__rail" aria-hidden="true">
        <span>{sales.bestFor}</span>
        <span>{sales.viewSignal}</span>
        {roomBeds ? <span>{bedsLabel}: {roomBeds}</span> : null}
      </div>
    </div>
  </section>

  {roomInspectItems.length ? (
    <section id="room-guide" class="room-guide" data-dock-section data-room-gallery={room.slug}>
      <div class="room-guide__layout">
        <div class="room-guide__copy">
          <div class="room-detail-kicker">{roomGuideLabel}</div>
          <h2>
            {t(
              lang,
              "See the room, then decide quickly.",
              "Vea la habitacion y decida con claridad."
            )}
          </h2>
          <p>
            {roomDescription ||
              t(
                lang,
                "The useful room details sit next to the images, so the page feels like a stay decision instead of a long brochure.",
                "Los detalles utiles de la habitacion quedan junto a las imagenes para decidir sin una pagina larga."
              )}
          </p>

          <dl class="room-guide__facts">
            {roomPrice ? (
              <div>
                <dt>{fromLabel}</dt>
                <dd>EUR {roomPrice}</dd>
              </div>
            ) : null}

            {roomGuests ? (
              <div>
                <dt>{guestsLabel}</dt>
                <dd>{roomGuests}</dd>
              </div>
            ) : null}

            {roomSize ? (
              <div>
                <dt>{sizeLabel}</dt>
                <dd>{formatSize(roomSize)}</dd>
              </div>
            ) : null}

            {roomBeds ? (
              <div>
                <dt>{bedsLabel}</dt>
                <dd>{roomBeds}</dd>
              </div>
            ) : null}
          </dl>

          <div class="room-guide__signals" aria-label={usefulDetailsLabel}>
            <span>{sales.mood}</span>
            <span>{sales.viewSignal}</span>
            <span>{sales.bestFor}</span>
          </div>

          {roomAmenities.length ? (
            <div class="room-guide__amenities">
              <div class="room-detail-kicker">{amenitiesLabel}</div>
              <div>
                {roomAmenities.slice(0, 7).map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </div>
          ) : null}

        </div>

        <div
          class="room-guide__gallery"
          aria-label={photoSwitcherLabel}
          data-room-inspect-id={`room-guide-inspect-${room.slug}`}
        >
          <div
            role="button"
            tabindex="0"
            class="room-gallery__stage"
            data-room-gallery-open
            aria-label={openGalleryLabel}
          >
            {roomInspectItems.map((item, index) => (
              <figure
                class:list={["room-gallery__slide", index === 0 && "is-active"]}
                data-room-gallery-slide
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <img src={item.src} alt={item.alt} loading="eager" decoding="async" />
                <figcaption>
                  <span>{String(index + 1).padStart(2, "0")} / {item.section}</span>
                  <strong>{item.title}</strong>
                  <small>{item.signal}</small>
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="room-gallery__bar">
            <div>
              <span data-room-gallery-count>01 / {String(roomInspectItems.length).padStart(2, "0")}</span>
              <strong data-room-gallery-title>{roomInspectItems[0]?.title}</strong>
            </div>

            <div class="room-gallery__nav">
              <button type="button" data-room-gallery-open aria-label={openGalleryLabel}>{openImageLabel}</button>
              <button type="button" data-room-gallery-prev aria-label={previousImageLabel}>Prev</button>
              <button type="button" data-room-gallery-next aria-label={nextImageLabel}>Next</button>
            </div>
          </div>

          <div class="room-gallery__thumbs" role="tablist">
            {roomInspectItems.map((item, index) => (
              <button
                type="button"
                class:list={["room-gallery__thumb", index === 0 && "is-active"]}
                data-room-gallery-thumb
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={`${openImageLabel}: ${item.title}`}
              >
                <img src={item.src} alt="" loading="eager" decoding="async" />
                <span>{String(index + 1).padStart(2, "0")}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <CinematicInspectView
        id={`room-guide-inspect-${room.slug}`}
        items={roomInspectItems}
        returnLabel={t(lang, "Return", "Volver")}
        previousLabel={t(lang, "Previous image", "Imagen anterior")}
        nextLabel={t(lang, "Next image", "Siguiente imagen")}
      />
    </section>
  ) : null}

  <section class="room-decision" data-dock-section>
    <div class="room-decision__intro">
      <div>
        <div class="room-detail-kicker">{t(lang, "Decision layer", "Capa de decisión")}</div>
        <h2>
          {t(
            lang,
            "Choose this room by rhythm, light and how you want to return.",
            "Elija esta habitación por ritmo, luz y forma de volver."
          )}
        </h2>
      </div>

      <p>
        {roomDescription ||
          t(
            lang,
            "This room is framed as part of the stay: a private base, a specific light condition and a direct path to booking.",
            "Esta habitación se presenta como parte de la estancia: una base privada, una condición de luz específica y una ruta directa hacia la reserva."
          )}
      </p>
    </div>

    <div class="room-decision__grid">
      <article class="room-decision__card room-decision__card--dark">
        <span>{moodLabel}</span>
        <h3>{sales.mood}</h3>
        <p>{sales.bestFor}</p>
      </article>

      <article class="room-decision__card">
        <span>{viewSignalLabel}</span>
        <h3>{sales.viewSignal}</h3>
        <p>{sales.whyChoose}</p>
      </article>

      <article class="room-decision__card">
        <span>{whyChooseLabel}</span>
        <h3>{t(lang, "A room with a reason.", "Una habitación con una razón.")}</h3>
        <p>{sales.whyChoose}</p>
      </article>
    </div>
  </section>

  <section class="room-details-band" data-dock-section>
    <div class="room-details-band__block">
      <div class="room-detail-kicker">{amenitiesLabel}</div>

      {roomAmenities.length ? (
        <div class="room-details-band__chips">
          {roomAmenities.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      ) : (
        <p>{t(lang, "Amenities are available on request.", "Los servicios están disponibles bajo petición.")}</p>
      )}
    </div>

    <div class="room-details-band__block">
      <div class="room-detail-kicker">{highlightsLabel}</div>

      {roomHighlights.length ? (
        <div class="room-details-band__signals">
          {roomHighlights.map((item, index) => (
            <span>{String(index + 1).padStart(2, "0")} / {item}</span>
          ))}
        </div>
      ) : (
        <p>{sales.bestFor}</p>
      )}
    </div>
  </section>

  {false && roomInspectItems.length ? (
    <section class="room-inspection" data-dock-section>
      <div class="room-inspection__intro">
        <div>
          <div class="room-detail-kicker">{galleryLabel}</div>
          <h2>
            {t(
              lang,
              "Inspect light, material and room details.",
              "Inspeccione luz, material y detalles de habitación."
            )}
          </h2>
        </div>

        <p>
          {t(
            lang,
            "Open the room images as an inspect layer instead of a standard lightbox.",
            "Abra las imágenes de la habitación como una capa de inspección, no como un lightbox estándar."
          )}
        </p>
      </div>

      <CinematicInspectGallery
        id={`room-${room.slug}`}
        items={roomInspectItems}
        ariaLabel={openGalleryLabel}
        returnLabel={t(lang, "Return", "Volver")}
        previousLabel={t(lang, "Previous image", "Imagen anterior")}
        nextLabel={t(lang, "Next image", "Siguiente imagen")}
      />
    </section>
  ) : null}

  <section class="room-direct" data-dock-section>
    <div>
      <div class="room-detail-kicker">{directLabel}</div>
      <h2>
        {t(
          lang,
          "Ask the hotel if this room fits your stay.",
          "Pregunte al hotel si esta habitación encaja con su estancia."
        )}
      </h2>
    </div>

    <div>
      <p>
        {t(
          lang,
          "Choose by light, silence, size, view or arrival rhythm. The hotel can help confirm the right room before booking.",
          "Elija por luz, silencio, tamaño, vista o ritmo de llegada. El hotel puede confirmar la habitación adecuada antes de reservar."
        )}
      </p>

      <div class="room-direct__actions">
        {bookingUrl ? (
          <a href={bookingUrl} target="_blank" rel="noreferrer">{bookDirectLabel}</a>
        ) : null}
        <a href={`/${lang}/contact/`}>{contactHotelLabel}</a>
      </div>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
      document.querySelectorAll("[data-room-gallery]").forEach((root) => {
        const slides = Array.from(root.querySelectorAll("[data-room-gallery-slide]"));
        const thumbs = Array.from(root.querySelectorAll("[data-room-gallery-thumb]"));
        const prev = root.querySelector("[data-room-gallery-prev]");
        const next = root.querySelector("[data-room-gallery-next]");
        const openButtons = Array.from(root.querySelectorAll("[data-room-gallery-open]"));
        const count = root.querySelector("[data-room-gallery-count]");
        const title = root.querySelector("[data-room-gallery-title]");
        const inspectId = root.querySelector("[data-room-inspect-id]")?.getAttribute("data-room-inspect-id");

        if (!slides.length) return;

        let active = 0;

        const openInspect = () => {
          if (!inspectId) return;

          window.dispatchEvent(
            new CustomEvent("hotel:cinematic-inspect:open", {
              detail: {
                id: inspectId,
                index: active,
              },
            })
          );
        };

        const setActive = (nextIndex) => {
          active = (nextIndex + slides.length) % slides.length;

          slides.forEach((slide, index) => {
            const isActive = index === active;
            slide.classList.toggle("is-active", isActive);
            slide.setAttribute("aria-hidden", isActive ? "false" : "true");
          });

          thumbs.forEach((thumb, index) => {
            const isActive = index === active;
            thumb.classList.toggle("is-active", isActive);
            thumb.setAttribute("aria-selected", isActive ? "true" : "false");
          });

          if (count) {
            count.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
          }

          const activeTitle = slides[active]?.querySelector("figcaption strong")?.textContent;
          if (title && activeTitle) title.textContent = activeTitle;
        };

        prev?.addEventListener("click", () => setActive(active - 1));
        next?.addEventListener("click", () => setActive(active + 1));
        openButtons.forEach((button) => {
          button.addEventListener("click", openInspect);
          button.addEventListener("keydown", (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            event.preventDefault();
            openInspect();
          });
        });

        thumbs.forEach((thumb, index) => {
          thumb.addEventListener("click", () => setActive(index));
        });

        root.addEventListener("keydown", (event) => {
          if (event.key === "ArrowLeft") setActive(active - 1);
          if (event.key === "ArrowRight") setActive(active + 1);
        });
      });
    })();
  </script>

