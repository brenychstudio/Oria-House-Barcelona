---
type Props = {
  /** Unique gallery id per page (e.g. `room-deluxe`, `offer-winter`, ...) */
  id: string;
  class?: string;
};

const { id, class: className = "" } = Astro.props as Props;

/**
 * Usage:
 * <Lightbox id="room-deluxe">
 *   <button data-hc-lb-item data-full="/path/full.jpg" data-alt="...">
 *     <img src="/path/thumb.jpg" />
 *   </button>
 * </Lightbox>
 */
---

<div data-hc-lb-root={id} class={className}>
  <slot />
</div>

<div data-hc-lb-overlay={id} class="hc-lb" hidden>
  <div class="hc-lb__backdrop" data-hc-lb-close={id}></div>

  <div class="hc-lb__panel" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="hc-lb__close" type="button" aria-label="Close" data-hc-lb-close={id}>
      ✕
    </button>

    <button class="hc-lb__nav hc-lb__prev" type="button" aria-label="Previous" data-hc-lb-prev={id}>
      ‹
    </button>

    <figure class="hc-lb__figure">
      <img class="hc-lb__img" alt="" decoding="async" />
      <figcaption class="hc-lb__cap" aria-live="polite"></figcaption>
    </figure>

    <button class="hc-lb__nav hc-lb__next" type="button" aria-label="Next" data-hc-lb-next={id}>
      ›
    </button>
  </div>
</div>

<style>
  .hc-lb {
    position: fixed;
    inset: 0;
    z-index: 9999;
  }

  .hc-lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hc-lb__panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 64px 1fr 64px;
    align-items: center;
    padding: 18px;
  }

  .hc-lb__figure {
    margin: 0;
    display: grid;
    place-items: center;
    gap: 10px;
    min-width: 0;
  }

  .hc-lb__img {
    max-width: min(1100px, 92vw);
    max-height: 84vh;
    width: auto;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 18px 70px rgba(0, 0, 0, 0.45);
    background: rgba(255, 255, 255, 0.02);
  }

  .hc-lb__cap {
    font-size: 12px;
    opacity: 0.75;
    text-align: center;
    max-width: min(1100px, 92vw);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hc-lb__close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.92);
    cursor: pointer;
  }

  .hc-lb__nav {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.92);
    cursor: pointer;
    user-select: none;
  }

  .hc-lb__prev {
    justify-self: start;
  }
  .hc-lb__next {
    justify-self: end;
  }

  @media (max-width: 640px) {
    .hc-lb__panel {
      grid-template-columns: 52px 1fr 52px;
      padding: 12px;
    }
    .hc-lb__img {
      max-width: 94vw;
      max-height: 80vh;
      border-radius: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-lb__backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

<script is:inline data-astro-rerun define:vars={{ id }}>
  (() => {
    const root = document.querySelector(`[data-hc-lb-root="${id}"]`);
    const overlay = document.querySelector(`[data-hc-lb-overlay="${id}"]`);
    if (!root || !overlay) return;

    const imgEl = overlay.querySelector(".hc-lb__img");
    const capEl = overlay.querySelector(".hc-lb__cap");
    const closeEls = overlay.querySelectorAll(`[data-hc-lb-close="${id}"]`);
    const prevBtn = overlay.querySelector(`[data-hc-lb-prev="${id}"]`);
    const nextBtn = overlay.querySelector(`[data-hc-lb-next="${id}"]`);

    const getItems = () => Array.from(root.querySelectorAll("[data-hc-lb-item]"));

    let items = [];
    let index = 0;
    let lastActive = null;

    const lockScroll = () => {
      const html = document.documentElement;
      const sbw = window.innerWidth - html.clientWidth;
      html.dataset.hcLbLocked = "1";
      html.style.overflow = "hidden";
      if (sbw > 0) html.style.paddingRight = sbw + "px";
    };

    const unlockScroll = () => {
      const html = document.documentElement;
      if (html.dataset.hcLbLocked !== "1") return;
      delete html.dataset.hcLbLocked;
      html.style.overflow = "";
      html.style.paddingRight = "";
    };

    const render = () => {
      items = getItems();
      const it = items[index];
      if (!it) return;

      const src = it.getAttribute("data-full") || "";
      const alt = it.getAttribute("data-alt") || "";
      const cap = it.getAttribute("data-cap") || "";

      if (imgEl) {
        imgEl.src = src;
        imgEl.alt = alt;
      }
      if (capEl) capEl.textContent = cap || alt || `${index + 1} / ${items.length}`;

      const disabled = items.length <= 1;
      if (prevBtn) prevBtn.disabled = disabled;
      if (nextBtn) nextBtn.disabled = disabled;
    };

    const open = (i) => {
      items = getItems();
      if (!items.length) return;

      index = Math.max(0, Math.min(i, items.length - 1));
      lastActive = document.activeElement;
      overlay.hidden = false;
      lockScroll();
      render();

      const closeBtn = overlay.querySelector(".hc-lb__close");
      if (closeBtn) closeBtn.focus();

      document.addEventListener("keydown", onKeyDown);
    };

    const close = () => {
      overlay.hidden = true;
      unlockScroll();
      document.removeEventListener("keydown", onKeyDown);
      if (lastActive && typeof lastActive.focus === "function") lastActive.focus();
      lastActive = null;
    };

    const prev = () => {
      items = getItems();
      if (items.length <= 1) return;
      index = (index - 1 + items.length) % items.length;
      render();
    };

    const next = () => {
      items = getItems();
      if (items.length <= 1) return;
      index = (index + 1) % items.length;
      render();
    };

    const onKeyDown = (e) => {
      if (overlay.hidden) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      }
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        prev();
      }
      if (e.key === "ArrowRight") {
        e.preventDefault();
        next();
      }
    };

    root.addEventListener("click", (e) => {
      const target = e.target.closest("[data-hc-lb-item]");
      if (!target) return;
      e.preventDefault();

      const all = getItems();
      const i = all.indexOf(target);
      if (i >= 0) open(i);
    });

    closeEls.forEach((el) =>
      el.addEventListener("click", (e) => {
        e.preventDefault();
        close();
      })
    );

    if (prevBtn)
      prevBtn.addEventListener("click", (e) => {
        e.preventDefault();
        prev();
      });

    if (nextBtn)
      nextBtn.addEventListener("click", (e) => {
        e.preventDefault();
        next();
      });

    // Simple horizontal swipe (mobile)
    let x0 = null;
    overlay.addEventListener(
      "pointerdown",
      (e) => {
        x0 = e.clientX;
      },
      { passive: true }
    );
    overlay.addEventListener(
      "pointerup",
      (e) => {
        if (x0 == null) return;
        const dx = e.clientX - x0;
        x0 = null;
        if (Math.abs(dx) < 40) return;
        if (dx > 0) prev();
        else next();
      },
      { passive: true }
    );
  })();
</script>
