---
import CinematicInspectView from "./CinematicInspectView.astro";

type ArchiveItem = {
  id: string;
  title: string;
  src: string;
  section: string;
  mood: string;
  signal?: string;
  alt?: string;
};

type Props = {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: ArchiveItem[];
  backHref?: string;
  backLabel?: string;
  bookingHref?: string;
  bookingLabel?: string;
  fullViewLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  returnLabel?: string;
  archiveEyebrow?: string;
  archiveTitle?: string;
  archiveIntro?: string;
  roomsHref?: string;
  roomsLabel?: string;
  ctaEyebrow?: string;
  ctaTitle?: string;
  ctaIntro?: string;
};

const {
  id,
  eyebrow,
  title,
  intro,
  items,
  backHref,
  backLabel = "Back",
  bookingHref,
  bookingLabel = "Book direct",
  fullViewLabel = "Open full view",
  previousLabel = "Previous",
  nextLabel = "Next",
  returnLabel = "Return",
  archiveEyebrow = "Archive view",
  archiveTitle = "Scan the hotel by atmosphere.",
  archiveIntro = intro,
  roomsHref,
  roomsLabel = "Explore rooms",
  ctaEyebrow = "Choose by light",
  ctaTitle = "Find the room that matches this atmosphere.",
  ctaIntro = "Use the archive as a visual route into the rooms, then book direct when the light feels right.",
} = Astro.props as Props;

const archiveItems = (items ?? [])
  .filter((item) => item?.src?.trim())
  .map((item, index) => ({
    ...item,
    id: item.id || `archive-${index + 1}`,
    alt: item.alt || item.title,
  }));

const first = archiveItems[0];
const total = archiveItems.length;
const inspectId = `gallery-inspect-${id}`;
const archiveSections = Array.from(
  archiveItems
    .reduce((sections, item, index) => {
      if (!sections.has(item.section)) sections.set(item.section, index);
      return sections;
    }, new Map<string, number>())
    .entries()
).map(([label, index]) => ({ label, index }));
const indexedArchiveItems = archiveItems.map((item, index) => ({ item, index }));
const archiveChapters = archiveSections.map((section) => ({
  ...section,
  items: indexedArchiveItems.filter(({ item }) => item.section === section.label).slice(0, 3),
}));
---

{first ? (
  <>
    <section class="hc-gallery-archive" data-hc-archive={id} data-direction="1" data-dock-section data-header-scene="site-dark">
      <div class="hc-gallery-archive__ambient" aria-hidden="true"></div>

      <div class="hc-gallery-archive__console">
        <div class="hc-gallery-archive__intro">
          <div class="hc-gallery-archive__eyebrow">{eyebrow}</div>
          <h1>{title}</h1>
          <p>{intro}</p>

          <div class="hc-gallery-archive__filters" aria-label="Gallery categories">
            {archiveSections.map((section, index) => (
              <button
                type="button"
                data-archive-jump={section.index}
                data-archive-section-target={section.label}
                class:list={["hc-gallery-archive__filter", index === 0 && "is-active"]}
                aria-current={index === 0 ? "true" : undefined}
              >
                {section.label}
              </button>
            ))}
          </div>

          <div class="hc-gallery-archive__actions">
            {backHref ? (
              <a href={backHref} class="hc-gallery-archive__action hc-gallery-archive__action--ghost">
                {backLabel}
              </a>
            ) : null}

            {bookingHref ? (
              <a
                href={bookingHref}
                target="_blank"
                rel="noreferrer"
                class="hc-gallery-archive__action hc-gallery-archive__action--solid"
              >
                {bookingLabel}
              </a>
            ) : null}
          </div>
        </div>

        <div
          class="hc-gallery-archive__stage"
          data-archive-stage
          tabindex="0"
          role="group"
          aria-label={title}
        >
          <div class="hc-gallery-archive__image-shell">
            <img
              class="hc-gallery-archive__image"
              data-archive-image
              src={first.src}
              alt={first.alt}
              loading="eager"
              decoding="async"
            />

            <div class="hc-gallery-archive__veil" aria-hidden="true"></div>
            <div class="hc-gallery-archive__sweep" aria-hidden="true"></div>

            <div class="hc-gallery-archive__readout">
              <div>
                <span data-archive-section>{first.section}</span>
                <strong data-archive-title>{first.title}</strong>
              </div>

              <div class="hc-gallery-archive__meta">
                <span>{first.mood}</span>
                <span data-archive-signal>{first.signal || "Visual memory"}</span>
                <span data-archive-count>{`01 / ${String(total).padStart(2, "0")}`}</span>
              </div>
            </div>

            <button
              type="button"
              class="hc-gallery-archive__full"
              data-archive-open
              aria-label={fullViewLabel}
            >
              {fullViewLabel}
            </button>

            <div class="hc-gallery-archive__nav" aria-label="Gallery navigation">
              <button type="button" data-archive-prev aria-label={previousLabel}>&lt;</button>
              <button type="button" data-archive-next aria-label={nextLabel}>&gt;</button>
            </div>

            <div class="hc-gallery-archive__dots">
              {archiveItems.map((item, index) => (
                <button
                  type="button"
                  data-archive-dot={index}
                  class:list={["hc-gallery-archive__dot", index === 0 && "is-active"]}
                  aria-label={`Show ${item.title}`}
                  aria-current={index === 0 ? "true" : undefined}
                ></button>
              ))}
            </div>
          </div>

          <div class="hc-gallery-archive__filmstrip" aria-label="Gallery filmstrip">
            {archiveItems.map((item, index) => (
              <button
                type="button"
                data-archive-thumb={index}
                class:list={["hc-gallery-archive__thumb", index === 0 && "is-active"]}
                aria-label={`Show ${item.title}`}
                aria-current={index === 0 ? "true" : undefined}
              >
                <img src={item.src} alt="" loading="lazy" decoding="async" />
                <span>{item.section}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="hc-gallery-archive__grid-section">
        <div class="hc-gallery-archive__grid-copy">
          <div class="hc-gallery-archive__eyebrow">{archiveEyebrow}</div>
          <h2>{archiveTitle}</h2>
          <p>{archiveIntro}</p>
        </div>

        <div class="hc-gallery-archive__index" aria-label="Gallery atmosphere index">
          {archiveChapters.map((chapter, chapterIndex) => (
            <article
              class:list={[
                "hc-gallery-archive__chapter",
                chapterIndex === 0 && "is-large",
                chapterIndex % 2 === 1 && "is-reverse",
              ]}
            >
              <div class="hc-gallery-archive__chapter-copy">
                <span>{String(chapterIndex + 1).padStart(2, "0")}</span>
                <h3>{chapter.label}</h3>
                <p>
                  {chapter.items
                    .map(({ item }) => item.mood)
                    .filter(Boolean)
                    .join(" / ")}
                </p>
              </div>

              <div class="hc-gallery-archive__chapter-frames">
                {chapter.items.map(({ item, index }, frameIndex) => (
                  <button
                    type="button"
                    data-archive-card={index}
                    class:list={[
                      "hc-gallery-archive__card",
                      "hc-gallery-archive__chapter-frame",
                      index === 0 && "is-active",
                      frameIndex === 0 && "is-feature",
                    ]}
                    aria-label={`Open ${item.title}`}
                    aria-current={index === 0 ? "true" : undefined}
                  >
                    <img src={item.src} alt="" loading="lazy" decoding="async" />
                    <span>{item.section}</span>
                    <strong>{item.title}</strong>
                    <em>{item.signal || item.mood}</em>
                  </button>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="hc-gallery-archive__closing">
        <div>
          <div class="hc-gallery-archive__eyebrow">{ctaEyebrow}</div>
          <h2>{ctaTitle}</h2>
        </div>

        <div class="hc-gallery-archive__closing-side">
          <p>{ctaIntro}</p>

          <div class="hc-gallery-archive__actions">
            {roomsHref ? (
              <a href={roomsHref} class="hc-gallery-archive__action hc-gallery-archive__action--solid">
                {roomsLabel}
              </a>
            ) : null}

            {bookingHref ? (
              <a
                href={bookingHref}
                target="_blank"
                rel="noreferrer"
                class="hc-gallery-archive__action hc-gallery-archive__action--ghost"
              >
                {bookingLabel}
              </a>
            ) : null}
          </div>
        </div>
      </div>
    </section>

    <CinematicInspectView
      id={inspectId}
      items={archiveItems}
      returnLabel={returnLabel}
      previousLabel={previousLabel}
      nextLabel={nextLabel}
    />

    <style>
      .hc-gallery-archive {
        position: relative;
        overflow: hidden;
        background: #15120f;
        color: #fffaf2;
        padding: clamp(6.2rem, 10vh, 8.4rem) max(1rem, calc((100vw - 1480px) / 2)) clamp(3rem, 7vw, 5rem);
        isolation: isolate;
      }

      .hc-gallery-archive__ambient {
        pointer-events: none;
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
          linear-gradient(120deg, rgba(255, 250, 242, 0.07), transparent 36%),
          linear-gradient(290deg, rgba(230, 194, 143, 0.18), transparent 48%),
          linear-gradient(180deg, #18140f 0%, #0f0d0b 100%);
      }

      .hc-gallery-archive__console,
      .hc-gallery-archive__grid-section,
      .hc-gallery-archive__closing {
        position: relative;
        z-index: 1;
      }

      .hc-gallery-archive__console {
        display: grid;
        grid-template-columns: minmax(18rem, 0.44fr) minmax(0, 0.56fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: center;
        min-height: min(820px, calc(100svh - 8.5rem));
      }

      .hc-gallery-archive__intro {
        display: grid;
        align-content: center;
        gap: 1.1rem;
      }

      .hc-gallery-archive__eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: rgba(255, 250, 242, 0.46);
      }

      .hc-gallery-archive h1 {
        max-width: 9.8ch;
        font-size: clamp(3.2rem, 6vw, 6.9rem);
        line-height: 0.88;
        letter-spacing: 0;
        text-wrap: balance;
      }

      .hc-gallery-archive__intro p,
      .hc-gallery-archive__grid-copy p,
      .hc-gallery-archive__closing p {
        max-width: 32rem;
        font-size: 0.98rem;
        line-height: 1.72;
        color: rgba(255, 250, 242, 0.66);
      }

      .hc-gallery-archive__filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        max-width: 34rem;
      }

      .hc-gallery-archive__filter {
        min-height: 2.15rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 250, 242, 0.14);
        background: rgba(255, 250, 242, 0.035);
        color: rgba(255, 250, 242, 0.64);
        padding-inline: 0.8rem;
        font: inherit;
        font-size: 0.76rem;
        cursor: pointer;
      }

      .hc-gallery-archive__filter.is-active {
        border-color: rgba(255, 250, 242, 0.34);
        background: rgba(255, 250, 242, 0.12);
        color: #fffaf2;
      }

      .hc-gallery-archive__actions {
        margin-top: 1.6rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .hc-gallery-archive__action {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding-inline: 1.1rem;
        font-size: 0.88rem;
        line-height: 1;
        text-decoration: none;
      }

      .hc-gallery-archive__action--solid {
        background: #fffaf2;
        color: #15120f;
      }

      .hc-gallery-archive__action--ghost {
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.04);
        color: #fffaf2;
      }

      .hc-gallery-archive__stage {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        min-width: 0;
      }

      .hc-gallery-archive__image-shell {
        position: relative;
        min-height: clamp(28rem, 56vw, 46rem);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 42px 120px rgba(0, 0, 0, 0.3);
      }

      .hc-gallery-archive__image {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        filter: brightness(1.12) contrast(1.06) saturate(1.04);
        transform: scale(1.01);
      }

      .hc-gallery-archive__veil {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(120deg, rgba(255, 242, 216, 0.12), transparent 36%),
          linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.14) 45%, rgba(0, 0, 0, 0.76));
        pointer-events: none;
      }

      .hc-gallery-archive__sweep {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(
          105deg,
          transparent 0%,
          rgba(255, 250, 242, 0.18) 42%,
          transparent 58%
        );
        transform: translateX(-120%);
      }

      .hc-gallery-archive.is-switching .hc-gallery-archive__sweep {
        animation: hcArchiveSweep 920ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hc-gallery-archive.is-switching .hc-gallery-archive__image {
        animation: hcArchiveImageIn 920ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hc-gallery-archive.is-switching[data-direction="-1"] .hc-gallery-archive__image {
        animation-name: hcArchiveImageInReverse;
      }

      .hc-gallery-archive__readout {
        position: absolute;
        left: clamp(1.2rem, 3vw, 2.2rem);
        right: clamp(1.2rem, 3vw, 2.2rem);
        bottom: clamp(1.2rem, 3vw, 2.2rem);
        z-index: 4;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.44fr);
        gap: 1.2rem;
        align-items: end;
        border-top: 1px solid rgba(255, 255, 255, 0.24);
        padding-top: 1.1rem;
      }

      .hc-gallery-archive__readout span {
        display: block;
        font-size: 0.66rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: rgba(255, 250, 242, 0.5);
      }

      .hc-gallery-archive__readout strong {
        margin-top: 0.8rem;
        display: block;
        max-width: 11ch;
        font-size: clamp(2.35rem, 4.8vw, 5.6rem);
        line-height: 0.9;
        letter-spacing: 0;
        font-weight: 400;
      }

      .hc-gallery-archive__meta {
        display: grid;
        gap: 0.7rem;
        justify-items: end;
        text-align: right;
      }

      .hc-gallery-archive__full {
        position: absolute;
        left: clamp(1.1rem, 2vw, 1.6rem);
        top: clamp(1.1rem, 2vw, 1.6rem);
        z-index: 5;
        min-height: 2.5rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(0, 0, 0, 0.25);
        color: #fffaf2;
        padding-inline: 1rem;
        font-size: 0.78rem;
        backdrop-filter: blur(16px);
        cursor: pointer;
      }

      .hc-gallery-archive__nav {
        position: absolute;
        right: clamp(1.1rem, 2vw, 1.6rem);
        top: clamp(1.1rem, 2vw, 1.6rem);
        z-index: 5;
        display: flex;
        gap: 0.5rem;
      }

      .hc-gallery-archive__nav button {
        display: grid;
        height: 2.5rem;
        width: 2.5rem;
        place-items: center;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(0, 0, 0, 0.25);
        color: #fffaf2;
        font-size: 1rem;
        line-height: 1;
        backdrop-filter: blur(16px);
        cursor: pointer;
      }

      .hc-gallery-archive__dots {
        position: absolute;
        right: clamp(1.1rem, 2vw, 1.6rem);
        top: 50%;
        z-index: 5;
        display: grid;
        gap: 0.55rem;
        transform: translateY(-50%);
      }

      .hc-gallery-archive__dot {
        height: 0.48rem;
        width: 0.48rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.36);
        background: rgba(255, 255, 255, 0.12);
        cursor: pointer;
      }

      .hc-gallery-archive__dot.is-active {
        height: 1.9rem;
        background: #fffaf2;
      }

      .hc-gallery-archive__filmstrip {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.55rem;
      }

      .hc-gallery-archive__thumb {
        display: grid;
        grid-template-columns: 4.6rem minmax(0, 1fr);
        gap: 0.6rem;
        align-items: center;
        min-height: 4.7rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.045);
        color: rgba(255, 250, 242, 0.58);
        padding: 0.42rem;
        text-align: left;
        cursor: pointer;
      }

      .hc-gallery-archive__thumb img {
        height: 3.8rem;
        width: 4.6rem;
        object-fit: cover;
        filter: brightness(0.95) contrast(1.04);
      }

      .hc-gallery-archive__thumb span {
        font-size: 0.62rem;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .hc-gallery-archive__thumb.is-active {
        border-color: rgba(255, 250, 242, 0.5);
        background: rgba(255, 255, 255, 0.1);
        color: #fffaf2;
      }

      .hc-gallery-archive__thumb.is-active img {
        filter: brightness(1.1) contrast(1.05);
      }

      .hc-gallery-archive__grid-section {
        margin-top: clamp(4rem, 8vw, 7rem);
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(2.2rem, 5vw, 4.5rem);
        align-items: start;
        border-top: 1px solid rgba(255, 250, 242, 0.12);
        padding-top: clamp(2rem, 4vw, 3.8rem);
      }

      .hc-gallery-archive__grid-copy {
        display: grid;
        grid-template-columns: minmax(0, 0.58fr) minmax(18rem, 0.42fr);
        gap: clamp(1.5rem, 5vw, 5rem);
        align-items: end;
      }

      .hc-gallery-archive__grid-copy .hc-gallery-archive__eyebrow {
        grid-column: 1 / -1;
      }

      .hc-gallery-archive__grid-copy h2 {
        grid-column: 1;
        max-width: 16ch;
        font-size: clamp(3.4rem, 6.1vw, 6.8rem);
        line-height: 0.9;
        font-weight: 400;
        letter-spacing: 0;
      }

      .hc-gallery-archive__grid-copy p {
        grid-column: 2;
        align-self: end;
      }

      .hc-gallery-archive__index {
        display: grid;
        gap: clamp(3rem, 7vw, 6.5rem);
      }

      .hc-gallery-archive__chapter {
        display: grid;
        grid-template-columns: minmax(16rem, 0.26fr) minmax(0, 0.74fr);
        gap: clamp(1.4rem, 4vw, 4rem);
        min-height: clamp(28rem, 42vw, 42rem);
        border-top: 1px solid rgba(255, 250, 242, 0.13);
        padding-top: clamp(1.1rem, 2.5vw, 2.3rem);
      }

      .hc-gallery-archive__chapter:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .hc-gallery-archive__chapter.is-reverse {
        grid-template-columns: minmax(0, 0.74fr) minmax(16rem, 0.26fr);
      }

      .hc-gallery-archive__chapter-copy {
        display: grid;
        align-content: start;
        gap: 0.85rem;
        padding-top: clamp(0.5rem, 1vw, 1rem);
      }

      .hc-gallery-archive__chapter.is-reverse .hc-gallery-archive__chapter-copy {
        order: 2;
        padding-left: clamp(0rem, 2vw, 1.5rem);
      }

      .hc-gallery-archive__chapter.is-reverse .hc-gallery-archive__chapter-frames {
        order: 1;
      }

      .hc-gallery-archive__chapter-copy span,
      .hc-gallery-archive__chapter-frame span {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255, 250, 242, 0.46);
      }

      .hc-gallery-archive__chapter-copy h3 {
        max-width: 13ch;
        font-size: clamp(2.7rem, 3.8vw, 4.6rem);
        line-height: 0.9;
        font-weight: 400;
        letter-spacing: 0;
        overflow-wrap: normal;
        word-break: normal;
      }

      .hc-gallery-archive__chapter-copy p {
        max-width: 20rem;
        color: rgba(255, 250, 242, 0.58);
        font-size: 0.96rem;
        line-height: 1.62;
      }

      .hc-gallery-archive__chapter-frames {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-auto-rows: minmax(11rem, 1fr);
        gap: clamp(0.75rem, 1.4vw, 1.1rem);
        min-width: 0;
      }

      .hc-gallery-archive__card {
        position: relative;
        min-height: clamp(18rem, 26vw, 30rem);
        overflow: hidden;
        border: 1px solid rgba(255, 250, 242, 0.12);
        background: rgba(255, 250, 242, 0.04);
        color: #fffaf2;
        padding: 0;
        text-align: left;
        cursor: zoom-in;
      }

      .hc-gallery-archive__chapter-frame {
        grid-column: span 5;
      }

      .hc-gallery-archive__chapter-frame.is-feature {
        grid-column: span 7;
        grid-row: span 2;
        min-height: clamp(30rem, 44vw, 44rem);
      }

      .hc-gallery-archive__chapter-frame:only-child {
        grid-column: 1 / -1;
        min-height: clamp(30rem, 45vw, 46rem);
      }

      .hc-gallery-archive__chapter-frame.is-feature:nth-last-child(2) {
        grid-column: span 8;
        grid-row: span 1;
        min-height: clamp(27rem, 38vw, 38rem);
      }

      .hc-gallery-archive__chapter-frame.is-feature:nth-last-child(2) + .hc-gallery-archive__chapter-frame {
        grid-column: span 4;
        min-height: clamp(27rem, 38vw, 38rem);
      }

      .hc-gallery-archive__card img {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        filter: brightness(1.02) contrast(1.035) saturate(1.03);
        transform: scale(1.01);
        transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1), filter 700ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hc-gallery-archive__card::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, rgba(0, 0, 0, 0.02), transparent 44%, rgba(0, 0, 0, 0.62)),
          linear-gradient(90deg, rgba(0, 0, 0, 0.18), transparent 48%);
      }

      .hc-gallery-archive__card span,
      .hc-gallery-archive__card strong,
      .hc-gallery-archive__card em {
