---
import CinematicInspectView from "./CinematicInspectView.astro";

type ArchiveItem = {
  id: string;
  title: string;
  src: string;
  section: string;
  mood: string;
  signal?: string;
  alt?: string;
};

type Props = {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: ArchiveItem[];
  backHref?: string;
  backLabel?: string;
  bookingHref?: string;
  bookingLabel?: string;
  fullViewLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  returnLabel?: string;
};

const {
  id,
  eyebrow,
  title,
  intro,
  items,
  backHref,
  backLabel = "Back",
  bookingHref,
  bookingLabel = "Book direct",
  fullViewLabel = "Open full view",
  previousLabel = "Previous",
  nextLabel = "Next",
  returnLabel = "Return",
} = Astro.props as Props;

const archiveItems = (items ?? [])
  .filter((item) => item?.src?.trim())
  .map((item, index) => ({
    ...item,
    id: item.id || `archive-${index + 1}`,
    alt: item.alt || item.title,
  }));

const first = archiveItems[0];
const total = archiveItems.length;
const inspectId = `gallery-inspect-${id}`;
---

{first ? (
  <>
    <section class="hc-gallery-archive" data-hc-archive={id} data-direction="1" data-dock-section>
      <div class="hc-gallery-archive__ambient" aria-hidden="true"></div>

      <div class="hc-gallery-archive__intro">
        <div>
          <div class="hc-gallery-archive__eyebrow">{eyebrow}</div>
          <h1>{title}</h1>
        </div>

        <div class="hc-gallery-archive__intro-side">
          <p>{intro}</p>

          <div class="hc-gallery-archive__actions">
            {backHref ? (
              <a href={backHref} class="hc-gallery-archive__action hc-gallery-archive__action--ghost">
                {backLabel}
              </a>
            ) : null}

            {bookingHref ? (
              <a
                href={bookingHref}
                target="_blank"
                rel="noreferrer"
                class="hc-gallery-archive__action hc-gallery-archive__action--solid"
              >
                {bookingLabel}
              </a>
            ) : null}
          </div>
        </div>
      </div>

      <div
        class="hc-gallery-archive__stage"
        data-archive-stage
        tabindex="0"
        role="group"
        aria-label={title}
      >
        <div class="hc-gallery-archive__image-shell">
          <img
            class="hc-gallery-archive__image"
            data-archive-image
            src={first.src}
            alt={first.alt}
            loading="eager"
            decoding="async"
          />

          <div class="hc-gallery-archive__veil" aria-hidden="true"></div>
          <div class="hc-gallery-archive__sweep" aria-hidden="true"></div>

          <div class="hc-gallery-archive__readout">
            <div>
              <span data-archive-section>{first.section}</span>
              <strong data-archive-title>{first.title}</strong>
            </div>

            <div class="hc-gallery-archive__meta">
              <span>{first.mood}</span>
              <span data-archive-signal>{first.signal || "Visual memory"}</span>
              <span data-archive-count>{`01 / ${String(total).padStart(2, "0")}`}</span>
            </div>
          </div>

          <button
            type="button"
            class="hc-gallery-archive__full"
            data-archive-open
            aria-label={fullViewLabel}
          >
            {fullViewLabel}
          </button>

          <div class="hc-gallery-archive__nav" aria-label="Gallery navigation">
            <button type="button" data-archive-prev aria-label={previousLabel}>&lt;</button>
            <button type="button" data-archive-next aria-label={nextLabel}>&gt;</button>
          </div>

          <div class="hc-gallery-archive__dots">
            {archiveItems.map((item, index) => (
              <button
                type="button"
                data-archive-dot={index}
                class:list={["hc-gallery-archive__dot", index === 0 && "is-active"]}
                aria-label={`Show ${item.title}`}
                aria-current={index === 0 ? "true" : undefined}
              ></button>
            ))}
          </div>
        </div>

        <div class="hc-gallery-archive__filmstrip" aria-label="Gallery filmstrip">
          {archiveItems.map((item, index) => (
            <button
              type="button"
              data-archive-thumb={index}
              class:list={["hc-gallery-archive__thumb", index === 0 && "is-active"]}
              aria-label={`Show ${item.title}`}
              aria-current={index === 0 ? "true" : undefined}
            >
              <img src={item.src} alt="" loading="lazy" decoding="async" />
              <span>{item.section}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <CinematicInspectView
      id={inspectId}
      items={archiveItems}
      returnLabel={returnLabel}
      previousLabel={previousLabel}
      nextLabel={nextLabel}
    />

    <style>
      .hc-gallery-archive {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        background: #15120f;
        color: #fffaf2;
        padding: clamp(7.5rem, 12vh, 11rem) max(1rem, calc((100vw - 1480px) / 2)) clamp(3rem, 7vw, 6rem);
        isolation: isolate;
      }

      .hc-gallery-archive__ambient {
        pointer-events: none;
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
          linear-gradient(120deg, rgba(255, 250, 242, 0.07), transparent 36%),
          linear-gradient(290deg, rgba(230, 194, 143, 0.18), transparent 48%),
          linear-gradient(180deg, #18140f 0%, #0f0d0b 100%);
      }

      .hc-gallery-archive__intro,
      .hc-gallery-archive__stage {
        position: relative;
        z-index: 1;
      }

      .hc-gallery-archive__intro {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.56fr);
        gap: clamp(2rem, 5vw, 5rem);
        align-items: end;
      }

      .hc-gallery-archive__eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: rgba(255, 250, 242, 0.46);
      }

      .hc-gallery-archive h1 {
        margin-top: 1.2rem;
        max-width: 10ch;
        font-size: 4rem;
        line-height: 0.9;
        letter-spacing: 0;
        text-wrap: balance;
      }

      .hc-gallery-archive__intro-side p {
        max-width: 34rem;
        font-size: 1rem;
        line-height: 1.78;
        color: rgba(255, 250, 242, 0.64);
      }

      .hc-gallery-archive__actions {
        margin-top: 1.6rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .hc-gallery-archive__action {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding-inline: 1.1rem;
        font-size: 0.88rem;
        line-height: 1;
        text-decoration: none;
      }

      .hc-gallery-archive__action--solid {
        background: #fffaf2;
        color: #15120f;
      }

      .hc-gallery-archive__action--ghost {
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.04);
        color: #fffaf2;
      }

      .hc-gallery-archive__stage {
        margin-top: clamp(2rem, 5vw, 4rem);
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
      }

      .hc-gallery-archive__image-shell {
        position: relative;
        min-height: clamp(34rem, 60vw, 58rem);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 42px 120px rgba(0, 0, 0, 0.3);
      }

      .hc-gallery-archive__image {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        filter: brightness(1.12) contrast(1.06) saturate(1.04);
        transform: scale(1.01);
      }

      .hc-gallery-archive__veil {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(120deg, rgba(255, 242, 216, 0.12), transparent 36%),
          linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.14) 45%, rgba(0, 0, 0, 0.76));
        pointer-events: none;
      }

      .hc-gallery-archive__sweep {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(
          105deg,
          transparent 0%,
          rgba(255, 250, 242, 0.18) 42%,
          transparent 58%
        );
        transform: translateX(-120%);
      }

      .hc-gallery-archive.is-switching .hc-gallery-archive__sweep {
        animation: hcArchiveSweep 920ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hc-gallery-archive.is-switching .hc-gallery-archive__image {
        animation: hcArchiveImageIn 920ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hc-gallery-archive.is-switching[data-direction="-1"] .hc-gallery-archive__image {
        animation-name: hcArchiveImageInReverse;
      }

      .hc-gallery-archive__readout {
        position: absolute;
        left: clamp(1.2rem, 3vw, 2.2rem);
        right: clamp(1.2rem, 3vw, 2.2rem);
        bottom: clamp(1.2rem, 3vw, 2.2rem);
        z-index: 4;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.44fr);
        gap: 1.2rem;
        align-items: end;
        border-top: 1px solid rgba(255, 255, 255, 0.24);
        padding-top: 1.1rem;
      }

      .hc-gallery-archive__readout span {
        display: block;
        font-size: 0.66rem;
        letter-spacing: 0;
        text-transform: uppercase;
        color: rgba(255, 250, 242, 0.5);
      }

      .hc-gallery-archive__readout strong {
        margin-top: 0.8rem;
        display: block;
        max-width: 11ch;
        font-size: 3rem;
        line-height: 0.9;
        letter-spacing: 0;
        font-weight: 400;
      }

      .hc-gallery-archive__meta {
        display: grid;
        gap: 0.7rem;
        justify-items: end;
        text-align: right;
      }

      .hc-gallery-archive__full {
        position: absolute;
        left: clamp(1.1rem, 2vw, 1.6rem);
        top: clamp(1.1rem, 2vw, 1.6rem);
        z-index: 5;
        min-height: 2.5rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(0, 0, 0, 0.25);
        color: #fffaf2;
        padding-inline: 1rem;
        font-size: 0.78rem;
        backdrop-filter: blur(16px);
        cursor: pointer;
      }

      .hc-gallery-archive__nav {
        position: absolute;
        right: clamp(1.1rem, 2vw, 1.6rem);
        top: clamp(1.1rem, 2vw, 1.6rem);
        z-index: 5;
        display: flex;
        gap: 0.5rem;
      }

      .hc-gallery-archive__nav button {
        display: grid;
        height: 2.5rem;
        width: 2.5rem;
        place-items: center;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(0, 0, 0, 0.25);
        color: #fffaf2;
        font-size: 1rem;
        line-height: 1;
        backdrop-filter: blur(16px);
        cursor: pointer;
      }

      .hc-gallery-archive__dots {
        position: absolute;
        right: clamp(1.1rem, 2vw, 1.6rem);
        top: 50%;
        z-index: 5;
        display: grid;
        gap: 0.55rem;
        transform: translateY(-50%);
      }

      .hc-gallery-archive__dot {
        height: 0.48rem;
        width: 0.48rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.36);
        background: rgba(255, 255, 255, 0.12);
        cursor: pointer;
      }

      .hc-gallery-archive__dot.is-active {
        height: 1.9rem;
        background: #fffaf2;
      }

      .hc-gallery-archive__filmstrip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
        gap: 0.75rem;
      }

      .hc-gallery-archive__thumb {
        display: grid;
        grid-template-columns: 5.7rem minmax(0, 1fr);
        gap: 0.75rem;
        align-items: center;
        min-height: 5.8rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.045);
        color: rgba(255, 250, 242, 0.58);
        padding: 0.55rem;
        text-align: left;
        cursor: pointer;
      }

      .hc-gallery-archive__thumb img {
        height: 4.8rem;
        width: 5.7rem;
        object-fit: cover;
        filter: brightness(0.95) contrast(1.04);
      }

      .hc-gallery-archive__thumb span {
        font-size: 0.62rem;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .hc-gallery-archive__thumb.is-active {
        border-color: rgba(255, 250, 242, 0.5);
        background: rgba(255, 255, 255, 0.1);
        color: #fffaf2;
      }

      .hc-gallery-archive__thumb.is-active img {
        filter: brightness(1.1) contrast(1.05);
      }

      .hc-gallery-archive__lb-proxy {
        position: absolute;
        height: 1px;
        width: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      @keyframes hcArchiveImageIn {
        from {
          opacity: 0.28;
          transform: translate3d(34px, 0, 0) scale(1.045);
          filter: blur(14px) brightness(1.08) contrast(1.04) saturate(1.02);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0) scale(1.01);
          filter: blur(0) brightness(1.12) contrast(1.06) saturate(1.04);
        }
      }

      @keyframes hcArchiveImageInReverse {
        from {
          opacity: 0.28;
          transform: translate3d(-34px, 0, 0) scale(1.045);
          filter: blur(14px) brightness(1.08) contrast(1.04) saturate(1.02);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0) scale(1.01);
          filter: blur(0) brightness(1.12) contrast(1.06) saturate(1.04);
        }
      }

      @keyframes hcArchiveSweep {
        0% {
          opacity: 0;
          transform: translateX(-120%);
        }
        32% {
          opacity: 0.55;
        }
        100% {
          opacity: 0;
          transform: translateX(120%);
        }
      }

      @media (min-width: 641px) {
        .hc-gallery-archive h1 {
          font-size: 5.6rem;
        }

        .hc-gallery-archive__readout strong {
          font-size: 4.6rem;
        }
      }

      @media (min-width: 981px) {
        .hc-gallery-archive h1 {
          font-size: 7.4rem;
        }

        .hc-gallery-archive__readout strong {
          font-size: 5.8rem;
        }
      }

      @media (min-width: 1280px) {
        .hc-gallery-archive h1 {
          font-size: 9rem;
        }

        .hc-gallery-archive__readout strong {
          font-size: 6.8rem;
        }
      }

      @media (max-width: 980px) {
        .hc-gallery-archive {
          padding-top: 7.25rem;
        }

        .hc-gallery-archive__intro,
        .hc-gallery-archive__readout {
          grid-template-columns: 1fr;
        }

        .hc-gallery-archive__meta {
          justify-items: start;
          text-align: left;
        }

        .hc-gallery-archive__dots {
          display: none;
        }

        .hc-gallery-archive__filmstrip {
          display: flex;
          overflow-x: auto;
          padding-bottom: 0.25rem;
          scroll-snap-type: x mandatory;
        }

        .hc-gallery-archive__thumb {
          min-width: 17rem;
          scroll-snap-align: start;
        }
      }

      @media (max-width: 640px) {
        .hc-gallery-archive h1 {
          font-size: 3.8rem;
        }

        .hc-gallery-archive__image-shell {
          min-height: 34rem;
        }

        .hc-gallery-archive__readout strong {
          font-size: 3rem;
        }

        .hc-gallery-archive__nav {
          top: auto;
          bottom: 1.1rem;
        }

        .hc-gallery-archive__full {
          max-width: calc(100% - 2.2rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hc-gallery-archive *,
        .hc-gallery-archive *::before,
        .hc-gallery-archive *::after {
          animation-duration: 1ms !important;
          transition-duration: 1ms !important;
        }
      }
    </style>

    <script is:inline define:vars={{ archiveId: id, archivePayload: archiveItems, inspectId }}>
      (() => {
        const root = document.querySelector(`[data-hc-archive="${archiveId}"]`);
        if (!root || !Array.isArray(archivePayload) || archivePayload.length === 0) return;

        const stage = root.querySelector("[data-archive-stage]");
        const img = root.querySelector("[data-archive-image]");
        const title = root.querySelector("[data-archive-title]");
        const section = root.querySelector("[data-archive-section]");
        const signal = root.querySelector("[data-archive-signal]");
        const count = root.querySelector("[data-archive-count]");
        const openBtn = root.querySelector("[data-archive-open]");
        const prevBtn = root.querySelector("[data-archive-prev]");
        const nextBtn = root.querySelector("[data-archive-next]");
        const thumbs = Array.from(root.querySelectorAll("[data-archive-thumb]"));
        const dots = Array.from(root.querySelectorAll("[data-archive-dot]"));
        const openInspect = () => {
          window.dispatchEvent(
            new CustomEvent("hotel:cinematic-inspect:open", {
              detail: {
                id: inspectId,
                index: activeIndex,
              },
            })
          );
        };

        let activeIndex = 0;
        let wheelCooldown = 0;
        let switchTimer = 0;

        const pad = (n) => String(n).padStart(2, "0");

        const render = (nextIndex, direction = 1) => {
          const total = archivePayload.length;
          const index = ((nextIndex % total) + total) % total;
          const item = archivePayload[index];

          activeIndex = index;
          root.dataset.direction = direction >= 0 ? "1" : "-1";

          if (img) {
            img.src = item.src;
            img.alt = item.alt || item.title || "";
          }

          if (title) title.textContent = item.title || "";
          if (section) section.textContent = item.section || "";
          if (signal) signal.textContent = item.signal || "Visual memory";
          if (count) count.textContent = `${pad(index + 1)} / ${pad(total)}`;

          thumbs.forEach((button, i) => {
            const active = i === index;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "true");
            else button.removeAttribute("aria-current");
          });

          dots.forEach((button, i) => {
            const active = i === index;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "true");
            else button.removeAttribute("aria-current");
          });

          root.classList.remove("is-switching");
          window.clearTimeout(switchTimer);
          void root.offsetWidth;
          root.classList.add("is-switching");
          switchTimer = window.setTimeout(() => root.classList.remove("is-switching"), 960);
        };

        const goTo = (index) => {
          if (index === activeIndex) return;
          const direction = index > activeIndex ? 1 : -1;
          render(index, direction);
        };

        const goDelta = (delta) => {
          render(activeIndex + delta, delta);
        };

        thumbs.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-archive-thumb"));
            if (Number.isFinite(index)) goTo(index);
          });
        });

        dots.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-archive-dot"));
            if (Number.isFinite(index)) goTo(index);
          });
        });

        if (prevBtn) prevBtn.addEventListener("click", () => goDelta(-1));
        if (nextBtn) nextBtn.addEventListener("click", () => goDelta(1));

        if (openBtn) {
          openBtn.addEventListener("click", openInspect);
        }

        if (stage) {
          stage.addEventListener(
            "wheel",
            (event) => {
              if (window.matchMedia("(max-width: 760px)").matches) return;
              if (Math.abs(event.deltaY) < 16) return;

              event.preventDefault();

              const now = window.performance.now();
              if (now - wheelCooldown < 780) return;
              wheelCooldown = now;

              goDelta(event.deltaY > 0 ? 1 : -1);
            },
            { passive: false }
          );

          stage.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight" || event.key === "ArrowDown") {
              event.preventDefault();
              goDelta(1);
            }

            if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
              event.preventDefault();
              goDelta(-1);
            }

            if (event.key === "Enter") {
              event.preventDefault();
              openInspect();
            }
          });
        }
      })();
    </script>
  </>
) : (
  <section class="hc-gallery-archive">
    <div class="hc-gallery-archive__intro">
      <div>
        <div class="hc-gallery-archive__eyebrow">{eyebrow}</div>
        <h1>{title}</h1>
      </div>
      <p>{intro}</p>
    </div>
  </section>
)}
