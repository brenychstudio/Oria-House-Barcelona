      .hc-gallery-archive__closing {
        margin-top: clamp(3.5rem, 7vw, 6rem);
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 0.46fr);
        gap: clamp(1.5rem, 5vw, 5rem);
        align-items: end;
        border-top: 1px solid rgba(255, 250, 242, 0.12);
        padding-block: clamp(1.6rem, 3.6vw, 3rem) 0;
      }

      .hc-gallery-archive__closing h2 {
        max-width: 12ch;
        font-size: clamp(2.6rem, 5.8vw, 6.4rem);
        line-height: 0.9;
        font-weight: 400;
        letter-spacing: 0;
        text-wrap: balance;
      }

      .hc-gallery-archive__closing-side {
        display: grid;
        gap: 1.1rem;
        justify-items: start;
      }

      @keyframes hcArchiveImageIn {
        from {
          opacity: 0.28;
          transform: translate3d(34px, 0, 0) scale(1.045);
          filter: blur(14px) brightness(1.08) contrast(1.04) saturate(1.02);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0) scale(1.01);
          filter: blur(0) brightness(1.12) contrast(1.06) saturate(1.04);
        }
      }

      @keyframes hcArchiveImageInReverse {
        from {
          opacity: 0.28;
          transform: translate3d(-34px, 0, 0) scale(1.045);
          filter: blur(14px) brightness(1.08) contrast(1.04) saturate(1.02);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0) scale(1.01);
          filter: blur(0) brightness(1.12) contrast(1.06) saturate(1.04);
        }
      }

      @keyframes hcArchiveSweep {
        0% {
          opacity: 0;
          transform: translateX(-120%);
        }
        32% {
          opacity: 0.55;
        }
        100% {
          opacity: 0;
          transform: translateX(120%);
        }
      }

      @media (max-width: 980px) {
        .hc-gallery-archive {
          padding-top: 7.25rem;
        }

        .hc-gallery-archive__console,
        .hc-gallery-archive__grid-section,
        .hc-gallery-archive__closing,
        .hc-gallery-archive__readout {
          grid-template-columns: 1fr;
        }

        .hc-gallery-archive__console {
          min-height: 0;
        }

        .hc-gallery-archive__meta {
          justify-items: start;
          text-align: left;
        }

        .hc-gallery-archive__dots {
          display: none;
        }

        .hc-gallery-archive__filmstrip {
          display: flex;
          overflow-x: auto;
          padding-bottom: 0.25rem;
          scroll-snap-type: x mandatory;
        }

        .hc-gallery-archive__thumb {
          min-width: 17rem;
          scroll-snap-align: start;
        }

        .hc-gallery-archive__grid-copy {
          position: static;
          grid-template-columns: 1fr;
        }

        .hc-gallery-archive__grid-copy .hc-gallery-archive__eyebrow,
        .hc-gallery-archive__grid-copy h2,
        .hc-gallery-archive__grid-copy p {
          grid-column: 1;
        }

        .hc-gallery-archive__chapter,
        .hc-gallery-archive__chapter.is-reverse {
          grid-template-columns: 1fr;
          gap: 1.1rem;
          min-height: 0;
        }

        .hc-gallery-archive__chapter-copy,
        .hc-gallery-archive__chapter.is-reverse .hc-gallery-archive__chapter-copy {
          order: 0;
          padding-right: 0;
          padding-left: 0;
        }

        .hc-gallery-archive__chapter-frames {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          grid-auto-rows: auto;
        }

        .hc-gallery-archive__chapter-frame,
        .hc-gallery-archive__chapter.is-large .hc-gallery-archive__chapter-frame.is-feature,
        .hc-gallery-archive__chapter-frame.is-feature:nth-last-child(2),
        .hc-gallery-archive__chapter-frame.is-feature:nth-last-child(3),
        .hc-gallery-archive__chapter-frame.is-feature:nth-last-child(2) + .hc-gallery-archive__chapter-frame,
        .hc-gallery-archive__chapter-frame:only-child {
          grid-column: span 1;
          grid-row: span 1;
        }

        .hc-gallery-archive__card {
          min-height: 18rem;
        }
      }

      @media (max-width: 640px) {
        .hc-gallery-archive {
          padding-top: 5.2rem;
        }

        .hc-gallery-archive__intro {
          gap: 0.78rem;
        }

        .hc-gallery-archive h1 {
          font-size: clamp(2.65rem, 11vw, 3.55rem);
          line-height: 0.92;
        }

        .hc-gallery-archive__intro p,
        .hc-gallery-archive__grid-copy p,
        .hc-gallery-archive__closing p {
          font-size: 0.9rem;
          line-height: 1.56;
        }

        .hc-gallery-archive__actions {
          margin-top: 0.45rem;
          gap: 0.55rem;
        }

        .hc-gallery-archive__action {
          min-height: 2.38rem;
          padding-inline: 0.92rem;
          font-size: 0.8rem;
        }

        .hc-gallery-archive__filter {
          min-height: 2rem;
          padding-inline: 0.68rem;
        }

        .hc-gallery-archive__image-shell {
          min-height: 25rem;
        }

        .hc-gallery-archive__readout strong {
          font-size: 2.8rem;
        }

        .hc-gallery-archive__nav {
          top: auto;
          bottom: 1.1rem;
        }

        .hc-gallery-archive__full {
          max-width: calc(100% - 2.2rem);
        }

        .hc-gallery-archive__chapter-frames {
          grid-template-columns: 1fr;
        }

        .hc-gallery-archive__chapter-copy h3 {
          font-size: clamp(2.4rem, 12vw, 4rem);
        }

        .hc-gallery-archive__card {
          min-height: 22rem;
        }

        .hc-gallery-archive__card strong {
          font-size: clamp(2rem, 10vw, 3.5rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hc-gallery-archive *,
        .hc-gallery-archive *::before,
        .hc-gallery-archive *::after {
          animation-duration: 1ms !important;
          transition-duration: 1ms !important;
        }
      }
    </style>

    <script is:inline define:vars={{ archiveId: id, archivePayload: archiveItems, inspectId }}>
      (() => {
        const root = document.querySelector(`[data-hc-archive="${archiveId}"]`);
        if (!root || !Array.isArray(archivePayload) || archivePayload.length === 0) return;

        const stage = root.querySelector("[data-archive-stage]");
        const img = root.querySelector("[data-archive-image]");
        const title = root.querySelector("[data-archive-title]");
        const section = root.querySelector("[data-archive-section]");
        const signal = root.querySelector("[data-archive-signal]");
        const count = root.querySelector("[data-archive-count]");
        const openBtn = root.querySelector("[data-archive-open]");
        const prevBtn = root.querySelector("[data-archive-prev]");
        const nextBtn = root.querySelector("[data-archive-next]");
        const thumbs = Array.from(root.querySelectorAll("[data-archive-thumb]"));
        const dots = Array.from(root.querySelectorAll("[data-archive-dot]"));
        const filters = Array.from(root.querySelectorAll("[data-archive-jump]"));
        const cards = Array.from(root.querySelectorAll("[data-archive-card]"));
        const openInspect = () => {
          window.dispatchEvent(
            new CustomEvent("hotel:cinematic-inspect:open", {
              detail: {
                id: inspectId,
                index: activeIndex,
              },
            })
          );
        };

        let activeIndex = 0;
        let wheelCooldown = 0;
        let switchTimer = 0;

        const pad = (n) => String(n).padStart(2, "0");

        const render = (nextIndex, direction = 1) => {
          const total = archivePayload.length;
          const index = ((nextIndex % total) + total) % total;
          const item = archivePayload[index];

          activeIndex = index;
          root.dataset.direction = direction >= 0 ? "1" : "-1";

          if (img) {
            img.src = item.src;
            img.alt = item.alt || item.title || "";
          }

          if (title) title.textContent = item.title || "";
          if (section) section.textContent = item.section || "";
          if (signal) signal.textContent = item.signal || "Visual memory";
          if (count) count.textContent = `${pad(index + 1)} / ${pad(total)}`;

          thumbs.forEach((button, i) => {
            const active = i === index;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "true");
            else button.removeAttribute("aria-current");
          });

          dots.forEach((button, i) => {
            const active = i === index;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "true");
            else button.removeAttribute("aria-current");
          });

          filters.forEach((button) => {
            const active = button.getAttribute("data-archive-section-target") === item.section;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "true");
            else button.removeAttribute("aria-current");
          });

          cards.forEach((button, i) => {
            const active = i === index;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "true");
            else button.removeAttribute("aria-current");
          });

          root.classList.remove("is-switching");
          window.clearTimeout(switchTimer);
          void root.offsetWidth;
          root.classList.add("is-switching");
          switchTimer = window.setTimeout(() => root.classList.remove("is-switching"), 960);
        };

        const goTo = (index) => {
          if (index === activeIndex) return;
          const direction = index > activeIndex ? 1 : -1;
          render(index, direction);
        };

        const goDelta = (delta) => {
          render(activeIndex + delta, delta);
        };

        thumbs.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-archive-thumb"));
            if (Number.isFinite(index)) goTo(index);
          });
        });

        dots.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-archive-dot"));
            if (Number.isFinite(index)) goTo(index);
          });
        });

        filters.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-archive-jump"));
            if (Number.isFinite(index)) goTo(index);
          });
        });

        cards.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-archive-card"));
            if (!Number.isFinite(index)) return;

            render(index, index > activeIndex ? 1 : -1);
            window.setTimeout(openInspect, 40);
          });
        });

        if (prevBtn) prevBtn.addEventListener("click", () => goDelta(-1));
        if (nextBtn) nextBtn.addEventListener("click", () => goDelta(1));

        if (openBtn) {
          openBtn.addEventListener("click", openInspect);
        }

        if (stage) {
          stage.addEventListener(
            "wheel",
            (event) => {
              if (window.matchMedia("(max-width: 760px)").matches) return;
              if (Math.abs(event.deltaY) < 16) return;

              event.preventDefault();

              const now = window.performance.now();
              if (now - wheelCooldown < 780) return;
              wheelCooldown = now;

              goDelta(event.deltaY > 0 ? 1 : -1);
            },
            { passive: false }
          );

          stage.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight" || event.key === "ArrowDown") {
              event.preventDefault();
              goDelta(1);
            }

            if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
              event.preventDefault();
              goDelta(-1);
            }

            if (event.key === "Enter") {
              event.preventDefault();
              openInspect();
            }
          });
        }
      })();
    </script>
  </>
) : (
  <section class="hc-gallery-archive" data-header-scene="site-dark">
    <div class="hc-gallery-archive__intro">
      <div>
        <div class="hc-gallery-archive__eyebrow">{eyebrow}</div>
        <h1>{title}</h1>
      </div>
      <p>{intro}</p>
    </div>
  </section>
)}
