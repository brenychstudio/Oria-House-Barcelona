<script is:inline data-astro-rerun>
  (() => {
    const media = window.matchMedia("(max-width: 760px)");

    let lastY = window.scrollY || 0;
    let ticking = false;
    let revealTimer = 0;

    const root = document.documentElement;

    const hasOpenMobileMenu = () => {
      return Boolean(
        document.querySelector(
          '.hotel-header__mobile[open], .hotel-header details[open], [data-hotel-header] details[open], .hotel-header [aria-expanded="true"], [data-hotel-header] [aria-expanded="true"], [data-mobile-menu][data-open="true"], [data-hotel-mobile-menu][data-open="true"], .is-menu-open'
        )
      );
    };

    const setHidden = (hidden) => {
      root.setAttribute("data-mobile-header-hidden", hidden ? "true" : "false");
    };

    const scheduleAutoHide = () => {
      window.clearTimeout(revealTimer);

      revealTimer = window.setTimeout(() => {
        if (!media.matches || hasOpenMobileMenu()) return;
        if ((window.scrollY || 0) > 180) setHidden(true);
      }, 1100);
    };

    const update = () => {
      ticking = false;

      if (!media.matches) {
        window.clearTimeout(revealTimer);
        root.removeAttribute("data-mobile-header-hidden");
        return;
      }

      const currentY = window.scrollY || 0;
      const delta = currentY - lastY;
      const atTop = currentY < 80;
      const pastIntro = currentY > Math.min(window.innerHeight * 0.42, 360);

      if (hasOpenMobileMenu()) {
        window.clearTimeout(revealTimer);
        setHidden(false);
        lastY = currentY;
        return;
      }

      if (atTop) {
        window.clearTimeout(revealTimer);
        setHidden(false);
        lastY = currentY;
        return;
      }

      if (delta > 3 && pastIntro) {
        window.clearTimeout(revealTimer);
        setHidden(true);
      } else if (delta < -8) {
        setHidden(false);
        scheduleAutoHide();
      } else if (pastIntro && !root.hasAttribute("data-mobile-header-hidden")) {
        setHidden(true);
      }

      lastY = currentY;
    };

    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request);
    window.addEventListener("load", request);
    window.addEventListener("pageshow", request);

    document.addEventListener("toggle", request, true);

    request();
  })();
</script>
