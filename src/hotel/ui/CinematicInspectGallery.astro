---
import CinematicInspectView from "./CinematicInspectView.astro";

type InspectItem = {
  id: string;
  title: string;
  src: string;
  section: string;
  mood: string;
  signal?: string;
  alt?: string;
};

type Props = {
  id: string;
  items: InspectItem[];
  ariaLabel?: string;
  returnLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
};

const {
  id,
  items,
  ariaLabel = "Image inspection gallery",
  returnLabel = "Return",
  previousLabel = "Previous",
  nextLabel = "Next",
} = Astro.props as Props;

const inspectItems = (items ?? [])
  .filter((item) => item?.src?.trim())
  .map((item, index) => ({
    ...item,
    id: item.id || `${id}-${index + 1}`,
    alt: item.alt || item.title || "",
    signal: item.signal || item.mood || "Visual detail",
  }));

const inspectId = `detail-inspect-${id}`;
---

{inspectItems.length ? (
  <>
    <div class="hc-inspect-gallery" data-inspect-gallery={id} aria-label={ariaLabel}>
      <div class="hc-inspect-gallery__grid">
        {inspectItems.map((item, index) => (
          <button
            type="button"
            class="hc-inspect-gallery__item"
            data-inspect-open-index={index}
            aria-label={`${ariaLabel}: ${item.title}`}
          >
            <img src={item.src} alt="" loading="lazy" decoding="async" />

            <span class="hc-inspect-gallery__veil" aria-hidden="true"></span>

            <span class="hc-inspect-gallery__readout">
              <small>{String(index + 1).padStart(2, "0")}</small>
              <em>{item.section}</em>
              <strong>{item.title}</strong>
            </span>
          </button>
        ))}
      </div>
    </div>

    <CinematicInspectView
      id={inspectId}
      items={inspectItems}
      returnLabel={returnLabel}
      previousLabel={previousLabel}
      nextLabel={nextLabel}
    />

    <style>
      .hc-inspect-gallery {
        width: 100%;
      }

      .hc-inspect-gallery__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .hc-inspect-gallery__item {
        position: relative;
        display: block;
        min-height: 18rem;
        overflow: hidden;
        border: 0;
        background: #15120f;
        color: #fffaf2;
        padding: 0;
        text-align: left;
        cursor: pointer;
        box-shadow: 0 28px 90px rgba(64, 42, 24, 0.08);
      }

      .hc-inspect-gallery__item:first-child {
        grid-column: span 2;
        min-height: clamp(26rem, 46vw, 44rem);
      }

      .hc-inspect-gallery__item img {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        filter: brightness(1.06) contrast(1.045) saturate(1.02);
        transform: scale(1.015);
        transition:
          transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
          filter 900ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hc-inspect-gallery__item:hover img {
        transform: scale(1.045);
        filter: brightness(1.12) contrast(1.055) saturate(1.04);
      }

      .hc-inspect-gallery__veil {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 72% 20%, rgba(255, 245, 220, 0.16), transparent 28rem),
          linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.14) 48%, rgba(0, 0, 0, 0.74));
        pointer-events: none;
      }

      .hc-inspect-gallery__readout {
        position: absolute;
        left: clamp(1rem, 2.5vw, 1.7rem);
        right: clamp(1rem, 2.5vw, 1.7rem);
        bottom: clamp(1rem, 2.5vw, 1.7rem);
        z-index: 2;
        border-top: 1px solid rgba(255, 250, 242, 0.22);
        padding-top: 0.85rem;
      }

      .hc-inspect-gallery__readout small,
      .hc-inspect-gallery__readout em {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: rgba(255, 250, 242, 0.48);
        font-style: normal;
      }

      .hc-inspect-gallery__readout em {
        margin-top: 0.8rem;
      }

      .hc-inspect-gallery__readout strong {
        margin-top: 0.55rem;
        display: block;
        max-width: 10ch;
        font-size: clamp(2.4rem, 4.8vw, 5rem);
        line-height: 0.88;
        letter-spacing: -0.075em;
        font-weight: 400;
        text-shadow: 0 18px 70px rgba(0, 0, 0, 0.34);
      }

      .hc-inspect-gallery__item:focus-visible {
        outline: 2px solid rgba(21, 18, 15, 0.72);
        outline-offset: 4px;
      }

      @media (max-width: 760px) {
        .hc-inspect-gallery__grid {
          grid-template-columns: 1fr;
        }

        .hc-inspect-gallery__item,
        .hc-inspect-gallery__item:first-child {
          grid-column: auto;
          min-height: 24rem;
        }
      }

      @media (max-width: 480px) {
        .hc-inspect-gallery__item,
        .hc-inspect-gallery__item:first-child {
          min-height: 20rem;
        }

        .hc-inspect-gallery__readout strong {
          font-size: clamp(2.2rem, 10vw, 4.2rem);
        }
      }
    </style>

    <script is:inline define:vars={{ galleryId: id, inspectId }}>
      (() => {
        const root = document.querySelector(`[data-inspect-gallery="${galleryId}"]`);
        if (!root) return;

        const buttons = Array.from(root.querySelectorAll("[data-inspect-open-index]"));

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.getAttribute("data-inspect-open-index"));

            window.dispatchEvent(
              new CustomEvent("hotel:cinematic-inspect:open", {
                detail: {
                  id: inspectId,
                  index: Number.isFinite(index) ? index : 0,
                },
              })
            );
          });
        });
      })();
    </script>
  </>
) : null}
