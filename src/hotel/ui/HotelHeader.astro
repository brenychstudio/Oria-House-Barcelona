---
import { LANGS, t, type Lang } from "../../content/languages";
import { getSettings } from "../../cms/sheets";

type Props = {
  lang: Lang;
  pathname: string;
};

const { lang, pathname } = Astro.props as Props;

const s = await getSettings();

const siteName = t(lang, s.hotel_name_en, s.hotel_name_es);
const bookingUrl = String((s as any).booking_url || "").trim();

const cleanPath = pathname.endsWith("/") ? pathname : `${pathname}/`;

function switchLangPath(targetLang: Lang) {
  const parts = cleanPath.split("/").filter(Boolean);

  if (parts.length === 0) return `/${targetLang}/`;

  if (LANGS.includes(parts[0] as Lang)) {
    parts[0] = targetLang;
    return `/${parts.join("/")}/`;
  }

  return `/${targetLang}/${parts.join("/")}/`;
}

function isActive(href: string) {
  if (href === `/${lang}/`) return cleanPath === href;
  return cleanPath.startsWith(href);
}

const navItems = [
  {
    href: `/${lang}/rooms/`,
    label: t(lang, "Rooms", "Habitaciones"),
    key: "rooms",
  },
  {
    href: `/${lang}/offers/`,
    label: t(lang, "Offers", "Ofertas"),
    key: "offers",
  },
  {
    href: `/${lang}/experiences/`,
    label: t(lang, "Experiences", "Experiencias"),
    key: "experiences",
  },
  {
    href: `/${lang}/gallery/`,
    label: t(lang, "Gallery", "Galería"),
    key: "gallery",
  },
  {
    href: `/${lang}/location/`,
    label: t(lang, "Location", "Ubicación"),
    key: "location",
  },
  {
    href: `/${lang}/contact/`,
    label: t(lang, "Contact", "Contacto"),
    key: "contact",
  },
];

const bookLabel = t(lang, "Book direct", "Reservar directo");
const menuLabel = t(lang, "Menu", "Menú");
const closeLabel = t(lang, "Close", "Cerrar");
const homeLabel = t(lang, "Home", "Inicio");
const brandSubline = t(lang, "Boutique hotel", "Hotel boutique");
---

<header class="hotel-header sticky top-0 z-50 px-3 pt-3 sm:px-4" data-hotel-header>
  <div class="hotel-header__inner mx-auto">
    <a
      href={`/${lang}/`}
      class="hotel-header__brand group flex min-w-0 items-center gap-3 rounded-full border border-black/10 bg-[#fbf7f0]/76 py-3 pl-3 pr-5 shadow-[0_18px_60px_rgba(64,42,24,0.10)] backdrop-blur-2xl supports-[backdrop-filter]:bg-[#fbf7f0]/62"
      aria-label={homeLabel}
      data-header-part="brand"
    >
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#171410] text-[11px] uppercase text-white shadow-[0_10px_26px_rgba(23,20,16,0.18)]" data-header-logo>
        HC
      </span>

      <span class="hidden min-w-0 sm:block">
        <span class="block truncate text-sm">{siteName}</span>
        <span class="mt-1.5 block text-[10px] uppercase opacity-45">
          {brandSubline}
        </span>
      </span>
    </a>

    <nav
      class="hotel-header__nav hidden items-center rounded-full border border-black/10 bg-[#fbf7f0]/68 p-1 shadow-[0_18px_60px_rgba(64,42,24,0.08)] backdrop-blur-2xl lg:flex supports-[backdrop-filter]:bg-[#fbf7f0]/52"
      aria-label="Primary navigation"
      data-header-part="nav"
    >
      {navItems.map((item) => {
        const active = isActive(item.href);

        return (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3.5 py-2 text-xs transition",
              active
                ? "bg-[#171410] text-white shadow-[0_10px_26px_rgba(23,20,16,0.14)]"
                : "opacity-62 hover:bg-white hover:opacity-100",
            ]}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div
      class="hotel-header__actions hidden items-center gap-2 rounded-full border border-black/10 bg-[#fbf7f0]/76 p-1.5 shadow-[0_18px_60px_rgba(64,42,24,0.10)] backdrop-blur-2xl lg:flex supports-[backdrop-filter]:bg-[#fbf7f0]/62"
      data-header-part="actions"
    >
      <div class="flex rounded-full border border-black/10 bg-white/44 p-1" data-header-lang-list>
        {LANGS.map((l) => {
          const active = l === lang;

          return (
            <a
              href={switchLangPath(l)}
              class:list={[
                "rounded-full px-3 py-2 text-[11px] uppercase",
                active ? "bg-[#171410] text-white" : "opacity-55 hover:bg-white hover:opacity-100",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {l}
            </a>
          );
        })}
      </div>

      {bookingUrl ? (
        <a
          href={bookingUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-10 items-center justify-center rounded-full bg-[#171410] px-5 text-sm text-white shadow-[0_14px_34px_rgba(23,20,16,0.20)] hover:-translate-y-0.5"
          data-header-cta
        >
          {bookLabel}
        </a>
      ) : (
        <a
          href={`/${lang}/contact/`}
          class="inline-flex min-h-10 items-center justify-center rounded-full bg-[#171410] px-5 text-sm text-white shadow-[0_14px_34px_rgba(23,20,16,0.20)] hover:-translate-y-0.5"
          data-header-cta
        >
          {bookLabel}
        </a>
      )}
    </div>

    <details class="hotel-header__mobile group relative lg:hidden">
      <summary class="list-none">
        <span class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-full border border-black/10 bg-[#fbf7f0]/78 px-4 text-sm shadow-[0_18px_60px_rgba(64,42,24,0.10)] backdrop-blur-2xl" data-header-mobile-summary>
          <span class="group-open:hidden">{menuLabel}</span>
          <span class="hidden group-open:inline">{closeLabel}</span>
        </span>
      </summary>

      <div
        class="hotel-header__panel absolute right-0 top-14 w-[min(86vw,360px)] overflow-hidden rounded-[1.5rem] border border-black/10 bg-[#fbf7f0] p-3 shadow-[0_28px_80px_rgba(64,42,24,0.18)]"
        data-hotel-mobile-menu
      >
        <div class="border-b border-black/10 px-2 pb-3">
          <div class="text-xs uppercase opacity-45">{siteName}</div>
          <div class="mt-2 text-sm opacity-65">
            {t(lang, "Direct booking navigation", "Navegación de reserva directa")}
          </div>
        </div>

        <nav class="mt-3 grid gap-1" aria-label="Mobile navigation">
          {navItems.map((item) => {
            const active = isActive(item.href);

            return (
              <a
                href={item.href}
                class:list={[
                  "rounded-2xl px-4 py-3 text-sm",
                  active ? "bg-[#171410] text-white" : "hover:bg-white/75",
                ]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="mt-3 flex items-center justify-between gap-3 border-t border-black/10 pt-3">
          <div class="flex rounded-full border border-black/10 bg-white/50 p-1" data-header-lang-list>
            {LANGS.map((l) => {
              const active = l === lang;

              return (
                <a
                  href={switchLangPath(l)}
                  data-header-lang-link
                  data-active-lang={active ? "true" : undefined}
                  class:list={[
                    "rounded-full px-3 py-2 text-[11px] uppercase",
                    active ? "bg-[#171410] text-white" : "opacity-55",
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {l}
                </a>
              );
            })}
          </div>

          {bookingUrl ? (
            <a
              href={bookingUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex min-h-10 flex-1 items-center justify-center rounded-full bg-[#171410] px-4 text-sm text-white"
              data-header-cta
            >
              {bookLabel}
            </a>
          ) : (
            <a
              href={`/${lang}/contact/`}
              class="inline-flex min-h-10 flex-1 items-center justify-center rounded-full bg-[#171410] px-4 text-sm text-white"
              data-header-cta
            >
              {bookLabel}
            </a>
          )}
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .hotel-header {
    --header-split: 0;
    --header-bg: rgba(251, 247, 240, 0.72);
    --header-text: #171410;
    --header-muted: rgba(23, 20, 16, 0.62);
    --header-border: rgba(23, 20, 16, 0.1);
    --header-chip: rgba(255, 255, 255, 0.46);
    --header-chip-active-bg: #171410;
    --header-chip-active-text: #fffaf2;
    --header-cta-bg: #171410;
    --header-cta-text: #fffaf2;
    --header-cta-border: rgba(23, 20, 16, 0.92);
    --header-shadow: rgba(64, 42, 24, 0.1);
    --header-blur: 24px;
  }

  .hotel-header__inner {
    display: grid;
    grid-template-columns: minmax(13rem, 1fr) auto minmax(13rem, 1fr);
    width: min(100% - 1rem, 1680px);
    align-items: start;
    gap: 1rem;
  }

  .hotel-header__brand,
  .hotel-header__actions,
  .hotel-header__nav,
  .hotel-header__mobile {
    will-change: transform, opacity;
    transition:
      box-shadow 260ms ease,
      border-color 260ms ease,
      background-color 620ms cubic-bezier(0.19, 1, 0.22, 1),
      color 520ms cubic-bezier(0.19, 1, 0.22, 1),
      backdrop-filter 620ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .hotel-header__brand,
  .hotel-header__actions,
  .hotel-header__nav,
  .hotel-header__mobile summary > span {
    border-color: var(--header-border) !important;
    background-color: var(--header-bg) !important;
    color: var(--header-text) !important;
    box-shadow: 0 18px 60px var(--header-shadow);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
  }

  .hotel-header [data-header-logo],
  .hotel-header__nav a[aria-current="page"],
  .hotel-header [data-header-lang-list] a[aria-current="page"],
  .hotel-header [data-header-cta] {
    border-color: var(--header-cta-border) !important;
    background: var(--header-cta-bg) !important;
    color: var(--header-cta-text) !important;
  }

  .hotel-header__nav a:not([aria-current="page"]),
  .hotel-header [data-header-lang-list] a:not([aria-current="page"]) {
    color: var(--header-muted) !important;
    opacity: 1 !important;
  }

  .hotel-header [data-header-lang-list] {
    border-color: var(--header-border) !important;
    background-color: var(--header-chip) !important;
    transition:
      background-color 620ms cubic-bezier(0.19, 1, 0.22, 1),
      border-color 620ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .hotel-header__mobile > div {
    border-color: var(--header-border) !important;
    background: #fbf7f0 !important;
    color: var(--header-text) !important;
    transition:
      background-color 620ms cubic-bezier(0.19, 1, 0.22, 1),
      border-color 620ms cubic-bezier(0.19, 1, 0.22, 1),
      color 520ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .hotel-header__mobile[open] {
    z-index: 80;
  }

  .hotel-header__mobile summary {
    position: relative;
    z-index: 4;
  }

  .hotel-header__panel {
    z-index: 3;
    isolation: isolate;
    width: min(calc(100vw - 2rem), 360px);
    max-height: calc(100svh - 6.75rem - env(safe-area-inset-bottom));
    overflow: auto;
    overscroll-behavior: contain;
    transform-origin: top right;
    will-change: opacity, transform, filter;
  }

  .hotel-header__mobile nav a:not([aria-current="page"]) {
    color: var(--header-text);
  }

  .hotel-header__mobile nav a[aria-current="page"],
  .hotel-header__mobile [data-header-lang-list] a[aria-current="page"],
  .hotel-header__mobile [data-header-cta] {
    background: #171410 !important;
    color: #fffaf2 !important;
  }

  .hotel-header__mobile [data-header-lang-list] {
    display: grid;
    grid-template-columns: repeat(2, minmax(2.45rem, 1fr));
    min-width: 5.4rem;
    overflow: hidden;
  }

  .hotel-header__mobile [data-header-lang-list] a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding-inline: 0.55rem;
    color: rgba(23, 20, 16, 0.58) !important;
  }

  .hotel-header__mobile [data-header-lang-list] a[aria-current="page"],
  .hotel-header__mobile [data-header-lang-list] a[data-active-lang="true"] {
    background: #171410 !important;
    color: #fffaf2 !important;
  }

  .hotel-header__brand {
    justify-self: start;
    transform:
      translate3d(0, calc(var(--header-split) * -0.18rem), 0)
      scale(calc(1 - (var(--header-split) * 0.018)));
  }

  .hotel-header__nav {
    justify-self: center;
    transform:
      translate3d(0, calc(var(--header-split) * -0.28rem), 0)
      scale(calc(1 - (var(--header-split) * 0.012)));
  }

  .hotel-header__actions {
    justify-self: end;
    transform:
      translate3d(0, calc(var(--header-split) * -0.18rem), 0)
      scale(calc(1 - (var(--header-split) * 0.018)));
  }

  .hotel-header[data-scrolled="true"] .hotel-header__brand,
  .hotel-header[data-scrolled="true"] .hotel-header__actions,
  .hotel-header[data-scrolled="true"] .hotel-header__nav {
    border-color: rgba(21, 18, 15, 0.08);
  }

  @media (min-width: 1500px) {
    .hotel-header__brand {
      transform:
        translate3d(0, calc(var(--header-split) * -0.18rem), 0)
        scale(calc(1 - (var(--header-split) * 0.018)));
    }

    .hotel-header__actions {
      transform:
        translate3d(0, calc(var(--header-split) * -0.18rem), 0)
        scale(calc(1 - (var(--header-split) * 0.018)));
    }
  }

  @media (max-width: 1023px) {
    .hotel-header {
      z-index: 1000;
    }

    .hotel-header__inner {
      display: flex;
      justify-content: space-between;
      width: min(100% - 0.25rem, 1680px);
    }

    .hotel-header__brand,
    .hotel-header__mobile {
      transform: none;
    }

    .hotel-header__mobile[open] {
      will-change: auto;
    }

    .hotel-header__panel {
      top: calc(100% + 0.75rem);
      right: 0;
      left: auto;
    }

    .hotel-header__mobile[open] .hotel-header__panel {
      animation: hotelMobilePanelIn 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hotel-header__mobile[data-closing="true"] .hotel-header__panel {
      pointer-events: none;
      animation: hotelMobilePanelOut 320ms cubic-bezier(0.55, 0, 0.2, 1) both;
    }
  }

  @keyframes hotelMobilePanelIn {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translate3d(0, -0.8rem, 0) scale(0.975);
    }

    56% {
      opacity: 1;
      filter: blur(0);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes hotelMobilePanelOut {
    from {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
    }

    to {
      opacity: 0;
      filter: blur(8px);
      transform: translate3d(0, -0.65rem, 0) scale(0.982);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hotel-header__brand,
    .hotel-header__actions,
    .hotel-header__nav,
    .hotel-header__mobile {
      transform: none !important;
      transition-duration: 1ms !important;
    }

    .hotel-header__mobile[open] .hotel-header__panel,
    .hotel-header__mobile[data-closing="true"] .hotel-header__panel {
      animation-duration: 1ms !important;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const header = document.querySelector("[data-hotel-header]");
    if (!header) return;

    const mobileMenu = header.querySelector(".hotel-header__mobile");
    const mobileSummary = mobileMenu?.querySelector("summary");

    if (mobileMenu && mobileSummary) {
      let closeTimer = 0;

      const closeMobileMenu = () => {
        if (!mobileMenu.open || mobileMenu.dataset.closing === "true") return;

        mobileMenu.dataset.closing = "true";
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => {
          mobileMenu.open = false;
          delete mobileMenu.dataset.closing;
        }, 320);
      };

      mobileSummary.addEventListener("click", (event) => {
        if (!mobileMenu.open) {
          window.clearTimeout(closeTimer);
          delete mobileMenu.dataset.closing;
          return;
        }

        event.preventDefault();
        closeMobileMenu();
      });

      mobileMenu.addEventListener("toggle", () => {
        if (mobileMenu.open) {
          window.clearTimeout(closeTimer);
          delete mobileMenu.dataset.closing;
        }
      });
    }

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    let ticking = false;
    let activeScene = "";

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
    const ease = (value) => value * value * (3 - 2 * value);

    const themes = {
      default: {
        bg: "rgba(251, 247, 240, 0.72)",
        text: "#171410",
        muted: "rgba(23, 20, 16, 0.62)",
        border: "rgba(23, 20, 16, 0.1)",
        chip: "rgba(255, 255, 255, 0.46)",
        ctaBg: "#171410",
        ctaText: "#fffaf2",
        ctaBorder: "rgba(23, 20, 16, 0.92)",
        shadow: "rgba(64, 42, 24, 0.1)",
        blur: "24px",
        washA: "rgba(255, 255, 255, 0.48)",
        washB: "rgba(226, 197, 158, 0.12)",
        washC: "rgba(64, 42, 24, 0.05)",
        washOpacity: "1",
      },
      "site-light": {
        bg: "rgba(251, 247, 240, 0.72)",
        text: "#171410",
        muted: "rgba(23, 20, 16, 0.62)",
        border: "rgba(23, 20, 16, 0.1)",
        chip: "rgba(255, 255, 255, 0.46)",
        ctaBg: "#171410",
        ctaText: "#fffaf2",
        ctaBorder: "rgba(23, 20, 16, 0.92)",
        shadow: "rgba(64, 42, 24, 0.1)",
        blur: "24px",
        washA: "rgba(255, 255, 255, 0.48)",
        washB: "rgba(226, 197, 158, 0.12)",
        washC: "rgba(64, 42, 24, 0.05)",
        washOpacity: "1",
      },
      "site-dark": {
        bg: "rgba(13, 11, 9, 0.58)",
        text: "#fffaf2",
        muted: "rgba(255, 250, 242, 0.66)",
        border: "rgba(255, 250, 242, 0.16)",
        chip: "rgba(255, 250, 242, 0.08)",
        ctaBg: "#fffaf2",
        ctaText: "#15120f",
        ctaBorder: "rgba(255, 250, 242, 0.84)",
        shadow: "rgba(0, 0, 0, 0.2)",
        blur: "30px",
        washA: "rgba(255, 250, 242, 0.06)",
        washB: "rgba(226, 188, 136, 0.14)",
        washC: "rgba(5, 5, 4, 0.2)",
        washOpacity: "0.8",
      },
      "home-hero": {
        bg: "rgba(251, 247, 240, 0.68)",
        text: "#171410",
        muted: "rgba(23, 20, 16, 0.6)",
        border: "rgba(23, 20, 16, 0.1)",
        chip: "rgba(255, 255, 255, 0.44)",
        ctaBg: "#171410",
        ctaText: "#fffaf2",
        ctaBorder: "rgba(23, 20, 16, 0.92)",
        shadow: "rgba(64, 42, 24, 0.11)",
        blur: "24px",
        washA: "rgba(255, 255, 255, 0.46)",
        washB: "rgba(226, 197, 158, 0.16)",
        washC: "rgba(64, 42, 24, 0.06)",
        washOpacity: "1",
      },
      "home-stay": {
        bg: "rgba(251, 247, 240, 0.78)",
        text: "#171410",
        muted: "rgba(23, 20, 16, 0.62)",
        border: "rgba(23, 20, 16, 0.1)",
        chip: "rgba(255, 255, 255, 0.5)",
        ctaBg: "#171410",
        ctaText: "#fffaf2",
        ctaBorder: "rgba(23, 20, 16, 0.92)",
        shadow: "rgba(64, 42, 24, 0.1)",
        blur: "24px",
        washA: "rgba(255, 255, 255, 0.52)",
        washB: "rgba(226, 197, 158, 0.14)",
        washC: "rgba(64, 42, 24, 0.05)",
        washOpacity: "1",
      },
      "home-gallery": {
        bg: "rgba(13, 11, 9, 0.58)",
        text: "#fffaf2",
        muted: "rgba(255, 250, 242, 0.66)",
        border: "rgba(255, 250, 242, 0.16)",
        chip: "rgba(255, 250, 242, 0.08)",
        ctaBg: "#fffaf2",
        ctaText: "#15120f",
        ctaBorder: "rgba(255, 250, 242, 0.84)",
        shadow: "rgba(0, 0, 0, 0.2)",
        blur: "30px",
        washA: "rgba(255, 250, 242, 0.06)",
        washB: "rgba(226, 188, 136, 0.14)",
        washC: "rgba(5, 5, 4, 0.2)",
        washOpacity: "0.8",
      },
      "home-closing": {
        bg: "rgba(246, 239, 228, 0.82)",
        text: "#171410",
        muted: "rgba(23, 20, 16, 0.62)",
        border: "rgba(23, 20, 16, 0.1)",
        chip: "rgba(255, 255, 255, 0.42)",
        ctaBg: "#171410",
        ctaText: "#fffaf2",
        ctaBorder: "rgba(23, 20, 16, 0.92)",
        shadow: "rgba(64, 42, 24, 0.12)",
        blur: "24px",
        washA: "rgba(255, 255, 255, 0.5)",
        washB: "rgba(226, 197, 158, 0.12)",
        washC: "rgba(64, 42, 24, 0.04)",
        washOpacity: "1",
      },
    };

    const applyTheme = (sceneId) => {
      const theme = themes[sceneId] || themes.default;

      header.style.setProperty("--header-bg", theme.bg);
      header.style.setProperty("--header-text", theme.text);
      header.style.setProperty("--header-muted", theme.muted);
      header.style.setProperty("--header-border", theme.border);
      header.style.setProperty("--header-chip", theme.chip);
      header.style.setProperty("--header-cta-bg", theme.ctaBg);
      header.style.setProperty("--header-cta-text", theme.ctaText);
      header.style.setProperty("--header-cta-border", theme.ctaBorder);
      header.style.setProperty("--header-shadow", theme.shadow);
      header.style.setProperty("--header-blur", theme.blur);
      header.setAttribute("data-header-theme", sceneId || "default");

      const root = document.documentElement;
      root.style.setProperty("--hc-atmosphere-a", theme.washA || themes.default.washA || "rgba(255, 255, 255, 0.48)");
      root.style.setProperty("--hc-atmosphere-b", theme.washB || themes.default.washB || "rgba(226, 197, 158, 0.12)");
      root.style.setProperty("--hc-atmosphere-c", theme.washC || themes.default.washC || "rgba(64, 42, 24, 0.05)");
      root.style.setProperty("--hc-atmosphere-opacity", theme.washOpacity || "1");
      root.setAttribute("data-page-scene", sceneId || "default");
    };

    const getActiveScene = () => {
      const scenes = Array.from(document.querySelectorAll("[data-header-scene]"));
      if (!scenes.length) return "";

      const headerRect = header.getBoundingClientRect();
      const target = Math.min(
        window.innerHeight - 1,
        Math.max(24, headerRect.bottom + 10)
      );
      const sampleX = Math.max(1, Math.min(window.innerWidth - 1, window.innerWidth / 2));
      const stack = document.elementsFromPoint(sampleX, target);
      const direct = stack
        .map((node) => node instanceof Element ? node.closest("[data-header-scene]") : null)
        .find(Boolean);

      if (direct) return direct.getAttribute("data-header-scene") || "";

      let best = null;
      let bestScore = -Infinity;

      scenes.forEach((scene) => {
        const rect = scene.getBoundingClientRect();
        const visible = rect.bottom > target && rect.top < target;
        if (!visible) return;

        const distance = Math.abs(rect.top - target);
        const score = 1000 - distance;

        if (score > bestScore) {
          bestScore = score;
          best = scene;
        }
      });

      return best?.getAttribute("data-header-scene") || "";
    };

    const render = () => {
      ticking = false;

      const raw = clamp(window.scrollY / 520, 0, 1);
      const split = ease(raw);
      const nextScene = getActiveScene();

      if (!reduced.matches) {
        header.style.setProperty("--header-split", split.toFixed(4));
      }

      header.setAttribute("data-scrolled", split > 0.04 ? "true" : "false");

      if (nextScene !== activeScene) {
        activeScene = nextScene;
        applyTheme(activeScene);
      }
    };

    const requestRender = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    window.addEventListener("scroll", requestRender, { passive: true });
    window.addEventListener("resize", requestRender);
    window.addEventListener("load", requestRender, { once: true });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", requestRender, { once: true });
    } else {
      requestRender();
    }
  })();
</script>
